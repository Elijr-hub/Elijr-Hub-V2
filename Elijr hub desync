-- Fayk Dumper - Fixed & Optimized
local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local TweenService = game:GetService('TweenService')
local RunService = game:GetService('RunService')
local CoreGui = game:GetService('CoreGui')
local LocalPlayer = Players.LocalPlayer

-- GUI Setup
local screengui = Instance.new("ScreenGui")
screengui.Name = "ElijrGui"
screengui.ResetOnSpawn = false
screengui.IgnoreGuiInset = true
screengui.Parent = CoreGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 160, 0, 175)
frame.Position = UDim2.new(0.5, -80, 0.5, -87)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = screengui

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 12)
frameCorner.Parent = frame

local frameStroke = Instance.new("UIStroke")
frameStroke.Color = Color3.fromRGB(255, 255, 255)
frameStroke.Thickness = 1.5
frameStroke.Transparency = 0.35
frameStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
frameStroke.Parent = frame

local frameGradient = Instance.new("UIGradient")
frameGradient.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
frameGradient.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 1),
    NumberSequenceKeypoint.new(0.45, 0),
    NumberSequenceKeypoint.new(0.55, 0),
    NumberSequenceKeypoint.new(1, 1)
})
frameGradient.Parent = frame

-- Animate the frame gradient rotation
TweenService:Create(frameStroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
    Transparency = 0.1,
    Thickness = 2.2
}):Play()

RunService.Heartbeat:Connect(function(dt)
    frameGradient.Rotation = (frameGradient.Rotation + 160 * dt) % 360
end)

-- Title Label
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 30)
titleLabel.Position = UDim2.new(0, 0, 0, 2)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "Elijr"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.Font = Enum.Font.GothamBlack
titleLabel.TextSize = 18
titleLabel.Parent = frame

-- Helper: create a styled button
local function makeButton(text, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.88, 0, 0, 34)
    btn.Position = UDim2.new(0.06, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 16
    btn.Text = text
    btn.Parent = frame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1.2
    stroke.Transparency = 0.4
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.ZIndex = 2
    stroke.Parent = btn

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    gradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.4, 0),
        NumberSequenceKeypoint.new(0.6, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    gradient.Parent = btn

    TweenService:Create(stroke, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
        Transparency = 0.12,
        Thickness = 2
    }):Play()

    RunService.Heartbeat:Connect(function(dt)
        gradient.Rotation = (gradient.Rotation + 130 * dt) % 360
    end)

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end)

    return btn
end

local btnDesync = makeButton("DESYNC", 38)
local btnUnwalk = makeButton("UNWALK", 82)
local btnReset  = makeButton("RESET",  126)

-- Dragging
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- DESYNC button
-- Note: true network desync requires exploit-level API (e.g. firetouchinterest / simulation stepping).
-- This is a placeholder that shows the error state; replace the inner logic with your intended desync method.
btnDesync.Activated:Connect(function()
    btnDesync.Text = "ERROR"
    btnDesync.BackgroundColor3 = Color3.fromRGB(170, 50, 50)
    task.wait(1)
    btnDesync.Text = "DESYNC"
    btnDesync.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
end)

-- UNWALK button: disables animations to freeze the walk cycle visually
btnUnwalk.Activated:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if animator then
        -- Stop all currently playing animation tracks
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            track:Stop()
        end
        btnUnwalk.Text = "WALKED"
        btnUnwalk.BackgroundColor3 = Color3.fromRGB(50, 120, 50)
    end
end)

-- RESET button: kills and respawns the character cleanly
btnReset.Activated:Connect(function()
    btnReset.Text = "RUNNING..."
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildWhichIsA("Humanoid")
        if humanoid then
            humanoid.Health = 0  -- triggers normal death + respawn
        end
    end
    task.wait(1)
    btnReset.Text = "RESET"
end)

-- Restore button states on respawn
LocalPlayer.CharacterAdded:Connect(function()
    btnUnwalk.Text = "UNWALK"
    btnUnwalk.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btnDesync.Text = "DESYNC"
    btnDesync.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btnDesync.Active = true
end)

print("Elijr loaded!")
