local LocalPlayerInstance = game:GetService('Players').LocalPlayer
local MainScreenGui = Instance.new('ScreenGui')

MainScreenGui.Name = 'Elijr Allower'
MainScreenGui.ResetOnSpawn = false
MainScreenGui.Parent = LocalPlayerInstance:WaitForChild('PlayerGui')

local MainFrame = Instance.new('Frame')
MainFrame.Size = UDim2.new(0, 180, 0, 120)
MainFrame.Position = UDim2.new(0, 40, 0, 60)
MainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Black base
MainFrame.BackgroundTransparency = 0.2
MainFrame.Parent = MainScreenGui

local MainFrameCorner = Instance.new('UICorner')
MainFrameCorner.CornerRadius = UDim.new(0, 12)
MainFrameCorner.Parent = MainFrame

local TitleLabel = Instance.new('TextLabel')
TitleLabel.Size = UDim2.new(1, -20, 0, 24)
TitleLabel.Position = UDim2.new(0, 10, 0, 6)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = 'Elijr Allower'
TitleLabel.TextColor3 = Color3.fromRGB(255, 204, 0) -- Bright yellow
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.TextSize = 16
TitleLabel.TextXAlignment = Enum.TextXAlignment.Center
TitleLabel.Parent = MainFrame

local AllowFriendsButton = Instance.new('TextButton')
AllowFriendsButton.Size = UDim2.new(1, -30, 0, 50)
AllowFriendsButton.Position = UDim2.new(0, 15, 0.5, -25)
AllowFriendsButton.Text = 'Allow Friends'
AllowFriendsButton.TextColor3 = Color3.fromRGB(0, 0, 0) -- Black text
AllowFriendsButton.Font = Enum.Font.GothamBold
AllowFriendsButton.TextSize = 18
AllowFriendsButton.BackgroundColor3 = Color3.fromRGB(255, 204, 0) -- Yellow background
AllowFriendsButton.BackgroundTransparency = 0.1
AllowFriendsButton.Parent = MainFrame

local ButtonCorner = Instance.new('UICorner')
ButtonCorner.CornerRadius = UDim.new(0, 10)
ButtonCorner.Parent = AllowFriendsButton

local InfoLabel = Instance.new('TextLabel')
InfoLabel.Size = UDim2.new(1, -30, 0, 16)
InfoLabel.Position = UDim2.new(0, 15, 0, 90)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = 'Elijr Friends Toggle'
InfoLabel.TextColor3 = Color3.fromRGB(255, 204, 0) -- Yellow text
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.TextSize = 11
InfoLabel.TextXAlignment = Enum.TextXAlignment.Center
InfoLabel.Parent = MainFrame

-- Track toggle state to avoid duplicate fires
local isFriendsAllowed = false
AllowFriendsButton.MouseButton1Click:Connect(function()
    isFriendsAllowed = not isFriendsAllowed
    AllowFriendsButton.Text = isFriendsAllowed and 'Disallow' or 'Allow Friends'
    game:GetService('ReplicatedStorage'):WaitForChild('Packages'):WaitForChild('Net'):WaitForChild('RE/PlotService/ToggleFriends'):FireServer()
end)

-- Removed redundant input connection code (no functional purpose in original)
