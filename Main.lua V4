ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

local StealBtn = Instance.new("TextButton", MainFrame)
StealBtn.Size = UDim2.new(1, -20, 0, 35)
StealBtn.Position = UDim2.new(0, 10, 0, 165)
