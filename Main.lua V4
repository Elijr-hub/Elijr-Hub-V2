-- ────────────────────────────────────────────────────────────────
--                         Handlers
-- ────────────────────────────────────────────────────────────────

ToggleBtn.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    if Enabled then 
        fenv.StartVelocityMove() 
        ToggleBtn.Text = "BOOST → ON" 
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0) 
        ToggleBtn.TextColor3 = Color3.fromRGB(0,0,0)
    else 
        fenv.StopVelocityMove() 
        ToggleBtn.Text = "BOOST → OFF" 
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30) 
        ToggleBtn.TextColor3 = Color3.fromRGB(255,255,255) 
    end
end)

SpinBtn.MouseButton1Click:Connect(function()
    SpinEnabled = not SpinEnabled
    ToggleSpin(SpinEnabled)
    if SpinEnabled then 
        SpinBtn.Text = "SPIN → ACTIVE" 
        SpinBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0) 
        SpinBtn.TextColor3 = Color3.fromRGB(0,0,0)
    else 
        SpinBtn.Text = "SPIN → OFF" 
        SpinBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30) 
        SpinBtn.TextColor3 = Color3.fromRGB(255,255,255) 
    end
end)

SpeedBox.FocusLost:Connect(function() Speed = tonumber(SpeedBox.Text:match("%d+")) or 30 end)
JumpBox.FocusLost:Connect(function() JumpPower = tonumber(JumpBox.Text:match("%d+")) or 75 end)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if SpinEnabled then ToggleSpin(true) end
    if Enabled then fenv.StartVelocityMove() end
end)

