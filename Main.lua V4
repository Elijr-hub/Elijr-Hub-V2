-- ────────────────────────────────────────────────────────────────
--                         Logic Handling
-- ────────────────────────────────────────────────────────────────

ToggleButton.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    if Enabled then
        fenv.StartVelocityMove()
        ToggleButton.Text = "BOOST → ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        ToggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    else
        fenv.StopVelocityMove()
        ToggleButton.Text = "BOOST → OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

SpinButton.MouseButton1Click:Connect(function()
    SpinEnabled = not SpinEnabled
    if SpinEnabled then
        StartSpin()
        SpinButton.Text = "SPIN → ACTIVE"
        SpinButton.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
        SpinButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    else
        SpinButton.Text = "SPIN → OFF"
        SpinButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        SpinButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

SpeedBox.FocusLost:Connect(function() 
    local val = tonumber(SpeedBox.Text:match("%d+"))
    if val then Speed = val end
    SpeedBox.Text = "Speed: "..tostring(Speed)
end)

JumpBox.FocusLost:Connect(function() 
    local val = tonumber(JumpBox.Text:match("%d+"))
    if val then JumpPower = val end
    JumpBox.Text = "Jump: "..tostring(JumpPower)
end)

print("Elijr hub Booster (Spin Edition) loaded!")

