-- Logic
ToggleBtn.MouseButton1Click:Connect(function()
    Enabled = not Enabled
    if Enabled then fenv.StartVelocityMove() ToggleBtn.Text = "BOOST → ON" ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0) ToggleBtn.TextColor3 = Color3.fromRGB(0,0,0)
    else fenv.StopVelocityMove() ToggleBtn.Text = "BOOST → OFF" ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30) ToggleBtn.TextColor3 = Color3.fromRGB(255,255,255) end
end)

StealBtn.MouseButton1Click:Connect(function()
    StealEnabled = not StealEnabled
    if StealEnabled then StealBtn.Text = "STEALING..." StealBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0) StealBtn.TextColor3 = Color3.fromRGB(0,0,0)
    else StealBtn.Text = "SCREEN STEAL → OFF" StealBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30) StealBtn.TextColor3 = Color3.fromRGB(255,255,255) end
end)

SpeedBox.FocusLost:Connect(function() Speed = tonumber(SpeedBox.Text:match("%d+")) or 25 end)
JumpBox.FocusLost:Connect(function() JumpPower = tonumber(JumpBox.Text:match("%d+")) or 50 end)

print("Elijr hub V4 (Screen Stealer) loaded!")

