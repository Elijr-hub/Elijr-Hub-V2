-- Elijr hub Booster – Screen Button Stealer Edition
local fenv = getfenv()
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local VelocityConnection
local Enabled = false
local StealEnabled = false
local Speed = 25
local JumpPower = 50 

-- ────────────────────────────────────────────────────────────────
--                         Movement Logic
-- ────────────────────────────────────────────────────────────────

fenv.StartVelocityMove = function()
    if VelocityConnection then return end
    VelocityConnection = RunService.Heartbeat:Connect(function()
        local Character = LocalPlayer.Character
        if not Character or not Enabled then return end
        local HRP = Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not HRP or not Humanoid then return end
        
        Humanoid.UseJumpPower = true
        Humanoid.JumpPower = JumpPower
        local MoveDir = Humanoid.MoveDirection
        if MoveDir.Magnitude > 0 then
            local FlatDir = Vector3.new(MoveDir.X, 0, MoveDir.Z).Unit
            HRP.Velocity = Vector3.new(FlatDir.X * Speed, HRP.Velocity.Y, FlatDir.Z * Speed)
        end
    end)
end

fenv.StopVelocityMove = function()
    if VelocityConnection then VelocityConnection:Disconnect() VelocityConnection = nil end
end

-- ────────────────────────────────────────────────────────────────
--                     Screen Button Steal Logic
-- ────────────────────────────────────────────────────────────────

task.spawn(function()
    while true do
        task.wait(2) -- The 2 second delay you asked for
        if StealEnabled then
            -- Scans all GUIs for buttons that say "Steal" or common names
            for _, gui in pairs(PlayerGui:GetDescendants()) do
                if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                    -- If the button is visible and active
                    if gui.Visible and gui.Parent.Visible then
                        local text = gui:IsA("TextButton") and gui.Text:lower() or ""
                        -- Checks if the button name or text contains "steal" or "click"
                        if text:find("steal") or gui.Name:lower():find("steal") or text:find("click") then
                            -- Simulates a mouse click
                            gui:Activate() 
                            -- Alternatively firing common click events
                            for _, connection in pairs(getconnections(gui.MouseButton1Click)) do
                                connection:Fire()
                            end
                        end
                    end
                end
            end
        end
    end
end)

