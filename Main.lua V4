-- Elijr hub Booster – Ultimate Edition (Safe Spin, Anti-KB, Anti-Ragdoll)
local fenv = getfenv()
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local VelocityConnection
local Enabled = false
local SpinEnabled = false
local Speed = 30 
local JumpPower = 75 
local SpinSpeed = 50 

-- ────────────────────────────────────────────────────────────────
--                         Core Logic
-- ────────────────────────────────────────────────────────────────

fenv.StartVelocityMove = function()
    if VelocityConnection then return end
    VelocityConnection = RunService.Heartbeat:Connect(function()
        local Character = LocalPlayer.Character
        if not Character or not Enabled then return end

        local HRP = Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not HRP or not Humanoid then return end

        -- Anti-Ragdoll: Keep the character standing
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

        -- Movement Boost
        local MoveDir = Humanoid.MoveDirection
        if MoveDir.Magnitude > 0 then
            local FlatDir = Vector3.new(MoveDir.X, 0, MoveDir.Z).Unit
            HRP.Velocity = Vector3.new(FlatDir.X * Speed, HRP.Velocity.Y, FlatDir.Z * Speed)
        elseif MoveDir.Magnitude == 0 then
            -- Anti-Knockback: Prevent being pushed when standing still
            HRP.Velocity = Vector3.new(0, HRP.Velocity.Y, 0)
        end
        
        -- Apply Jump Power
        Humanoid.UseJumpPower = true
        Humanoid.JumpPower = JumpPower
    end)
end

fenv.StopVelocityMove = function()
    if VelocityConnection then VelocityConnection:Disconnect() VelocityConnection = nil end
    if LocalPlayer.Character then
        local Humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if Humanoid then 
            Humanoid.JumpPower = 50 
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end
    end
end

-- Safe Spin Logic
local function ToggleSpin(state)
    local Character = LocalPlayer.Character
    if not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    local ExistingSpin = HRP:FindFirstChild("ElijrSpin")
    
    if state then
        if not ExistingSpin then
            local SpinValue = Instance.new("AngularVelocity")
            SpinValue.Name = "ElijrSpin"
            SpinValue.MaxTorque = math.huge
            SpinValue.AngularVelocity = Vector3.new(0, SpinSpeed, 0)
            SpinValue.Attachment0 = HRP:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", HRP)
            SpinValue.Parent = HRP
        end
    else
        if ExistingSpin then ExistingSpin:Destroy() end
    end
end

