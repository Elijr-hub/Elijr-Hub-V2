-- Elijr hub Booster – Universal Flight Edition (Mobile Fixed)
local fenv = getfenv()
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local VelocityConnection
local FlyConnection
local Enabled = false
local FlyEnabled = false
local AntiKB = false
local AntiRagdoll = false
local SpinEnabled = false

local Speed = 30 
local JumpPower = 75 
local SpinSpeed = 50 
local FlySpeed = 15 

-- ────────────────────────────────────────────────────────────────
--                         Universal Flight Logic
-- ────────────────────────────────────────────────────────────────

local function ToggleFly(state)
    if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
    local Character = LocalPlayer.Character
    if not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not HRP or not Humanoid then return end

    if state then
        local BV = Instance.new("BodyVelocity", HRP)
        BV.Name = "ElijrFly"
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BV.Velocity = Vector3.new(0, 0, 0)

        local BG = Instance.new("BodyGyro", HRP)
        BG.Name = "ElijrGyro"
        BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        BG.P = 9e4
        BG.CFrame = HRP.CFrame

        Humanoid.PlatformStand = true

        FlyConnection = RunService.RenderStepped:Connect(function()
            BG.CFrame = Camera.CFrame
            local MoveDir = Humanoid.MoveDirection
            
            if MoveDir.Magnitude > 0 then
                -- This uses the camera angle but follows your joystick direction correctly
                BV.Velocity = (Camera.CFrame.Rotation * Vector3.new(MoveDir.X, 0, -MoveDir.Magnitude)).Unit * FlySpeed
                -- Vertical control: If you look up/down, you go up/down
                BV.Velocity = Vector3.new(BV.Velocity.X, Camera.CFrame.LookVector.Y * FlySpeed * (MoveDir.Magnitude), BV.Velocity.Z)
            else
                BV.Velocity = Vector3.new(0, 0.1, 0) -- Stable Hover
            end
        end)
    else
        if HRP:FindFirstChild("ElijrFly") then HRP.ElijrFly:Destroy() end
        if HRP:FindFirstChild("ElijrGyro") then HRP.ElijrGyro:Destroy() end
        Humanoid.PlatformStand = false
    end
end

-- ────────────────────────────────────────────────────────────────
--                         Grounded Logic
-- ────────────────────────────────────────────────────────────────

fenv.StartVelocityMove = function()
    if VelocityConnection then return end
    VelocityConnection = RunService.Heartbeat:Connect(function()
        local Character = LocalPlayer.Character
        if not Character or not Enabled or FlyEnabled then return end
        local HRP = Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not HRP or not Humanoid then return end

        if AntiRagdoll then
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end

        local MoveDir = Humanoid.MoveDirection
        if MoveDir.Magnitude > 0 then
            HRP.Velocity = Vector3.new(MoveDir.Unit.X * Speed, HRP.Velocity.Y, MoveDir.Unit.Z * Speed)
        elseif MoveDir.Magnitude == 0 and AntiKB then
            HRP.Velocity = Vector3.new(0, HRP.Velocity.Y, 0)
        end
        
        Humanoid.UseJumpPower = true
        Humanoid.JumpPower = JumpPower
    end)
end

local function ToggleSpin(state)
    local Character = LocalPlayer.Character
    if not Character then return end
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    local ExistingSpin = HRP:FindFirstChild("ElijrSpin")
    if state then
        if not ExistingSpin then
            local SpinValue = Instance.new("AngularVelocity", HRP)
            SpinValue.Name = "ElijrSpin"
            SpinValue.MaxTorque = math.huge
            SpinValue.AngularVelocity = Vector3.new(0, SpinSpeed, 0)
            SpinValue.Attachment0 = HRP:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", HRP)
        end
    else
        if ExistingSpin then ExistingSpin:Destroy() end
    end
end

-- ────────────────────────────────────────────────────────────────
--                           GUI
-- ────────────────────────────────────────────────────────────────

local ScreenGui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
ScreenGui.Name = "ElijrHubBooster"
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 180, 0, 400)
MainFrame.Position = UDim2.new(1, -200, 0.5, -200)
MainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
MainFrame.Active = true
MainFrame.Draggable = true
Instance.new("UICorner", MainFrame)
local Stroke = Instance.new("UIStroke", MainFrame)
Stroke.Color = Color3.fromRGB(255, 215, 0)
Stroke.Thickness = 2.5

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "Elijr hub Booster"
Title.TextColor3 = Color3.fromRGB(255, 255, 0)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.GothamBlack

local function CreateToggle(text, pos, callback)
    local Btn = Instance.new("TextButton", MainFrame)
    Btn.Size = UDim2.new(1, -20, 0, 32)
    Btn.Position = pos
    Btn.Text = text
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", Btn)
    local state = false
    Btn.MouseButton1Click:Connect(function()
        state = not state
        callback(state, Btn)
        Btn.BackgroundColor3 = state and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(30, 30, 30)
        Btn.TextColor3 = state and Color3.fromRGB(0,0,0) or Color3.fromRGB(255, 255, 255)
    end)
end

local SpeedB = Instance.new("TextBox", MainFrame)
SpeedB.Size = UDim2.new(1, -20, 0, 28)
SpeedB.Position = UDim2.new(0, 10, 0, 40)
SpeedB.Text = "Speed: 30"
SpeedB.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
SpeedB.TextColor3 = Color3.fromRGB(255, 255, 255)
Instance.new("UICorner", SpeedB)

local JumpB = Instance.new("TextBox", MainFrame)
JumpB.Size = UDim2.new(1, -20, 0, 28)
JumpB.Position = UDim2.new(0, 10, 0, 72)
JumpB.Text = "Jump: 75"
JumpB.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
JumpB.TextColor3 = Color3.fromRGB(255, 255, 255)
Instance.new("UICorner", JumpB)

local FlyB = Instance.new("TextBox", MainFrame)
FlyB.Size = UDim2.new(1, -20, 0, 28)
FlyB.Position = UDim2.new(0, 10, 0, 104)
FlyB.Text = "Fly Speed: 15"
FlyB.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
FlyB.TextColor3 = Color3.fromRGB(255, 255, 255)
Instance.new("UICorner", FlyB)

CreateToggle("BOOST", UDim2.new(0, 10, 0, 145), function(s) Enabled = s if s then fenv.StartVelocityMove() end end)
CreateToggle("FLY", UDim2.new(0, 10, 0, 185), function(s) FlyEnabled = s ToggleFly(s) end)
CreateToggle("SPINBOT", UDim2.new(0, 10, 0, 225), function(s) SpinEnabled = s ToggleSpin(s) end)
CreateToggle("ANTI-KB", UDim2.new(0, 10, 0, 265), function(s) AntiKB = s end)
CreateToggle("ANTI-RAGDOLL", UDim2.new(0, 10, 0, 305), function(s) AntiRagdoll = s end)

SpeedB.FocusLost:Connect(function() Speed = tonumber(SpeedB.Text:match("%d+")) or 30 end)
JumpB.FocusLost:Connect(function() JumpPower = tonumber(JumpB.Text:match("%d+")) or 75 end)
FlyB.FocusLost:Connect(function() FlySpeed = tonumber(FlyB.Text:match("%d+")) or 15 end)

LocalPlayer.CharacterAdded:Connect(function() task.wait(0.5) if Enabled then fenv.StartVelocityMove() end end)

print("Elijr hub Mobile-Fixed Fly Edition Loaded!")
