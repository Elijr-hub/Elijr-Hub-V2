OpenBtn.Size = UDim2.new(0, 60, 0, 60)
OpenBtn.Position = UDim2.new(0, 20, 0.5, -30)
OpenBtn.BackgroundColor3 = Color3.new(0,0,0)
OpenBtn.Text = "<b>OPEN</b>"
OpenBtn.TextColor3 = Color3.new(1,1,0)
OpenBtn.RichText = true
OpenBtn.Font = Enum.Font.FredokaOne
OpenBtn.Visible = false
Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1, 0) -- Circle
Instance.new("UIStroke", OpenBtn).Color = Color3.new(1,1,0)

-- MAIN HUB FRAME
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 420, 0, 320)
MainFrame.Position = UDim2.new(0.5, -210, 0.5, -160)
MainFrame.BackgroundColor3 = Color3.new(0,0,0)
MainFrame.Active = true
MainFrame.Draggable = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 15)
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(255, 255, 0)

-- CLOSE BUTTON (X)
local CloseBtn = Instance.new("TextButton", MainFrame)
CloseBtn.Size = UDim2.new(0, 35, 0, 35)
CloseBtn.Position = UDim2.new(1, -40, 0, 5)
CloseBtn.Text = "<b>X</b>"
CloseBtn.TextColor3 = Color3.new(1,1,0)
CloseBtn.BackgroundTransparency = 1
CloseBtn.RichText = true
CloseBtn.Font = Enum.Font.FredokaOne
CloseBtn.TextSize = 25

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    OpenBtn.Visible = true
end)

OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    OpenBtn.Visible = false
end)

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 45)
Title.Position = UDim2.new(0, 0, 0, 5)
Title.Text = "Elijr Hub"
Title.TextColor3 = Color3.fromRGB(255, 255, 0)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.FredokaOne
Title.TextSize = 28

local LeftNav = Instance.new("Frame", MainFrame)
LeftNav.Size = UDim2.new(0, 110, 1, -60)
LeftNav.Position = UDim2.new(0, 10, 0, 50)
LeftNav.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Instance.new("UICorner", LeftNav).CornerRadius = UDim.new(0, 10)
Instance.new("UIStroke", LeftNav).Color = Color3.fromRGB(255, 255, 0)

local ContentArea = Instance.new("Frame", MainFrame)
ContentArea.Size = UDim2.new(1, -140, 1, -60)
ContentArea.Position = UDim2.new(0, 130, 0, 50)
ContentArea.BackgroundTransparency = 1

local Tabs = {}
local function CreateTabFrame(name)
    local F = Instance.new("ScrollingFrame", ContentArea)
    F.Size = UDim2.new(1, 0, 1, 0)
    F.BackgroundTransparency = 1
    F.Visible = false
    F.CanvasSize = UDim2.new(0,0,1.5,0)
    F.ScrollBarThickness = 0
    Tabs[name] = F
    return F
end

local MoveTab = CreateTabFrame("Move")
local SpinTab = CreateTabFrame("Spin")
local ViewTab = CreateTabFrame("View")
local MiscTab = CreateTabFrame("Misc")

local function ShowTab(name)
    for n, f in pairs(Tabs) do f.Visible = (n == name) end
end

local function CreateNavBtn(name, y)
    local B = Instance.new("TextButton", LeftNav)
    B.Size = UDim2.new(1, -10, 0, 45)
    B.Position = UDim2.new(0, 5, 0, y)
    B.Text = "<b>" .. name:upper() .. "</b>"
    B.RichText = true
    B.Font = Enum.Font.FredokaOne
    B.TextColor3 = Color3.new(1,1,0)
    B.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Instance.new("UICorner", B).CornerRadius = UDim.new(0, 8)
    B.MouseButton1Click:Connect(function() ShowTab(name) end)
end

CreateNavBtn("Move", 10)
CreateNavBtn("Spin", 65)
CreateNavBtn("View", 120)
CreateNavBtn("Misc", 175)

local function CreateToggle(parent, text, y, callback)
    local B = Instance.new("TextButton", parent)
    B.Size = UDim2.new(1, -10, 0, 40)
    B.Position = UDim2.new(0, 5, 0, y)
    B.Text = "<b>" .. text .. "</b>"
    B.RichText = true
    B.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    B.TextColor3 = Color3.new(1,1,0)
    B.Font = Enum.Font.FredokaOne
    Instance.new("UICorner", B).CornerRadius = UDim.new(0, 8)
    local s = false
    B.MouseButton1Click:Connect(function()
        s = not s
        callback(s)
        B.BackgroundColor3 = s and Color3.new(1,1,0) or Color3.fromRGB(20, 20, 20)
        B.TextColor3 = s and Color3.new(0,0,0) or Color3.new(1,1,0)
    end)
end

local function CreateInput(parent, text, y, def, callback)
    local T = Instance.new("TextBox", parent)
    T.Size = UDim2.new(1, -10, 0, 35)
    T.Position = UDim2.new(0, 5, 0, y)
    T.Text = "<b>" .. text .. def .. "</b>"
    T.RichText = true
    T.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    T.TextColor3 = Color3.new(1,1,0)
    T.Font = Enum.Font.FredokaOne
    Instance.new("UICorner", T).CornerRadius = UDim.new(0, 8)
    T.FocusLost:Connect(function() 
        local val = tonumber(T.Text:match("%d+"))
        if val then callback(val) T.Text = "<b>"..text..val.."</b>" end
    end)
end

-- Tabs Setup
CreateInput(MoveTab, "Speed: ", 0, 30, function(v) Speed = v end)
CreateInput(MoveTab, "Jump: ", 45, 75, function(v) JumpPower = v end)
CreateInput(MoveTab, "Fly Speed: ", 90, 15, function(v) FlySpeed = v end)
CreateToggle(MoveTab, "BOOST", 135, function(s) Enabled = s if s then fenv.StartVelocityMove() end end)
CreateToggle(MoveTab, "FLY", 185, function(s) FlyEnabled = s ToggleFly(s) end)

CreateToggle(SpinTab, "SPINBOT", 0, function(s) SpinEnabled = s ToggleSpin(s) end)
CreateInput(SpinTab, "Spin Speed: ", 50, 50, function(v) SpinSpeed = v end)

CreateInput(ViewTab, "FOV: ", 0, 70, function(v) FOVValue = math.clamp(v, 1, 120) end)

CreateToggle(MiscTab, "X-RAY", 0, function(s) XrayEnabled = s ApplyXray(s) end)
CreateToggle(MiscTab, "ANTI-KB", 50, function(s) AntiKB = s end)
CreateToggle(MiscTab, "ANTI-RAGDOLL", 100, function(s) AntiRagdoll = s end)

ShowTab("Move")
print("Elijr Hub Final Version Loaded!")
