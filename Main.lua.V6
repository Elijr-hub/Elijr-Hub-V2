-- Elijr Hub – Steal a Brainrot (MOBILE FIXED SPEED)
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Enabled, FlyEnabled, AntiKB, AntiRagdoll, SpinEnabled, XrayEnabled, AutoSteal = false, false, false, false, false, false, false
local Speed, JumpPower, SpinSpeed, FlySpeed, FOVValue, StealDist = 30, 50, 50, 15, 70, 50 
local FlyConnection

-- [UI SYSTEM]
local ScreenGui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
ScreenGui.Name = "ElijrHubFinal"
ScreenGui.ResetOnSpawn = false

-- PROGRESS BAR
local ProgressBack = Instance.new("Frame", ScreenGui)
ProgressBack.Size = UDim2.new(0, 300, 0, 25)
ProgressBack.Position = UDim2.new(0.5, -150, 0, 60)
ProgressBack.BackgroundColor3 = Color3.new(0,0,0)
ProgressBack.Visible = false
Instance.new("UICorner", ProgressBack)
local ProgStroke = Instance.new("UIStroke", ProgressBack)
ProgStroke.Color = Color3.new(1,1,0)
ProgStroke.Thickness = 2

local ProgressFill = Instance.new("Frame", ProgressBack)
ProgressFill.Size = UDim2.new(0, 0, 1, 0)
ProgressFill.BackgroundColor3 = Color3.new(1,1,0)
Instance.new("UICorner", ProgressFill)

-- HOLLOW RING
local CirclePart = Instance.new("Part", workspace)
CirclePart.Anchored = true
CirclePart.CanCollide = false
CirclePart.Material = Enum.Material.ForceField
CirclePart.Color = Color3.new(1, 1, 0)
CirclePart.Transparency = 1
local Selection = Instance.new("SelectionSphere", CirclePart)
Selection.Color3 = Color3.new(1,1,0)
Selection.Transparency = 0.5

-- [FUNCTIONS]
local function ApplyXray(state)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
            if state then
                if not obj:FindFirstChild("OriginalTrans") then
                    local v = Instance.new("NumberValue", obj)
                    v.Name = "OriginalTrans"
                    v.Value = obj.Transparency
                    obj.Transparency = 0.6
                end
            else
                local v = obj:FindFirstChild("OriginalTrans")
                if v then obj.Transparency = v.Value v:Destroy() end
            end
        end
    end
end

local function ToggleFly(state)
    if FlyConnection then FlyConnection:Disconnect() end
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local Hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if state and HRP and Hum then
        local BV = Instance.new("BodyVelocity", HRP) BV.Name = "ElijrFly"
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        local BG = Instance.new("BodyGyro", HRP) BG.Name = "ElijrGyro"
        BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        Hum.PlatformStand = true
        FlyConnection = RunService.RenderStepped:Connect(function()
            BG.CFrame = Camera.CFrame
            if Hum.MoveDirection.Magnitude > 0 then
                BV.Velocity = (Camera.CFrame.Rotation * Vector3.new(Hum.MoveDirection.X, 0, -Hum.MoveDirection.Magnitude)).Unit * FlySpeed
            else BV.Velocity = Vector3.new(0, 0.1, 0) end
        end)
    else
        if HRP then 
            if HRP:FindFirstChild("ElijrFly") then HRP.ElijrFly:Destroy() end 
            if HRP:FindFirstChild("ElijrGyro") then HRP.ElijrGyro:Destroy() end 
        end
        if Hum then Hum.PlatformStand = false end
    end
end

local function ToggleSpin(state)
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if state and HRP then
        local Spin = Instance.new("AngularVelocity", HRP)
        Spin.Name = "ElijrSpin"
        Spin.MaxTorque = math.huge
        Spin.AngularVelocity = Vector3.new(0, SpinSpeed, 0)
        Spin.Attachment0 = HRP:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", HRP)
        local Stability = Instance.new("BodyGyro", HRP)
        Stability.Name = "ElijrStability"
        Stability.MaxTorque = Vector3.new(math.huge, 0, math.huge)
        Stability.CFrame = HRP.CFrame
    else
        if HRP then
            if HRP:FindFirstChild("ElijrSpin") then HRP.ElijrSpin:Destroy() end
            if HRP:FindFirstChild("ElijrStability") then HRP.ElijrStability:Destroy() end
        end
    end
end

-- [LOOP SYSTEM]
RunService.RenderStepped:Connect(function()
    local Char = LocalPlayer.Character
    local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    
    if HRP then
        if AutoSteal then
            CirclePart.CFrame = CFrame.new(HRP.Position)
            Selection.Adornee = CirclePart
            CirclePart.Size = Vector3.new(StealDist * 2, StealDist * 2, StealDist * 2)
            Selection.Transparency = 0.6
        else
            Selection.Transparency = 1
            Selection.Adornee = nil
        end

        if Hum then
            -- MOBILE FIXED SPEED BOOST
            if Enabled and not FlyEnabled and Hum.MoveDirection.Magnitude > 0 then
                local MoveDir = Hum.MoveDirection
                HRP.Velocity = Vector3.new(MoveDir.X * Speed, HRP.Velocity.Y, MoveDir.Z * Speed)
            end
            if AntiKB and Hum.MoveDirection.Magnitude <= 0 and not FlyEnabled then
                HRP.Velocity = Vector3.new(0, HRP.Velocity.Y, 0)
            end
            if AntiRagdoll and (Hum:GetState() == Enum.HumanoidStateType.Ragdoll or Hum:GetState() == Enum.HumanoidStateType.FallingDown) then
                Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            Hum.JumpPower = JumpPower
            Hum.UseJumpPower = true
        end
    end
    Camera.FieldOfView = FOVValue
end)

task.spawn(function()
    while task.wait(0.1) do
        local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if HRP and AutoSteal and not ProgressBack.Visible then
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("TouchTransmitter") and v.Parent and (HRP.Position - v.Parent.Position).Magnitude <= StealDist then
                    ProgressBack.Visible = true
                    ProgressFill.Size = UDim2.new(0,0,1,0)
                    ProgressFill:TweenSize(UDim2.new(1,0,1,0), "Out", "Linear", 2)
                    task.wait(2)
                    if AutoSteal and v.Parent then 
                        firetouchinterest(HRP, v.Parent, 0) 
                        firetouchinterest(HRP, v.Parent, 1) 
                    end
                    ProgressBack.Visible = false
                    break
                end
            end
        end
    end
end)

