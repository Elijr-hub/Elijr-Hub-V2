local CloseBtn = Instance.new("TextButton", MainFrame)
CloseBtn.Size = UDim2.new(0, 30, 0, 30)
CloseBtn.Position = UDim2.new(1, -35, 0, 8)
CloseBtn.Text = "X"
CloseBtn.Font = Enum.Font.FredokaOne
CloseBtn.TextSize = 24
CloseBtn.TextColor3 = Color3.new(1,1,0)
CloseBtn.BackgroundTransparency = 1
CloseBtn.MouseButton1Click:Connect(function() MainFrame.Visible = false OpenBtn.Visible = true end)
OpenBtn.MouseButton1Click:Connect(function() MainFrame.Visible = true OpenBtn.Visible = false end)

local LeftNav = Instance.new("Frame", MainFrame)
LeftNav.Size = UDim2.new(0, 110, 1, -60)
LeftNav.Position = UDim2.new(0, 10, 0, 50)
LeftNav.BackgroundTransparency = 1

local Content = Instance.new("Frame", MainFrame)
Content.Size = UDim2.new(1, -130, 1, -60)
Content.Position = UDim2.new(0, 120, 0, 50)
Content.BackgroundTransparency = 1

local Tabs = {}
local function NewTab(name)
    local f = Instance.new("ScrollingFrame", Content)
    f.Size, f.BackgroundTransparency, f.Visible, f.ScrollBarThickness = UDim2.new(1,0,1,0), 1, false, 0
    Tabs[name] = f
    return f
end

local MTab, STab, VTab, MiTab = NewTab("Move"), NewTab("Spin"), NewTab("View"), NewTab("Misc")
local function Show(name) for n, t in pairs(Tabs) do t.Visible = (n == name) end end

local function Nav(name, y)
    local b = Instance.new("TextButton", LeftNav)
    b.Size, b.Position = UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, y)
    b.Text, b.Font, b.BackgroundColor3, b.TextColor3 = name:upper(), Enum.Font.FredokaOne, Color3.fromRGB(30,30,30), Color3.new(1,1,0)
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(function() Show(name) end)
end

Nav("Move", 0) Nav("Spin", 45) Nav("View", 90) Nav("Misc", 135)

local function Toggle(p, text, y, cb)
    local b = Instance.new("TextButton", p)
    b.Size, b.Position = UDim2.new(1, -5, 0, 35), UDim2.new(0, 0, 0, y)
    b.Text, b.Font, b.BackgroundColor3, b.TextColor3 = text, Enum.Font.FredokaOne, Color3.fromRGB(20,20,20), Color3.new(1,1,0)
    Instance.new("UICorner", b)
    local s = false
    b.MouseButton1Click:Connect(function()
        s = not s cb(s)
        b.BackgroundColor3 = s and Color3.new(1,1,0) or Color3.fromRGB(20,20,20)
        b.TextColor3 = s and Color3.new(0,0,0) or Color3.new(1,1,0)
    end)
end

local function Input(p, text, y, def, cb)
    local t = Instance.new("TextBox", p)
    t.Size, t.Position = UDim2.new(1, -5, 0, 35), UDim2.new(0, 0, 0, y)
    t.Text, t.Font, t.BackgroundColor3, t.TextColor3 = text .. def, Enum.Font.FredokaOne, Color3.fromRGB(20,20,20), Color3.new(1,1,0)
    Instance.new("UICorner", t)
    t.FocusLost:Connect(function()
        local v = tonumber(t.Text:match("%d+"))
        if v then cb(v) t.Text = text .. v end
    end)
end

Input(MTab, "Speed: ", 0, 30, function(v) Speed = v end)
Input(MTab, "Jump: ", 40, 50, function(v) JumpPower = v end)
Toggle(MTab, "SPEED BOOST", 80, function(s) Enabled = s end)
Toggle(MTab, "FLY", 120, function(s) FlyEnabled = s ToggleFly(s) end)
Toggle(STab, "SPINBOT", 0, function(s) SpinEnabled = s ToggleSpin(s) end)
Input(STab, "Spin Speed: ", 40, 50, function(v) SpinSpeed = v end)
Input(VTab, "FOV: ", 0, 70, function(v) FOVValue = v end)
Toggle(MiTab, "AUTO STEAL", 0, function(s) AutoSteal = s end)
Input(MiTab, "Reach: ", 40, 50, function(v) StealDist = v end)
Toggle(MiTab, "ANTI-KB", 80, function(s) AntiKB = s end)
Toggle(MiTab, "ANTI-RAGDOLL", 120, function(s) AntiRagdoll = s end)
Toggle(MiTab, "X-RAY", 160, function(s) XrayEnabled = s ApplyXray(s) end)

Show("Move")
MainFrame.Visible = true
