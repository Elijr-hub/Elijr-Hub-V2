SelectionPart.Parent = workspace

-- PROGRESS BAR (Top Center)
local ProgressBack = Instance.new("Frame", ScreenGui)
ProgressBack.Size = UDim2.new(0, 300, 0, 25)
ProgressBack.Position = UDim2.new(0.5, -150, 0, 40)
ProgressBack.BackgroundColor3 = Color3.new(0,0,0)
ProgressBack.Visible = false
Instance.new("UICorner", ProgressBack).CornerRadius = UDim.new(0, 8)
Instance.new("UIStroke", ProgressBack).Color = Color3.new(1,1,0)

local ProgressFill = Instance.new("Frame", ProgressBack)
ProgressFill.Size = UDim2.new(0, 0, 1, 0)
ProgressFill.BackgroundColor3 = Color3.new(1,1,0)
Instance.new("UICorner", ProgressFill).CornerRadius = UDim.new(0, 8)

-- AUTO STEAL & CIRCLE UPDATE
task.spawn(function()
    while task.wait() do
        local Char = LocalPlayer.Character
        local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
        
        if HRP then
            -- Update Range Circle Position and Size
            SelectionPart.CFrame = HRP.CFrame * CFrame.Angles(0, 0, math.rad(90)) + Vector3.new(0, -2.8, 0)
            SelectionPart.Size = Vector3.new(0.2, StealDist * 2, StealDist * 2)
            SelectionPart.Transparency = AutoSteal and 0.5 or 1
            
            if AutoSteal and not ProgressBack.Visible then
                local target = nil
                for _, v in pairs(workspace:GetDescendants()) do
                    if v:IsA("TouchTransmitter") and v.Parent and v.Parent:IsA("BasePart") then
                        if (HRP.Position - v.Parent.Position).Magnitude <= StealDist then
                            target = v.Parent break
                        end
                    end
                end
                if target then
                    ProgressBack.Visible = true
                    ProgressFill.Size = UDim2.new(0,0,1,0)
                    ProgressFill:TweenSize(UDim2.new(1, 0, 1, 0), "Out", "Linear", 3)
                    task.wait(3)
                    if AutoSteal and target and target.Parent and (HRP.Position - target.Position).Magnitude <= StealDist + 5 then
                        firetouchinterest(HRP, target, 0)
                        firetouchinterest(HRP, target, 1)
                    end
                    ProgressBack.Visible = false
                end
            end
        end
    end
end)

-- CHARACTER LOOP (Speed, Jump, Anti-Ragdoll, Anti-KB)
RunService.Heartbeat:Connect(function()
    local Char = LocalPlayer.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
    
    if Hum and HRP then
        -- Speed Boost
        if Enabled and not FlyEnabled and Hum.MoveDirection.Magnitude > 0 then
            HRP.Velocity = Vector3.new(Hum.MoveDirection.Unit.X * Speed, HRP.Velocity.Y, Hum.MoveDirection.Unit.Z * Speed)
        end
        -- Anti-Knockback
        if AntiKB and Hum.MoveDirection.Magnitude <= 0 and not FlyEnabled then
            HRP.Velocity = Vector3.new(0, HRP.Velocity.Y, 0)
        end
        -- Anti-Ragdoll
        if AntiRagdoll then
            if Hum:GetState() == Enum.HumanoidStateType.Ragdoll or Hum:GetState() == Enum.HumanoidStateType.FallingDown then
                Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
        -- Jump Power
        Hum.JumpPower = JumpPower
        Hum.UseJumpPower = true
    end
    Camera.FieldOfView = FOVValue
end)

-- FLY & SPIN FUNCTIONS
local function ToggleFly(state)
    if FlyConnection then FlyConnection:Disconnect() FlyConnection = nil end
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local Hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if state and HRP and Hum then
        local BV = Instance.new("BodyVelocity", HRP) BV.Name = "ElijrFly"
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        local BG = Instance.new("BodyGyro", HRP) BG.Name = "ElijrGyro"
        BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        Hum.PlatformStand = true
        FlyConnection = RunService.RenderStepped:Connect(function()
            BG.CFrame = Camera.CFrame
            if Hum.MoveDirection.Magnitude > 0 then
                BV.Velocity = (Camera.CFrame.Rotation * Vector3.new(Hum.MoveDirection.X, 0, -Hum.MoveDirection.Magnitude)).Unit * FlySpeed
                BV.Velocity = Vector3.new(BV.Velocity.X, Camera.CFrame.LookVector.Y * FlySpeed * Hum.MoveDirection.Magnitude, BV.Velocity.Z)
            else BV.Velocity = Vector3.new(0, 0.1, 0) end
        end)
    else
        if HRP then
            if HRP:FindFirstChild("ElijrFly") then HRP.ElijrFly:Destroy() end
            if HRP:FindFirstChild("ElijrGyro") then HRP.ElijrGyro:Destroy() end
        end
        if Hum then Hum.PlatformStand = false end
    end
end

local function ToggleSpin(state)
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if state and HRP then
        local Spin = Instance.new("AngularVelocity", HRP) Spin.Name = "ElijrSpin"
        Spin.MaxTorque = math.huge
        Spin.AngularVelocity = Vector3.new(0, SpinSpeed, 0)
        Spin.Attachment0 = HRP:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", HRP)
    else
        if HRP and HRP:FindFirstChild("ElijrSpin") then HRP.ElijrSpin:Destroy() end
    end
end

-- XRay Function
local function ApplyXray(state)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
            local isFloor = obj.Name:lower():find("floor") or obj.Name:lower():find("baseplate") or (obj.Size.Y <= 1 and obj.Size.X >= 50)
            if state then
                if not isFloor and not obj:FindFirstChild("ElijrXray") then
                    local original = Instance.new("NumberValue", obj)
                    original.Name = "ElijrXray"
                    original.Value = obj.Transparency
                    obj.Transparency = 0.65 
                end
            else
                local saved = obj:FindFirstChild("ElijrXray")
                if saved then obj.Transparency = saved.Value saved:Destroy() end
            end
        end
    end
end

