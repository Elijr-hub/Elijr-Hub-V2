Instance.new("UIStroke", LeftNav).Color = Color3.new(1,1,0)

local ContentArea = Instance.new("Frame", MainFrame)
ContentArea.Size = UDim2.new(1, -140, 1, -60)
ContentArea.Position = UDim2.new(0, 130, 0, 50)
ContentArea.BackgroundTransparency = 1

local Tabs = {}
local function CreateTab(name)
    local F = Instance.new("ScrollingFrame", ContentArea)
    F.Size = UDim2.new(1, 0, 1, 0)
    F.BackgroundTransparency = 1
    F.Visible = false
    F.ScrollBarThickness = 0
    Tabs[name] = F
    return F
end

local MoveTab, SpinTab, ViewTab, MiscTab = CreateTab("Move"), CreateTab("Spin"), CreateTab("View"), CreateTab("Misc")
local function ShowTab(name) for n, f in pairs(Tabs) do f.Visible = (n == name) end end

local function CreateNavBtn(name, y)
    local B = Instance.new("TextButton", LeftNav)
    B.Size = UDim2.new(1, -10, 0, 45)
    B.Position = UDim2.new(0, 5, 0, y)
    B.Text = "<b>" .. name:upper() .. "</b>"
    B.RichText = true
    B.Font = Enum.Font.FredokaOne
    B.TextColor3 = Color3.new(1,1,0)
    B.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Instance.new("UICorner", B)
    B.MouseButton1Click:Connect(function() ShowTab(name) end)
end

CreateNavBtn("Move", 10) CreateNavBtn("Spin", 65) CreateNavBtn("View", 120) CreateNavBtn("Misc", 175)

local function CreateToggle(parent, text, y, callback)
    local B = Instance.new("TextButton", parent)
    B.Size = UDim2.new(1, -10, 0, 40)
    B.Position = UDim2.new(0, 5, 0, y)
    B.Text = "<b>" .. text .. "</b>"
    B.RichText = true
    B.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    B.TextColor3 = Color3.new(1,1,0)
    B.Font = Enum.Font.FredokaOne
    Instance.new("UICorner", B)
    local s = false
    B.MouseButton1Click:Connect(function()
        s = not s callback(s)
        B.BackgroundColor3 = s and Color3.new(1,1,0) or Color3.fromRGB(20, 20, 20)
        B.TextColor3 = s and Color3.new(0,0,0) or Color3.new(1,1,0)
    end)
end

local function CreateInput(parent, text, y, def, callback)
    local T = Instance.new("TextBox", parent)
    T.Size = UDim2.new(1, -10, 0, 35)
    T.Position = UDim2.new(0, 5, 0, y)
    T.Text = "<b>" .. text .. def .. "</b>"
    T.RichText = true
    T.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    T.TextColor3 = Color3.new(1,1,0)
    T.Font = Enum.Font.FredokaOne
    Instance.new("UICorner", T)
    T.FocusLost:Connect(function() 
        local val = tonumber(T.Text:match("%d+"))
        if val then callback(val) T.Text = "<b>"..text..val.."</b>" end
    end)
end

-- MOVE TAB
CreateInput(MoveTab, "Speed: ", 0, 30, function(v) Speed = v end)
CreateInput(MoveTab, "Jump: ", 40, 50, function(v) JumpPower = v end)
CreateInput(MoveTab, "Fly Speed: ", 80, 15, function(v) FlySpeed = v end)
CreateToggle(MoveTab, "SPEED BOOST", 125, function(s) Enabled = s end)
CreateToggle(MoveTab
