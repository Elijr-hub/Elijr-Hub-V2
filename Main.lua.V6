-- Elijr Hub – Steal a Brainrot (UI & LOGIC CLEANUP)
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Enabled, FlyEnabled, AntiKB, AntiRagdoll, SpinEnabled, XrayEnabled, AutoSteal = false, false, false, false, false, false, false
local Speed, JumpPower, SpinSpeed, FlySpeed, FOVValue, StealDist = 30, 50, 50, 15, 70, 50 
local FlyConnection

-- [UI SYSTEM]
local ScreenGui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
ScreenGui.Name = "ElijrHubFinal"
ScreenGui.ResetOnSpawn = false

-- PROGRESS BAR (Top)
local ProgressBack = Instance.new("Frame", ScreenGui)
ProgressBack.Size = UDim2.new(0, 300, 0, 25)
ProgressBack.Position = UDim2.new(0.5, -150, 0, 40)
ProgressBack.BackgroundColor3 = Color3.new(0,0,0)
ProgressBack.Visible = false
Instance.new("UICorner", ProgressBack)
Instance.new("UIStroke", ProgressBack).Color = Color3.new(1,1,0)

local ProgressFill = Instance.new("Frame", ProgressBack)
ProgressFill.Size = UDim2.new(0, 0, 1, 0)
ProgressFill.BackgroundColor3 = Color3.new(1,1,0)
Instance.new("UICorner", ProgressFill)

-- RANGE CIRCLE
local SelectionPart = Instance.new("Part")
SelectionPart.Shape = Enum.PartType.Cylinder
SelectionPart.Material = Enum.Material.ForceField
SelectionPart.Color = Color3.new(1, 1, 0)
SelectionPart.Transparency = 1
SelectionPart.Anchored = true
SelectionPart.CanCollide = false
SelectionPart.Parent = workspace

-- [FUNCTIONS]
local function ApplyXray(state)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
            if state then
                if not obj:FindFirstChild("OriginalTrans") then
                    local v = Instance.new("NumberValue", obj)
                    v.Name = "OriginalTrans"
                    v.Value = obj.Transparency
                    obj.Transparency = 0.6
                end
            else
                local v = obj:FindFirstChild("OriginalTrans")
                if v then obj.Transparency = v.Value v:Destroy() end
            end
        end
    end
end

local function ToggleFly(state)
    if FlyConnection then FlyConnection:Disconnect() end
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local Hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if state and HRP and Hum then
        local BV = Instance.new("BodyVelocity", HRP) BV.Name = "ElijrFly"
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        local BG = Instance.new("BodyGyro", HRP) BG.Name = "ElijrGyro"
        BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        Hum.PlatformStand = true
        FlyConnection = RunService.RenderStepped:Connect(function()
            BG.CFrame = Camera.CFrame
            if Hum.MoveDirection.Magnitude > 0 then
                BV.Velocity = (Camera.CFrame.Rotation * Vector3.new(Hum.MoveDirection.X, 0, -Hum.MoveDirection.Magnitude)).Unit * FlySpeed
            else BV.Velocity = Vector3.new(0, 0.1, 0) end
        end)
    else
        if HRP then 
            if HRP:FindFirstChild("ElijrFly") then HRP.ElijrFly:Destroy() end 
            if HRP:FindFirstChild("ElijrGyro") then HRP.ElijrGyro:Destroy() end 
        end
        if Hum then Hum.PlatformStand = false end
    end
end

local function ToggleSpin(state)
    local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if state and HRP then
        local Spin = Instance.new("AngularVelocity", HRP)
        Spin.Name = "ElijrSpin"
        Spin.MaxTorque = math.huge
        Spin.AngularVelocity = Vector3.new(0, SpinSpeed, 0)
        Spin.Attachment0 = HRP:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", HRP)
    else
        if HRP and HRP:FindFirstChild("ElijrSpin") then HRP.ElijrSpin:Destroy() end
    end
end

-- [LOOPS]
task.spawn(function()
    while task.wait() do
        local Char = LocalPlayer.Character
        local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
        if HRP then
            SelectionPart.CFrame = HRP.CFrame * CFrame.Angles(0, 0, math.rad(90)) + Vector3.new(0, -2.8, 0)
            SelectionPart.Size = Vector3.new(0.1, StealDist * 2, StealDist * 2)
            SelectionPart.Transparency = AutoSteal and 0.5 or 1
            if AutoSteal and not ProgressBack.Visible then
                for _, v in pairs(workspace:GetDescendants()) do
                    if v:IsA("TouchTransmitter") and (HRP.Position - v.Parent.Position).Magnitude <= StealDist then
                        ProgressBack.Visible = true
                        ProgressFill.Size = UDim2.new(0,0,1,0)
                        ProgressFill:TweenSize(UDim2.new(1,0,1,0), "Out", "Linear", 3)
                        task.wait(3)
                        if AutoSteal then 
                            firetouchinterest(HRP, v.Parent, 0) firetouchinterest(HRP, v.Parent, 1) 
                        end
                        ProgressBack.Visible = false
                        break
                    end
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local Char = LocalPlayer.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
    if Hum and HRP then
        if Enabled and not FlyEnabled and Hum.MoveDirection.Magnitude > 0 then
            HRP.Velocity = Vector3.new(Hum.MoveDirection.Unit.X * Speed, HRP.Velocity.Y, Hum.MoveDirection.Unit.Z * Speed)
        end
        if AntiKB and Hum.MoveDirection.Magnitude <= 0 and not FlyEnabled then
            HRP.Velocity = Vector3.new(0, HRP.Velocity.Y, 0)
        end
        if AntiRagdoll and (Hum:GetState() == Enum.HumanoidStateType.Ragdoll or Hum:GetState() == Enum.HumanoidStateType.FallingDown) then
            Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        Hum.JumpPower = JumpPower
        Hum.UseJumpPower = true
    end
    Camera.FieldOfView = FOVValue
end)

-- [GUI SETUP]
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 420, 0, 320)
MainFrame.Position = UDim2.new(0.5, -210, 0.5, -160)
MainFrame.BackgroundColor3 = Color3.new(0,0,0)
MainFrame.Draggable = true
Instance.new("UIStroke", MainFrame).Color = Color3.new(1,1,0)
Instance.new("UICorner", MainFrame)

local OpenBtn = Instance.new("TextButton", ScreenGui)
OpenBtn.Size = UDim2.new(0, 60, 0, 60)
OpenBtn.Position = UDim2.new(0, 15, 0.5, -30)
OpenBtn.Text = "OPEN"
OpenBtn.Font = Enum.Font.FredokaOne
OpenBtn.BackgroundColor3 = Color3.new(0,0,0)
OpenBtn.TextColor3 = Color3.new(1,1,0)
OpenBtn.Visible = false
OpenBtn.Draggable = true
Instance.new("UICorner", OpenBtn).CornerRadius = UDim.new(1,0)
Instance.new("UIStroke", OpenBtn).Color = Color3.new(1,1,0)

local CloseBtn = Instance.new("TextButton", MainFrame)
CloseBtn.Size = UDim2.new(0, 30, 0, 30)
CloseBtn.Position = UDim2.new(1, -35, 0, 5)
CloseBtn.Text = "X"
CloseBtn.Font = Enum.Font.FredokaOne
CloseBtn.TextSize = 20
CloseBtn.TextColor3 = Color3.new(1,1,0)
CloseBtn.BackgroundTransparency = 1
CloseBtn.MouseButton1Click:Connect(function() MainFrame.Visible = false OpenBtn.Visible = true end)
OpenBtn.MouseButton1Click:Connect(function() MainFrame.Visible = true OpenBtn.Visible = false end)

local LeftNav = Instance.new("Frame", MainFrame)
LeftNav.Size = UDim2.new(0, 100, 1, -50)
LeftNav.Position = UDim2.new(0, 10, 0, 40)
LeftNav.BackgroundTransparency = 1

local Content = Instance.new("Frame", MainFrame)
Content.Size = UDim2.new(1, -120, 1, -50)
Content.Position = UDim2.new(0, 110, 0, 40)
Content.BackgroundTransparency = 1

local Tabs = {}
local function NewTab(name)
    local f = Instance.new("ScrollingFrame", Content)
    f.Size = UDim2.new(1,0,1,0)
    f.BackgroundTransparency = 1
    f.Visible = false
    f.ScrollBarThickness = 0
    Tabs[name] = f
    return f
end

local MTab = NewTab("Move")
local STab = NewTab("Spin")
local VTab = NewTab("View")
local MiTab = NewTab("Misc")

local function Show(name) for n, t in pairs(Tabs) do t.Visible = (n == name) end end

local function Nav(name, y)
    local b = Instance.new("TextButton", LeftNav)
    b.Size = UDim2.new(1, 0, 0, 35)
    b.Position = UDim2.new(0, 0, 0, y)
    b.Text = name:upper()
    b.Font = Enum.Font.FredokaOne
    b.BackgroundColor3 = Color3.fromRGB(30,30,30)
    b.TextColor3 = Color3.new(1,1,0)
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(function() Show(name) end)
end

Nav("Move", 0) Nav("Spin", 40) Nav("View", 80) Nav("Misc", 120)

local function Toggle(p, text, y, cb)
    local b = Instance.new("TextButton", p)
    b.Size = UDim2.new(1, -5, 0, 30)
    b.Position = UDim2.new(0, 0, 0, y)
    b.Text = text
    b.Font = Enum.Font.FredokaOne
    b.BackgroundColor3 = Color3.fromRGB(20,20,20)
    b.TextColor3 = Color3.new(1,1,0)
    Instance.new("UICorner", b)
    local s = false
    b.MouseButton1Click:Connect(function()
        s = not s cb(s)
        b.BackgroundColor3 = s and Color3.new(1,1,0) or Color3.fromRGB(20,20,20)
        b.TextColor3 = s and Color3.new(0,0,0) or Color3.new(1,1,0)
    end)
end

local function Input(p, text, y, def, cb)
    local t = Instance.new("TextBox", p)
    t.Size = UDim2.new(1, -5, 0, 30)
    t.Position = UDim2.new(0, 0, 0, y)
    t.Text = text .. def
    t.Font = Enum.Font.FredokaOne
    t.BackgroundColor3 = Color3.fromRGB(20,20,20)
    t.TextColor3 = Color3.new(1,1,0)
    Instance.new("UICorner", t)
    t.FocusLost:Connect(function()
        local v = tonumber(t.Text:match("%d+"))
        if v then cb(v) t.Text = text .. v end
    end)
end

-- SETUP TABS
Input(MTab, "Speed: ", 0, 30, function(v) Speed = v end)
Input(MTab, "Jump: ", 35, 50, function(v) JumpPower = v end)
Toggle(MTab, "SPEED BOOST", 70, function(s) Enabled = s end)
Toggle(MTab, "FLY", 105, function(s) FlyEnabled = s ToggleFly(s) end)

Toggle(STab, "SPINBOT", 0, function(s) SpinEnabled = s ToggleSpin(s) end)
Input(STab, "Spin Speed: ", 35, 50, function(v) SpinSpeed = v end)

Input(VTab, "FOV: ", 0, 70, function(v) FOVValue = v end)

Toggle(MiTab, "AUTO STEAL", 0, function(s) AutoSteal = s end)
Input(MiTab, "Reach: ", 35, 50, function(v) StealDist = v end)
Toggle(MiTab, "ANTI-KB", 70, function(s) AntiKB = s end)
Toggle(MiTab, "ANTI-RAGDOLL", 105, function(s) AntiRagdoll = s end)
Toggle(MiTab, "X-RAY", 140, function(s) XrayEnabled = s ApplyXray(s) end)

Show("Move")
MainFrame.Visible = true
