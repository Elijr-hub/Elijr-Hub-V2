-- Elijr hub Booster – Redesign Edition
local fenv = getfenv()
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local VelocityConnection
local Enabled, FlyEnabled, AntiKB, AntiRagdoll, SpinEnabled, XrayEnabled = false, false, false, false, false, false
local Speed, JumpPower, SpinSpeed, FlySpeed, FOVValue = 30, 75, 50, 15, 70 

-- ────────────────────────────────────────────────────────────────
--                         Logic Functions
-- ────────────────────────────────────────────────────────────────

local function ApplyXray(state)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
            local isFloor = obj.Name:lower():find("floor") or obj.Name:lower():find("baseplate") or (obj.Size.Y <= 1 and obj.Size.X >= 50)
            if state then
                if not isFloor and not obj:FindFirstChild("ElijrXray") then
                    local original = Instance.new("NumberValue", obj)
                    original.Name = "ElijrXray"
                    original.Value = obj.Transparency
                    obj.Transparency = 0.65 
                end
            else
                local saved = obj:FindFirstChild("ElijrXray")
                if saved then obj.Transparency = saved.Value saved:Destroy() end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    local Character = LocalPlayer.Character
    if not Character then return end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not HRP then return end
    if AntiRagdoll then
        if Humanoid:GetState() == Enum.HumanoidStateType.Ragdoll or Humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
    if AntiKB and Enabled and not FlyEnabled then
        if Humanoid.MoveDirection.Magnitude <= 0 then HRP.Velocity = Vector3.new(0, HRP.Velocity.Y, 0) end
    end
    Camera.FieldOfView = FOVValue
end)

fenv.StartVelocityMove = function()
    if VelocityConnection then return end
    VelocityConnection = RunService.Heartbeat:Connect(function()
        local Character = LocalPlayer.Character
        if not Character or not Enabled or FlyEnabled then return end
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local HRP = Character:FindFirstChild("HumanoidRootPart")
        if HRP and Humanoid and Humanoid.MoveDirection.Magnitude > 0 then
            HRP.Velocity = Vector3.new(Humanoid.MoveDirection.Unit.X * Speed, HRP.Velocity.Y, Humanoid.MoveDirection.Unit.Z * Speed)
        end
        if Humanoid then Humanoid.UseJumpPower = true Humanoid.JumpPower = JumpPower end
    end)
end

local function ToggleSpin(state)
    local Character = LocalPlayer.Character
    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    if state and HRP then
        local Spin = Instance.new("AngularVelocity", HRP)
        Spin.Name = "ElijrSpin"
        Spin.MaxTorque = math.huge
        Spin.AngularVelocity = Vector3.new(0, SpinSpeed, 0)
        Spin.Attachment0 = HRP:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", HRP)
        local Gyro = Instance.new("BodyGyro", HRP)
        Gyro.Name = "ElijrSpinGyro"
        Gyro.MaxTorque = Vector3.new(math.huge, 0, math.huge)
        Gyro.P = 9e6
    else
        if HRP then
            if HRP:FindFirstChild("ElijrSpin") then HRP.ElijrSpin:Destroy() end
            if HRP:FindFirstChild("ElijrSpinGyro") then HRP.ElijrSpinGyro:Destroy() end
        end
    end
end

local function ToggleFly(state)
    local Character = LocalPlayer.Character
    local HRP = Character and Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if state and HRP then
        local BV = Instance.new("BodyVelocity", HRP)
        BV.Name = "ElijrFly"
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        local BG = Instance.new("BodyGyro", HRP)
        BG.Name = "ElijrGyro"
        BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        Humanoid.PlatformStand = true
        fenv.FlyLoop = RunService.RenderStepped:Connect(function()
            BG.CFrame = Camera.CFrame
            if Humanoid.MoveDirection.Magnitude > 0 then
                BV.Velocity = (Camera.CFrame.Rotation * Vector3.new(Humanoid.MoveDirection.X, 0, -Humanoid.MoveDirection.Magnitude)).Unit * FlySpeed
                BV.Velocity = Vector3.new(BV.Velocity.X, Camera.CFrame.LookVector.Y * FlySpeed * Humanoid.MoveDirection.Magnitude, BV.Velocity.Z)
            else
                BV.Velocity = Vector3.new(0, 0.1, 0)
            end
        end)
    else
        if fenv.FlyLoop then fenv.FlyLoop:Disconnect() end
        if HRP and HRP:FindFirstChild("ElijrFly") then HRP.ElijrFly:Destroy() end
        if HRP and HRP:FindFirstChild("ElijrGyro") then HRP.ElijrGyro:Destroy() end
        if Humanoid then Humanoid.PlatformStand = false end
    end
end

-- ────────────────────────────────────────────────────────────────
--                           Square GUI
-- ────────────────────────────────────────────────────────────────
local ScreenGui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
ScreenGui.Name = "ElijrHubV5"
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 400, 0, 300)
MainFrame.Position = UDim2.new(0.5, -200, 0.5, -150)
MainFrame.BackgroundColor3 = Color3.new(0,0,0)
MainFrame.Active = true
MainFrame.Draggable = true
Instance.new("UIStroke", MainFrame).Color = Color3.fromRGB(255, 255, 0)

local LeftNav = Instance.new("Frame", MainFrame)
LeftNav.Size = UDim2.new(0, 100, 1, 0)
LeftNav.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Instance.new("UIStroke", LeftNav).Color = Color3.fromRGB(255, 255, 0)

local ContentArea = Instance.new("Frame", MainFrame)
ContentArea.Size = UDim2.new(1, -110, 1, -10)
ContentArea.Position = UDim2.new(0, 105, 0, 5)
ContentArea.BackgroundTransparency = 1

local Tabs = {}
local function CreateTabFrame(name)
    local F = Instance.new("ScrollingFrame", ContentArea)
    F.Size = UDim2.new(1, 0, 1, 0)
    F.BackgroundTransparency = 1
    F.Visible = false
    F.CanvasSize = UDim2.new(0,0,1.5,0)
    F.ScrollBarThickness = 2
    Tabs[name] = F
    return F
end

local MoveTab = CreateTabFrame("Move")
local SpinTab = CreateTabFrame("Spin")
local ViewTab = CreateTabFrame("View")
local MiscTab = CreateTabFrame("Misc")

local function ShowTab(name)
    for n, f in pairs(Tabs) do f.Visible = (n == name) end
end

local function CreateNavBtn(name, y)
    local B = Instance.new("TextButton", LeftNav)
    B.Size = UDim2.new(1, -10, 0, 40)
    B.Position = UDim2.new(0, 5, 0, y)
    B.Text = name:upper()
    B.Font = Enum.Font.GothamBold
    B.TextColor3 = Color3.new(1,1,0)
    B.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    B.MouseButton1Click:Connect(function() ShowTab(name) end)
end

CreateNavBtn("Move", 10)
CreateNavBtn("Spin", 60)
CreateNavBtn("View", 110)
CreateNavBtn("Misc", 160)

local function CreateToggle(parent, text, y, callback)
    local B = Instance.new("TextButton", parent)
    B.Size = UDim2.new(1, -10, 0, 35)
    B.Position = UDim2.new(0, 5, 0, y)
    B.Text = "<b>" .. text .. "</b>"
    B.RichText = true
    B.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    B.TextColor3 = Color3.new(1,1,0)
    B.Font = Enum.Font.GothamBold
    local s = false
    B.MouseButton1Click:Connect(function()
        s = not s
        callback(s)
        B.BackgroundColor3 = s and Color3.new(1,1,0) or Color3.fromRGB(20, 20, 20)
        B.TextColor3 = s and Color3.new(0,0,0) or Color3.new(1,1,0)
    end)
end

local function CreateInput(parent, text, y, def, callback)
    local T = Instance.new("TextBox", parent)
    T.Size = UDim2.new(1, -10, 0, 30)
    T.Position = UDim2.new(0, 5, 0, y)
    T.Text = "<b>" .. text .. def .. "</b>"
    T.RichText = true
    T.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    T.TextColor3 = Color3.new(1,1,0)
    T.Font = Enum.Font.GothamBold
    T.FocusLost:Connect(function() 
        local val = tonumber(T.Text:match("%d+"))
        if val then callback(val) T.Text = "<b>"..text..val.."</b>" end
    end)
end

-- Tab Setup
CreateInput(MoveTab, "Speed: ", 10, 30, function(v) Speed = v end)
CreateInput(MoveTab, "Jump: ", 50, 75, function(v) JumpPower = v end)
CreateInput(MoveTab, "Fly Speed: ", 90, 15, function(v) FlySpeed = v end)
CreateToggle(MoveTab, "BOOST", 130, function(s) Enabled = s if s then fenv.StartVelocityMove() end end)
CreateToggle(MoveTab, "FLY", 175, function(s) FlyEnabled = s ToggleFly(s) end)

CreateToggle(SpinTab, "SPINBOT", 10, function(s) SpinEnabled = s ToggleSpin(s) end)
CreateInput(SpinTab, "Spin Speed: ", 55, 50, function(v) SpinSpeed = v end)

CreateInput(ViewTab, "FOV: ", 10, 70, function(v) FOVValue = math.clamp(v, 1, 120) end)

CreateToggle(MiscTab, "X-RAY", 10, function(s) XrayEnabled = s ApplyXray(s) end)
CreateToggle(MiscTab, "ANTI-KB", 55, function(s) AntiKB = s end)
CreateToggle(MiscTab, "ANTI-RAGDOLL", 100, function(s) AntiRagdoll = s end)

ShowTab("Move")
print("Elijr hub Square Multi-Tab Loaded!")
