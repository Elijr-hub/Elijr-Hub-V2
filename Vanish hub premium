-- Teleport function (called once on join if enabled)
_G.doTeleportToBestBrainrot = function()
    local success, err = pcall(function()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return end
        
        -- Trigger a scan if cache is empty
        if _G.scanAllAnimals and (not _G.allAnimalsCache or #_G.allAnimalsCache == 0) then
            _G.scanAllAnimals()
        end
        
        -- Find best animal from cache (not on our base, not in fuse)
        local bestAnimal = nil
        local bestPlot = nil
        local bestPetPos = nil
        
        if _G.allAnimalsCache and #_G.allAnimalsCache > 0 then
            for _, animalData in ipairs(_G.allAnimalsCache) do
                if not animalData.plot then continue end
                
                local plot = plots:FindFirstChild(animalData.plot)
                if not plot then continue end
                
                -- Skip our own base
                local isOurBase = false
            local sign = plot:FindFirstChild("PlotSign")
                if sign and sign:FindFirstChild("YourBase") then
                    isOurBase = sign.YourBase.Enabled == true
                end
                if isOurBase then continue end
                
                -- Real-time fuse check on the podium
                local inFuse = false
                local podiums = plot:FindFirstChild("AnimalPodiums")
                if podiums and animalData.slot then
                    local pod = podiums:FindFirstChild(animalData.slot)
                    if pod then
                        for _, child in pairs(pod:GetDescendants()) do
                            if (child:IsA("TextLabel") or child:IsA("TextButton")) then
                                local textUpper = (child.Text or ""):upper()
                                if textUpper:find("FUSE") or textUpper:find("FUSING") or textUpper:find("MACHINE") then
                                    inFuse = true
                    break
                end
            end
        end
                    end
                end
                if inFuse then continue end
                
                -- Find the pet position on the podium
                if podiums and animalData.slot then
                    local pod = podiums:FindFirstChild(animalData.slot)
                    if pod then
                        for _, child in pairs(pod:GetDescendants()) do
                            if child:IsA("Model") and child:FindFirstChildWhichIsA("BasePart") then
                                local part = child:FindFirstChildWhichIsA("BasePart")
                                if part then
                                    bestAnimal = animalData
                                    bestPlot = plot
                                    bestPetPos = part.Position
                                    break
                                end
                                    end
                                end
                            end
                        end
                
                if bestAnimal then break end  -- First valid one is highest (cache is sorted)
                    end
        end
        
        if bestPlot and bestPetPos then
            local delivery = bestPlot:FindFirstChild("DeliveryHitbox")
            if delivery then
                    local dir = (bestPetPos - delivery.Position).Unit
                local finalTarget
                if bestPetPos.Y > 25 then
                    -- Third floor: teleport slightly below
                    finalTarget = Vector3.new(delivery.Position.X + dir.X * 7.6, bestPetPos.Y - 10, delivery.Position.Z + dir.Z * 7.6)
                elseif bestPetPos.Y < 9 then
                    -- First floor: teleport AWAY from brainrot (opposite direction = outside)
                    local awayDir = (delivery.Position - bestPetPos).Unit
                    finalTarget = Vector3.new(delivery.Position.X + awayDir.X * 10, bestPetPos.Y + 5, delivery.Position.Z + awayDir.Z * 10)
                else
                    -- Second floor: teleport slightly toward brainrot from delivery
                    finalTarget = Vector3.new(delivery.Position.X + dir.X * 5, bestPetPos.Y + 5, delivery.Position.Z + dir.Z * 5)
                end
                local char = player.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hrp and hum then
                        -- Find the tools
                        local coil = player.Backpack:FindFirstChild("Coil Combo") or char:FindFirstChild("Coil Combo")
                        local carpet = player.Backpack:FindFirstChild("Flying Carpet") or char:FindFirstChild("Flying Carpet")
                        
                        -- Equip coil for launch boost
                        if coil then hum:EquipTool(coil) end
                        
                        -- Launch up high and fast
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 150, 0)
                        local targetY = hrp.Position.Y + 60
                        local startTime = tick()
                        repeat task.wait() until hrp.Position.Y >= targetY or tick() - startTime > 0.7
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        
                        -- Equip carpet directly (auto-unequips coil) then teleport
                        if carpet then hum:EquipTool(carpet) end
                        hrp.CFrame = CFrame.new(finalTarget)
                        
                    end
                end
            end
        end
    end)
end

