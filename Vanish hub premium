            if _G.LaserCapeData.checkConnection then
                pcall(function() _G.LaserCapeData.checkConnection:Disconnect() end)
                _G.LaserCapeData.checkConnection = nil
            end
        end
        
        -- Disable Instant Pickup
        if _G.InstantPickupData then
            if _G.InstantPickupData.thread then
                pcall(function() task.cancel(_G.InstantPickupData.thread) end)
                _G.InstantPickupData.thread = nil
            end
        end
        
        -- Reset mini button states
        teleportBtn.BackgroundColor3 = BANNER_COLOR
        teleportBtn.BackgroundTransparency = BANNER_ALPHA
