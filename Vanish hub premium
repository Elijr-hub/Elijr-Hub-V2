-- Create the desync marker
local function createDesyncMarker(position)
    if not position then return end
    
    -- Clean up old marker first
    pcall(function()
        if _G.DesyncMarker and _G.DesyncMarker.Parent then
            _G.DesyncMarker:Destroy()
        end
    end)
    _G.DesyncMarker = nil
    _G.DesyncMarkerLabel = nil
    
    -- Ensure position is above ground (add 2 studs to Y)
    local adjustedPos = Vector3.new(position.X, position.Y + 2, position.Z)
    _G.DesyncPosition = adjustedPos

    local part = Instance.new("Part")
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(2.5, 2.5, 2.5)
    part.Color = Color3.fromRGB(0, 170, 255)
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 0.4
    part.Material = Enum.Material.Neon
    part.Name = "VanishHub_DesyncMarker"
    part.Position = adjustedPos
    part.Parent = workspace

    local gui = Instance.new("BillboardGui")
    gui.Name = "VanishHub_DesyncGui"
    gui.Size = UDim2.new(0, 250, 0, 30)
    gui.Adornee = part
    gui.AlwaysOnTop = true
    gui.StudsOffset = Vector3.new(0, 3, 0)
    gui.Parent = part

    local text = Instance.new("TextLabel")
    text.Name = "DesyncLabel"
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "Your Desync Position 0"
    text.Font = Enum.Font.GothamBold
    text.TextSize = 18
    text.TextColor3 = Color3.fromRGB(0, 200, 255)
    text.TextStrokeTransparency = 0.3
    text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    text.Parent = gui

    _G.DesyncMarker = part
    _G.DesyncMarkerLabel = text
    
    -- Hybrid approach: Sample position at intervals and detect significant deviations
    task.spawn(function()
        local samples = {}
        local sampleCount = 0
        local lastMarkerUpdate = tick()
        local minUpdateInterval = 0.2  -- Don't update more than 5 times per second
        
        while true do
            task.wait(0.033)  -- ~30fps sampling
            if not _G.DesyncMarker or not _G.DesyncMarker.Parent then break end
            if not _G.IsDesynced then break end
            
            local char = player.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            
            local currentPos = hrp.Position
            local velocity = hrp.AssemblyLinearVelocity
            local now = tick()
            
            -- Add sample
            sampleCount = sampleCount + 1
            table.insert(samples, {
                pos = currentPos,
                vel = velocity,
                time = now
            })
            
            -- Keep last 15 samples (~0.5 seconds of history)
            while #samples > 15 do
                table.remove(samples, 1)
            end
            
            -- Need at least 3 samples to analyze
            if #samples >= 3 then
                local prev = samples[#samples - 1]
                local dt = now - prev.time
                
                -- Predict where we should be based on previous velocity
                local predictedPos = prev.pos + (prev.vel * dt)
                local predictionError = (currentPos - predictedPos).Magnitude
                
                -- Check if this looks like a server correction
                local isCorrection = false
                
                -- Large prediction error (> 2 studs) = likely server correction
                if predictionError > 2 then
                    isCorrection = true
                end
                
                -- Moving while velocity says we shouldn't be
                if velocity.Magnitude < 0.5 and prev.vel.Magnitude < 0.5 then
                    local moved = (currentPos - prev.pos).Magnitude
                    if moved > 0.8 then
                        isCorrection = true
                    end
                end
                
                -- Apply rate limiting
                if isCorrection and (now - lastMarkerUpdate) > minUpdateInterval then
                    local newPos = Vector3.new(currentPos.X, currentPos.Y + 2, currentPos.Z)
                    _G.DesyncPosition = newPos
                    _G.DesyncMarker.Position = newPos
                    lastMarkerUpdate = now
                end
            end
            
            -- Always update distance text
            if _G.DesyncPosition and _G.DesyncMarkerLabel then
                local dist = math.floor((currentPos - _G.DesyncPosition).Magnitude)
                _G.DesyncMarkerLabel.Text = "Your Desync Position " .. dist
            end
        end
    end)
end

