-- Auto Kick loop with protection against kicking on already-stolen items
_G.AutoKick_StealMessageSeen = false
_G.Webhook_LastStealText = ""
task.spawn(function()
    local wasEnabled = false
    while task.wait(0.2) do
        -- Check if "You stole" message is currently visible
        local stealMessageVisible = false
        local stealText = ""
        pcall(function()
            for _, g in pairs(player.PlayerGui:GetDescendants()) do
                if g:IsA("TextLabel") and g.Text:find("You stole") then
                    stealMessageVisible = true
                    stealText = g.Text
                    break
                end
            end
        end)
        
        -- Send webhook for new steals
        if stealMessageVisible and stealText ~= "" and stealText ~= _G.Webhook_LastStealText then
            _G.Webhook_LastStealText = stealText
            pcall(function() _G.sendStealWebhook(stealText) end)
        end
        if not stealMessageVisible then _G.Webhook_LastStealText = "" end
        
        -- If Auto Kick just got enabled, mark current steal message as "already seen"
        if _G.AutoKickEnabled and not wasEnabled then
            _G.AutoKick_StealMessageSeen = stealMessageVisible
        end
        
        -- If Auto Kick is disabled, reset the seen flag
        if not _G.AutoKickEnabled then
            _G.AutoKick_StealMessageSeen = false
        end
        
        -- Only kick if: Auto Kick is on, message is visible, AND we haven't already seen it
        if _G.AutoKickEnabled and stealMessageVisible and not _G.AutoKick_StealMessageSeen then
            player:Kick("Successful steal - .gg/vanishhub")
        end
        
        -- If message disappears, reset the seen flag so next steal will trigger
        if not stealMessageVisible then
            _G.AutoKick_StealMessageSeen = false
        end
        
        wasEnabled = _G.AutoKickEnabled
    end
end)

