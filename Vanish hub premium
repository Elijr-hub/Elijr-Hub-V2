        _G.FPSDevourConnection = RunService.Heartbeat:Connect(function()
            if not _G.FPSDevourSpamming then
                if _G.FPSDevourConnection then
                    _G.FPSDevourConnection:Disconnect()
                    _G.FPSDevourConnection = nil
                end
                return
            end
            
            local c = player.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
