-- Check if desync FFlags are actually active (for detecting server hop vs full restart)
local function isDesyncActive()
    -- Try to read a key desync FFlag that has a distinctive value
    local testFlag = "S2PhysicsSenderRate"
    local expectedValue = "15000"
    
    local success, result = pcall(function()
        if getfflag then
            return getfflag(testFlag)
        end
        return nil
    end)
    
    if success and result then
        -- Check if the flag matches our desync value
        return tostring(result) == expectedValue
    end
    
    -- If getfflag doesn't work, try reading multiple flags as a backup
    local checksPass = 0
    local flagsToCheck = {
        ["MaxMissedWorldStepsRemembered"] = "-2147483648",
        ["SimDefaultHumanoidTimestepMultiplier"] = "150",
        ["WorldStepMax"] = "30"
    }
    
    for flag, expected in pairs(flagsToCheck) do
        pcall(function()
            if getfflag then
                local val = getfflag(flag)
                if tostring(val) == expected then
                    checksPass = checksPass + 1
                end
            end
        end)
    end
    
    -- If at least 2 flags match, desync is likely active
    return checksPass >= 2
end

_G.isDesyncActive = isDesyncActive  -- Expose for testing

