_G.sendStealWebhook = function(stealText)
    if not WEBHOOK_ENABLED then return end
    -- Rate limit: minimum 3 seconds between webhook calls
    if tick() - _G.lastWebhookTime < 3 then return end
    _G.lastWebhookTime = tick()
    local username = game.Players.LocalPlayer.Name
    local clean = stealText:gsub("<[^>]+>", ""):gsub("You stole ", ""):gsub("!", "")
    clean = clean:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    local msValue = "Unknown"
    pcall(function()
        if _G.allAnimalsCache then
            for _, animal in ipairs(_G.allAnimalsCache) do
                if animal.name and clean:lower():find(animal.name:lower()) then
                    if animal.genValue then
                        local gv = animal.genValue
                        local function fmt(v, s) if v % 1 == 0 then return string.format("%.0f%s", v, s) else return string.format("%.1f%s", v, s) end end
                        if gv >= 1e12 then msValue = fmt(gv/1e12, "T/S")
                        elseif gv >= 1e9 then msValue = fmt(gv/1e9, "B/S")
                        elseif gv >= 1e6 then msValue = fmt(gv/1e6, "M/S")
                        elseif gv >= 1e3 then msValue = fmt(gv/1e3, "K/S")
                        else msValue = string.format("%.0f/s", gv) end
                    end
                    break
                end
            end
        end
    end)
    _G.sendWebhook({
        embeds = {{
            title = "Steal Detected",
