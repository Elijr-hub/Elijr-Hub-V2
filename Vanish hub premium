-- ============================================================
-- ANTI-LAG (Effects & Character Cleanup Only - No Graphics Changes)
-- ============================================================
do
    local ANTILAG = {}
    local antilagThreads = {}
    local antilagConnections = {}
    
    local function addAntilagThread(func)
        local t = task.spawn(func)
        table.insert(antilagThreads, t)
        return t
    end
    
    local function addAntilagConnection(conn)
        table.insert(antilagConnections, conn)
        return conn
    end
    
    -- Destroy visual effects in workspace (particles, trails, beams, lights, fire, smoke, etc.)
    local function nukeVisualEffects()
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                pcall(function()
                    -- Skip VanishHub beams (Beam to Base, Beam to Brainrot)
                    if obj.Name and string.find(obj.Name, "VanishHub_") then return end
                    
                    if obj:IsA("ParticleEmitter") then
                        obj.Enabled = false; obj.Rate = 0; obj:Destroy()
                    elseif obj:IsA("Trail") or obj:IsA("Beam") then
                        obj.Enabled = false; obj:Destroy()
                    elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
                        obj.Enabled = false; obj.Brightness = 0; obj:Destroy()
                    elseif obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
                        obj:Destroy()
                    end
                end)
            end
        end)
    end
    
    -- Clean effects from a character (no material/shadow changes)
    local function cleanCharacterEffects(char)
        if not char then return end
        task.spawn(function()
            task.wait(0.3)
            pcall(function()
                for _, part in ipairs(char:GetDescendants()) do
                    pcall(function()
                        if part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Beam") then
                            part:Destroy()
                        elseif part:IsA("PointLight") or part:IsA("SpotLight") or part:IsA("SurfaceLight") then
                            part:Destroy()
                        elseif part:IsA("Fire") or part:IsA("Smoke") or part:IsA("Sparkles") then
                            part:Destroy()
                        end
                    end)
                end
            end)
        end)
    end
    
    function ANTILAG.Enable()
        if _G.ANTILAG_ACTIVE then return end
        _G.ANTILAG_ACTIVE = true
        
        -- Initial nuke of visual effects
        addAntilagThread(function()
            task.wait(0.5)
            nukeVisualEffects()
        end)
        
        -- Monitor for new visual effects and destroy them
        addAntilagConnection(workspace.DescendantAdded:Connect(function(obj)
            if not _G.ANTILAG_ACTIVE then return end
            pcall(function()
                -- Skip VanishHub beams (Beam to Base, Beam to Brainrot)
                if obj.Name and string.find(obj.Name, "VanishHub_") then return end
                
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or
                   obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or
                   obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
                    obj:Destroy()
                end
            end)
        end))
        
        -- Clean effects from all characters
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then cleanCharacterEffects(p.Character) end
            addAntilagConnection(p.CharacterAdded:Connect(function(char)
                if _G.ANTILAG_ACTIVE then cleanCharacterEffects(char) end
            end))
        end
        
        addAntilagConnection(Players.PlayerAdded:Connect(function(p)
            addAntilagConnection(p.CharacterAdded:Connect(function(char)
                if _G.ANTILAG_ACTIVE then cleanCharacterEffects(char) end
            end))
        end))
        
        -- Periodic memory cleanup
        addAntilagThread(function()
            while _G.ANTILAG_ACTIVE do
                task.wait(15)
                pcall(function() collectgarbage("collect") end)
            end
        end)
    end
    
    function ANTILAG.Disable()
        if not _G.ANTILAG_ACTIVE then return end
        _G.ANTILAG_ACTIVE = false
        
        -- Cancel threads
        for _, thread in ipairs(antilagThreads) do
            pcall(function() task.cancel(thread) end)
        end
        antilagThreads = {}
        
        -- Disconnect connections
        for _, conn in ipairs(antilagConnections) do
            pcall(function() conn:Disconnect() end)
        end
        antilagConnections = {}
    end
    
    _G.ANTILAG_OPTIMIZER = ANTILAG
end

