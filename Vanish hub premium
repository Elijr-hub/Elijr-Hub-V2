-- Grapple Speed (deferred to avoid variable limit)
task.defer(function()
    _G.GrappleFlyEnabled = false
    _G.GrappleFlySpeed = _G.GrappleFlySpeed or 100  -- Default speed
    local grappleFlyConn = nil
    local grappleFlyPart = nil  -- Invisible welded part
    local grappleHookTool = nil
    local grappleNet = nil
    
    -- Wait for toggle to be created in Tools section
    while not _G.ToggleGrappleSpeed do task.wait(0.1) end
    
    -- Get Net module once
    pcall(function()
        local packages = game:GetService("ReplicatedStorage"):WaitForChild("Packages", 5)
        if packages then
            grappleNet = require(packages:WaitForChild("Net", 5))
        end
    end)
    
    local function getGrappleHook()
        local backpack = player:FindFirstChild("Backpack")
        if not backpack then return nil end
        
        grappleHookTool = backpack:FindFirstChild("Grapple Hook") or backpack:FindFirstChild("GrappleHook")
        if not grappleHookTool then
            grappleHookTool = workspace:FindFirstChild("Grapple Hook") or workspace:FindFirstChild("GrappleHook")
            if grappleHookTool and grappleHookTool:IsA("Tool") then
                grappleHookTool.Parent = backpack
            end
        end
        return grappleHookTool
    end
    
    local function equipGrappleHook()
        if not getGrappleHook() then return false end
        local char = player.Character
        if not char then return false end
        
        local equipped = char:FindFirstChild("Grapple Hook") or char:FindFirstChild("GrappleHook")
        if equipped then
            grappleHookTool = equipped
            return true
        end
        
        if grappleHookTool then
            grappleHookTool.Parent = char
            return true
        end
        return false
    end
    
    local function startGrappleFly()
        if _G.GrappleFlyEnabled then return false end
        
        if not equipGrappleHook() then
            warn("[Vanish Hub] No Grapple Hook found!")
            return false
        end
        
        _G.GrappleFlyEnabled = true
        if _G.setGrappleSpeedState then _G.setGrappleSpeedState(true) end
        
        local bodyVel
        
        grappleFlyConn = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if not char then return end
            
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not hum or not root then return end
            
            -- Fire UseItem to keep grapple active
            if grappleNet then
                pcall(function()
                    grappleNet:RemoteEvent("UseItem"):FireServer(0.1)
                end)
            end
            
            -- Create invisible welded part
            if not grappleFlyPart or not grappleFlyPart.Parent then
                grappleFlyPart = Instance.new("Part")
                grappleFlyPart.Name = "GrappleFlyPart"
                grappleFlyPart.Size = Vector3.new(1, 1, 1)
                grappleFlyPart.Transparency = 1
                grappleFlyPart.Anchored = false
                grappleFlyPart.CanCollide = false
                grappleFlyPart.Massless = true
                grappleFlyPart.Parent = workspace
                
                local weld = Instance.new("Weld")
                weld.Part0 = root
                weld.Part1 = grappleFlyPart
                weld.C0 = CFrame.new(0, 0, 0)
                weld.Parent = grappleFlyPart
            end
            
            -- Create BodyVelocity on the welded part (horizontal only, gravity still works)
            if not bodyVel or not bodyVel.Parent then
                bodyVel = Instance.new("BodyVelocity")
                bodyVel.Name = "FlyVel"
                bodyVel.MaxForce = Vector3.new(math.huge, 0, math.huge)  -- No Y force, gravity works
                bodyVel.P = 2000
                bodyVel.Parent = grappleFlyPart
            end
            
            local dir = Vector3.new(0, 0, 0)
            local cam = workspace.CurrentCamera
            
            -- Horizontal movement only (flatten the vectors)
            local lookFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
            local rightFlat = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z).Unit
            local spd = _G.GrappleFlySpeed or 50
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                dir = dir + lookFlat * spd
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                dir = dir - lookFlat * spd
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                dir = dir - rightFlat * spd
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                dir = dir + rightFlat * spd
            end
            
            bodyVel.Velocity = dir
        end)
        
        return true
    end
    
    local function stopGrappleFly()
        _G.GrappleFlyEnabled = false
        if _G.setGrappleSpeedState then _G.setGrappleSpeedState(false) end
        
        if grappleFlyConn then
            grappleFlyConn:Disconnect()
            grappleFlyConn = nil
        end
        
        -- Clean up welded part
        if grappleFlyPart then
            grappleFlyPart:Destroy()
            grappleFlyPart = nil
        end
        
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
            
            -- Unequip the grapple tool (put back in backpack)
            local equippedTool = char:FindFirstChild("Grapple Hook") or char:FindFirstChild("GrappleHook")
            if equippedTool then
                local backpack = player:FindFirstChild("Backpack")
                if backpack then
                    equippedTool.Parent = backpack
                end
            end
        end
        
        -- Reset tool reference so it can be found fresh next time
        grappleHookTool = nil
        
    end
    
    -- Expose functions globally for keybind access
    _G.startGrappleFly = startGrappleFly
    _G.stopGrappleFly = stopGrappleFly
    
    -- Click handler using Tools section toggle
    _G.ToggleGrappleSpeed.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if _G.GrappleFlyEnabled then
            stopGrappleFly()
        else
            startGrappleFly()
        end
    end)
    
    -- Stop grapple speed on character death/reset
    player.CharacterRemoving:Connect(function()
        if _G.GrappleFlyEnabled then
            stopGrappleFly()
        end
    end)
end)

-- Anti Turret Feature (deferred to avoid variable limit)
task.defer(function()
    local SCALE_MULTIPLIER = 600 -- Huge invisible hitbox
    
    _G.AntiTurretEnabled = false
    local antiTurretConnection = nil
    local currentBat = nil
    local fakeHandle = nil
    local originalSize = nil
    local originalTransparency = nil
    
    local function setupBat(tool)
        local handle = tool:FindFirstChild("Handle")
        if not handle then return false end
        
        originalSize = handle.Size
        originalTransparency = handle.Transparency
        currentBat = tool
        
        -- Make handle huge but invisible
        handle.CanCollide = false
        handle.Size = originalSize * SCALE_MULTIPLIER
        handle.Transparency = 1
        
        -- Create fake visible handle at normal size
        if not fakeHandle or not fakeHandle.Parent then
            fakeHandle = handle:Clone()
            fakeHandle.Name = "FakeHandle"
            fakeHandle.Size = originalSize
            fakeHandle.Transparency = originalTransparency
            fakeHandle.CanCollide = false
            fakeHandle.Massless = true
            
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = handle
            weld.Part1 = fakeHandle
            weld.Parent = fakeHandle
            
            fakeHandle.Parent = tool
        end
        
        return true
    end
    
    local function resetBat()
        if currentBat then
            local handle = currentBat:FindFirstChild("Handle")
            if handle and originalSize then
                handle.Size = originalSize
                handle.Transparency = originalTransparency or 0
                handle.CanCollide = true
            end
            if fakeHandle then
                fakeHandle:Destroy()
                fakeHandle = nil
            end
        end
        currentBat = nil
        originalSize = nil
        originalTransparency = nil
    end
    
    local function findBat()
        local backpack = player:FindFirstChild("Backpack")
        local char = player.Character
        
        -- Check backpack
        if backpack then
            local bat = backpack:FindFirstChild("Bat")
            if bat and bat:IsA("Tool") then return bat end
        end
        
        -- Check character
        if char then
            local bat = char:FindFirstChild("Bat")
            if bat and bat:IsA("Tool") then return bat end
        end
        
        return nil
    end
    
    local function enableAntiTurret()
        local bat = findBat()
        if not bat then
            warn("[Vanish Hub] Bat not found!")
            return false
        end
        
        _G.AntiTurretEnabled = true
        
        -- Equip and setup bat
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(bat)
                task.wait(0.1)
                setupBat(bat)
            end
        end
        
        -- Continuously activate bat
        antiTurretConnection = RunService.Heartbeat:Connect(function()
            if not _G.AntiTurretEnabled then return end
            local char = player.Character
            if not char then return end
            
            local bat = char:FindFirstChild("Bat")
            if bat and bat:IsA("Tool") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    bat:Activate()
                end
            end
        end)
        
        return true
    end
    
    local function disableAntiTurret()
        _G.AntiTurretEnabled = false
        
        if antiTurretConnection then
            antiTurretConnection:Disconnect()
            antiTurretConnection = nil
        end
        
        resetBat()
        
        -- Unequip tool
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:UnequipTools()
            end
        end
        
    end
    
    -- Expose functions globally for keybind access
    _G.enableAntiTurret = enableAntiTurret
    _G.disableAntiTurret = disableAntiTurret
    
    -- Wait for toggle to be created in Protection section
    while not _G.ToggleAntiTurret do task.wait(0.1) end
    
    -- Expose toggle state function globally for keybind sync
    _G.setAntiTurretToggleState = _G.setAntiTurretState
    
    -- Click handler using Protection section toggle
    _G.ToggleAntiTurret.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if _G.AntiTurretEnabled then
            disableAntiTurret()
            if _G.setAntiTurretState then _G.setAntiTurretState(false) end
        else
            if enableAntiTurret() then
                if _G.setAntiTurretState then _G.setAntiTurretState(true) end
            end
        end
    end)
    
    -- Stop on character death
    player.CharacterRemoving:Connect(function()
        if _G.AntiTurretEnabled then
            disableAntiTurret()
            if _G.setAntiTurretState then _G.setAntiTurretState(false) end
        end
    end)
end)

-- Beam to Brainrot global state
_G.BeamToBrainrotEnabled = false

-- Beam to Brainrot logic (UI is in Base section)
task.spawn(function()
    task.wait(0.5)
    
    -- Wait for toggle to be created in Base section
    while not _G.ToggleBeamToBrainrot do task.wait(0.1) end
    
    -- Beam variables
    local beamPart = nil
    local beamObj = nil
    local startAttach = nil
    local endAttach = nil
    local updateLoop = nil
    
    local function cleanupBeam()
        pcall(function()
            if updateLoop then updateLoop:Disconnect() end
            if beamObj then beamObj:Destroy() end
            if startAttach then startAttach:Destroy() end
            if endAttach then endAttach:Destroy() end
            if beamPart then beamPart:Destroy() end
        end)
        beamObj, startAttach, endAttach, beamPart, updateLoop = nil, nil, nil, nil, nil
    end
    
    -- Load game modules for proper detection
    local BeamSynchronizer, BeamAnimalsShared
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local Packages = RS:WaitForChild("Packages", 3)
        local Shared = RS:WaitForChild("Shared", 3)
        if Packages then BeamSynchronizer = require(Packages:WaitForChild("Synchronizer", 2)) end
        if Shared then BeamAnimalsShared = require(Shared:WaitForChild("Animals", 2)) end
    end)
    
    local function findHighestBrainrot()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        
        -- Find my plot using Synchronizer
        local myPlot = nil
        for _, plot in pairs(plots:GetChildren()) do
            if BeamSynchronizer then
                pcall(function()
                    local channel = BeamSynchronizer:Get(plot.Name)
                    if channel then
                        local owner = channel:Get("Owner")
                        if owner then
                            if typeof(owner) == "Instance" and owner:IsA("Player") then
                                if owner.UserId == player.UserId then
                                    myPlot = plot.Name
                                end
                            elseif typeof(owner) == "table" and owner.UserId then
                                if owner.UserId == player.UserId then
                                    myPlot = plot.Name
                                end
                            end
                        end
                    end
                end)
            end
            if myPlot then break end
        end
        
        -- Fallback: check plot sign
        if not myPlot then
            for _, plot in pairs(plots:GetChildren()) do
                local sign = plot:FindFirstChild("PlotSign")
                if sign then
                    local gui = sign:FindFirstChildWhichIsA("SurfaceGui")
                    if gui then
                        local frame = gui:FindFirstChild("Frame")
                        if frame then
                            local lbl = frame:FindFirstChild("TextLabel")
                            if lbl and lbl.Text and lbl.Text:find(player.Name, 1, true) then
                                myPlot = plot.Name
                                break
                            end
                        end
                    end
                end
            end
        end
        
        local bestPos, bestVal = nil, 0
        
        -- Use Synchronizer API for accurate detection
        for _, plot in pairs(plots:GetChildren()) do
            if plot.Name ~= myPlot then
                pcall(function()
                    if BeamSynchronizer then
                        local channel = BeamSynchronizer:Get(plot.Name)
                        if channel then
                            local animalList = channel:Get("AnimalList")
                            if animalList then
                                for slot, animalData in pairs(animalList) do
                                    if type(animalData) == "table" and animalData.Index then
                                        local genValue = 0
                                        if BeamAnimalsShared then
                                            pcall(function()
                                                genValue = BeamAnimalsShared:GetGeneration(
                                                    animalData.Index,
                                                    animalData.Mutation,
                                                    animalData.Traits,
                                                    nil
                                                ) or 0
                                            end)
                                        end
                                        
                                        if genValue > bestVal then
                                            -- Get podium and check for fuse status (same as Instant Pickup)
                                            local podiums = plot:FindFirstChild("AnimalPodiums")
                                            if podiums then
                                                local pod = podiums:FindFirstChild(tostring(slot))
                                                if pod then
                                                    -- Check podium descendants for FUSE/FUSING/MACHINE text
                                                    local inFuse = false
                                                    for _, child in pairs(pod:GetDescendants()) do
                                                        if (child:IsA("TextLabel") or child:IsA("TextButton")) then
                                                            local textUpper = (child.Text or ""):upper()
                                                            if textUpper:find("FUSE") or textUpper:find("FUSING") or textUpper:find("MACHINE") then
                                                                inFuse = true
                                                                break
                                                            end
                                                        end
                                                    end
                                                    
                                                    if not inFuse then
                                                        bestVal = genValue
                                                        local podPos = pod:GetPivot().Position
                                                        bestPos = podPos + Vector3.new(0, 5, 0)
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end
        
        -- Fallback: use TextLabel method if API didn't find anything
        if not bestPos then
            for _, plot in pairs(plots:GetChildren()) do
                if plot.Name ~= myPlot then
                    local podiums = plot:FindFirstChild("AnimalPodiums")
                    if podiums then
                        for _, pod in pairs(podiums:GetChildren()) do
                            -- Check podium descendants for FUSE/FUSING/MACHINE (same as Instant Pickup)
                            local inFuse = false
                            for _, child in pairs(pod:GetDescendants()) do
                                if (child:IsA("TextLabel") or child:IsA("TextButton")) then
                                    local textUpper = (child.Text or ""):upper()
                                    if textUpper:find("FUSE") or textUpper:find("FUSING") or textUpper:find("MACHINE") then
                                        inFuse = true
                                        break
                                    end
                                end
                            end
                            
                            if inFuse then continue end
                            
                            for _, d in pairs(pod:GetDescendants()) do
                                if d:IsA("TextLabel") and d.Text:find("/") then
                                    local t = d.Text:gsub(",",""):gsub("%s",""):gsub("%$","")
                                    local n,s = t:match("([%d%.]+)([kKmMbB]?)%/s")
                                    if n then
                                        local v = tonumber(n) or 0
                                        s = (s or ""):lower()
                                        if s == "k" then v = v * 1e3
                                        elseif s == "m" then v = v * 1e6
                                        elseif s == "b" then v = v * 1e9 end
                                        if v > bestVal then
                                            bestVal = v
                                            local pos = pod:GetPivot().Position
                                            bestPos = pos + Vector3.new(0, 5, 0)  -- Raise 5 studs up
                                        end
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
        
        return bestPos
    end
    
    local function createBeam()
        cleanupBeam()
        
        -- Helper to setup beam parts
        local function setupBeamParts(hrp, targetPos)
            if beamPart then return end  -- Already exists
            
            beamPart = Instance.new("Part")
            beamPart.Anchored = true
            beamPart.CanCollide = false
            beamPart.Transparency = 1
            beamPart.Size = Vector3.new(1,1,1)
            beamPart.Position = targetPos
            beamPart.Parent = workspace.Terrain
            
            startAttach = Instance.new("Attachment")
            startAttach.Parent = hrp
            
            endAttach = Instance.new("Attachment")
            endAttach.Parent = beamPart
            
            beamObj = Instance.new("Beam")
            beamObj.Name = "VanishHub_BeamToBrainrot"
            beamObj.Attachment0 = startAttach
            beamObj.Attachment1 = endAttach
            beamObj.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50))
            beamObj.Transparency = NumberSequence.new(0.1)
            beamObj.Width0 = 0.3
            beamObj.Width1 = 0.3
            beamObj.FaceCamera = true
            beamObj.LightEmission = 1
            beamObj.Brightness = 3
            beamObj.Parent = workspace.Terrain
        end
        
        -- Update loop to track highest brainrot (ALWAYS runs)
        local lastUpdate = 0
        updateLoop = RunService.Heartbeat:Connect(function()
            if not _G.BeamToBrainrotEnabled then return end
            
            local now = tick()
            if now - lastUpdate < 1 then return end
            lastUpdate = now
            
            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local newPos = findHighestBrainrot()
            if newPos then
                -- Create beam if it doesn't exist
                if not beamPart then
                    setupBeamParts(hrp, newPos)
                end
                
                -- Show beam and update position
                if beamPart then
                    beamPart.Position = newPos
                end
                if beamObj then
                    beamObj.Enabled = true
                end
                
                -- Keep start attached to player
                if hrp and startAttach and startAttach.Parent ~= hrp then
                    pcall(function() startAttach.Parent = hrp end)
                end
            else
                -- No brainrots found - hide the beam
                if beamObj then
                    beamObj.Enabled = false
                end
            end
        end)
    end
    
    -- Recreate beam when player respawns
    player.CharacterAdded:Connect(function(newChar)
        if _G.BeamToBrainrotEnabled then
            task.wait(1)  -- Wait for character to fully load
            if _G.BeamToBrainrotEnabled then  -- Check again after wait
                createBeam()
            end
        end
    end)
    
    -- Click handler using Base section toggle
    _G.ToggleBeamToBrainrot.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        _G.BeamToBrainrotEnabled = not _G.BeamToBrainrotEnabled
        
        if _G.BeamToBrainrotEnabled then
            if _G.setBeamToBrainrotState then _G.setBeamToBrainrotState(true) end
            createBeam()
        else
            if _G.setBeamToBrainrotState then _G.setBeamToBrainrotState(false) end
            cleanupBeam()
        end
        
        -- Save config when toggled
        if _G.VanishHub_SaveConfig then
            _G.VanishHub_SaveConfig()
        end
    end)
    
    -- Check if should enable from config
    if _G.BeamToBrainrotFromConfig then
        task.wait(1)
        _G.BeamToBrainrotEnabled = true
        if _G.setBeamToBrainrotState then _G.setBeamToBrainrotState(true) end
        createBeam()
        _G.BeamToBrainrotFromConfig = false
    end
    
end)

