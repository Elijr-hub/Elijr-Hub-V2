    -- Clear brainrot list
    local function clearBrainrotList()
        for _, child in pairs(BrainrotsList:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end
    end
    
    -- Get all brainrots from a plot
    local function getBrainrotsFromPlot(plot)
        local brainrots = {}
        
        -- Try Synchronizer API first
        if ServerInfoSynchronizer and ServerInfoAnimalsShared then
            pcall(function()
                local channel = ServerInfoSynchronizer:Get(plot.Name)
                if channel then
                    local animalList = channel:Get("AnimalList")
                    if animalList then
                        for slot, animalData in pairs(animalList) do
                            if type(animalData) == "table" and animalData.Index then
                                local genValue = 0
                                pcall(function()
                                    genValue = ServerInfoAnimalsShared:GetGeneration(
                                        animalData.Index,
                                        animalData.Mutation,
                                        animalData.Traits,
                                        nil
                                    ) or 0
                                end)
                                
                                -- Name is directly in animalData.Index
                                local name = animalData.Index or ("Brainrot #" .. slot)
                                
                                -- Check if in fuse machine
                                local inFuse = false
                                local podiums = plot:FindFirstChild("AnimalPodiums")
                                if podiums then
                                    local pod = podiums:FindFirstChild(tostring(slot))
                                    if pod then
                                        for _, child in pairs(pod:GetDescendants()) do
                                            if (child:IsA("TextLabel") or child:IsA("TextButton")) then
                                                local textUpper = (child.Text or ""):upper()
                                                if textUpper:find("FUSE") or textUpper:find("FUSING") or textUpper:find("MACHINE") then
                                                    inFuse = true
                                                    break
                                                end
                                            end
                                        end
                                    end
                                end
                                
                                if not inFuse and genValue > 0 then
                                    table.insert(brainrots, {name = name, value = genValue, slot = slot})
                                end
                            end
                        end
                    end
                end
            end)
        end
        
        -- Fallback: parse TextLabels
        if #brainrots == 0 then
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if podiums then
                for _, pod in pairs(podiums:GetChildren()) do
                    local inFuse = false
                    local brainrotName = nil
                    local brainrotValue = 0
                    
                    for _, child in pairs(pod:GetDescendants()) do
                        if (child:IsA("TextLabel") or child:IsA("TextButton")) then
                            local textUpper = (child.Text or ""):upper()
                            if textUpper:find("FUSE") or textUpper:find("FUSING") or textUpper:find("MACHINE") then
                                inFuse = true
                                break
                            end
                        end
                    end
                    
                    if not inFuse then
                        -- Try to find name and value from text labels
                        for _, d in pairs(pod:GetDescendants()) do
                            if d:IsA("TextLabel") then
                                local txt = d.Text or ""
                                -- Check for M/S value
                                if txt:find("/") then
                                    local t = txt:gsub(",",""):gsub("%s",""):gsub("%$","")
                                    local n,s = t:match("([%d%.]+)([kKmMbB]?)%/s")
                                    if n then
                                        local v = tonumber(n) or 0
                                        s = (s or ""):lower()
                                        if s == "k" then v = v * 1e3
                                        elseif s == "m" then v = v * 1e6
                                        elseif s == "b" then v = v * 1e9 end
                                        brainrotValue = v
                                    end
                                -- Check for brainrot name (text without numbers/symbols that's not too short)
                                elseif #txt > 3 and not txt:match("^%d") and not txt:match("LEVEL") and not txt:match("GEN") then
                                    if not brainrotName and not txt:match("%$") and not txt:match("%%") then
                                        brainrotName = txt:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                                    end
                                end
                            end
                        end
                        
                        if brainrotValue > 0 then
                            table.insert(brainrots, {
                                name = brainrotName or ("Slot " .. pod.Name), 
                                value = brainrotValue, 
                                slot = pod.Name
                            })
                        end
                    end
                end
            end
        end
        
        -- Sort by value (highest first)
        table.sort(brainrots, function(a, b) return a.value > b.value end)
        return brainrots
    end
    
    -- Find best base and update UI
    local function updateServerInfo()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then
            OwnerLabel.Text = "Best Base Owner: ---"
            DistanceLabel.Text = "Distance to Base: ---"
            clearBrainrotList()
            return
        end
        
        -- Find my plot
        local myPlot = nil
        for _, plot in pairs(plots:GetChildren()) do
            if ServerInfoSynchronizer then
                pcall(function()
                    local channel = ServerInfoSynchronizer:Get(plot.Name)
                    if channel then
                        local owner = channel:Get("Owner")
                        if owner then
                            if typeof(owner) == "Instance" and owner:IsA("Player") then
                                if owner.UserId == player.UserId then myPlot = plot.Name end
                            elseif typeof(owner) == "table" and owner.UserId then
                                if owner.UserId == player.UserId then myPlot = plot.Name end
                            end
                        end
                    end
                end)
            end
            if myPlot then break end
        end
        
        -- Fallback: check plot sign
        if not myPlot then
            for _, plot in pairs(plots:GetChildren()) do
                local sign = plot:FindFirstChild("PlotSign")
                if sign then
                    local gui = sign:FindFirstChildWhichIsA("SurfaceGui")
                    if gui then
                        local frame = gui:FindFirstChild("Frame")
                        if frame then
                            local lbl = frame:FindFirstChild("TextLabel")
                            if lbl and lbl.Text and lbl.Text:find(player.Name, 1, true) then
                                myPlot = plot.Name
                                break
                            end
                        end
                    end
                end
            end
        end
        
        -- Find best base (highest total value, excluding my plot)
        local bestPlot = nil
        local bestPlotOwner = "Unknown"
        local bestPlotValue = 0
        local bestPlotBrainrots = {}
        
        for _, plot in pairs(plots:GetChildren()) do
            if plot.Name ~= myPlot then
                local brainrots = getBrainrotsFromPlot(plot)
                if #brainrots > 0 then
                    local highestVal = brainrots[1].value  -- Already sorted, first is highest
                    if highestVal > bestPlotValue then
                        bestPlotValue = highestVal
                        bestPlot = plot
                        bestPlotBrainrots = brainrots
                        
                        -- Get owner name
                        if ServerInfoSynchronizer then
                            pcall(function()
                                local channel = ServerInfoSynchronizer:Get(plot.Name)
                                if channel then
                                    local owner = channel:Get("Owner")
                                    if owner then
                                        if typeof(owner) == "Instance" and owner:IsA("Player") then
                                            bestPlotOwner = owner.Name
                                        elseif typeof(owner) == "table" and owner.Name then
                                            bestPlotOwner = owner.Name
                                        end
                                    end
                                end
                            end)
                        end
                        
                        -- Fallback: check plot sign
                        if bestPlotOwner == "Unknown" then
                            local sign = plot:FindFirstChild("PlotSign")
                            if sign then
                                local gui = sign:FindFirstChildWhichIsA("SurfaceGui")
                                if gui then
                                    local frame = gui:FindFirstChild("Frame")
                                    if frame then
                                        local lbl = frame:FindFirstChild("TextLabel")
                                        if lbl and lbl.Text then
                                            bestPlotOwner = lbl.Text:gsub("'s Base", ""):gsub("'s Plot", "")
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        
        -- Update UI
        if bestPlot then
            OwnerLabel.Text = "Best Base Owner: " .. bestPlotOwner
            
            -- Calculate distance
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local plotPos = bestPlot:GetPivot().Position
                    local dist = (hrp.Position - plotPos).Magnitude
                    DistanceLabel.Text = string.format("Distance to Base: %.0f studs", dist)
                else
                    DistanceLabel.Text = "Distance to Base: ---"
                end
            else
                DistanceLabel.Text = "Distance to Base: ---"
            end
            
            -- Update brainrot list
            clearBrainrotList()
            for i, brainrot in ipairs(bestPlotBrainrots) do
                createBrainrotRow(i, brainrot.name, brainrot.value)
            end
            
            -- Update canvas size
            BrainrotsList.CanvasSize = UDim2.new(0, 0, 0, #bestPlotBrainrots * 28 + 8)
        else
            OwnerLabel.Text = "Best Base Owner: ---"
            DistanceLabel.Text = "Distance to Base: ---"
            clearBrainrotList()
        end
    end
    
    -- Draggable header
    local dragging, dragStart, startPos
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = ServerInfoOuter.Position
        end
    end)
    Header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            -- Save current position for persistence (use current offset values)
            local currentPos = ServerInfoOuter.Position
            _G.ServerInfoPosX = currentPos.X.Offset
            _G.ServerInfoPosY = currentPos.Y.Offset
            _G.ServerInfoScaleX = currentPos.X.Scale
            _G.ServerInfoScaleY = currentPos.Y.Scale
            if _G.VanishHub_SaveConfig then _G.VanishHub_SaveConfig() end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            ServerInfoOuter.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    -- Track current best plot for real-time distance updates
    local currentBestPlot = nil
    
    -- Real-time distance update (like instant pickup bar)
    RunService.Heartbeat:Connect(function()
        if not ServerInfoOuter.Visible then return end
        if not currentBestPlot then return end
        
        pcall(function()
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and currentBestPlot.Parent then
                    local plotPos = currentBestPlot:GetPivot().Position
                    local dist = (hrp.Position - plotPos).Magnitude
                    DistanceLabel.Text = string.format("Distance to Base: %.0f studs", dist)
                end
            end
        end)
    end)
    
    -- Wrap updateServerInfo to track best plot
    local originalUpdate = updateServerInfo
    updateServerInfo = function()
        originalUpdate()
        -- Find and store the best plot reference for real-time updates
        local plots = workspace:FindFirstChild("Plots")
        if plots then
            local myPlot = nil
            for _, plot in pairs(plots:GetChildren()) do
                if ServerInfoSynchronizer then
                    pcall(function()
                        local channel = ServerInfoSynchronizer:Get(plot.Name)
                        if channel then
                            local owner = channel:Get("Owner")
                            if owner then
                                if typeof(owner) == "Instance" and owner:IsA("Player") then
                                    if owner.UserId == player.UserId then myPlot = plot.Name end
                                elseif typeof(owner) == "table" and owner.UserId then
                                    if owner.UserId == player.UserId then myPlot = plot.Name end
                                end
                            end
                        end
                    end)
                end
                if myPlot then break end
            end
            
            local bestVal = 0
            currentBestPlot = nil
            for _, plot in pairs(plots:GetChildren()) do
                if plot.Name ~= myPlot then
                    local brainrots = getBrainrotsFromPlot(plot)
                    if #brainrots > 0 and brainrots[1].value > bestVal then
                        bestVal = brainrots[1].value
                        currentBestPlot = plot
                    end
                end
            end
        end
    end
    
    -- Update loop (for brainrot list refresh)
    task.spawn(function()
        while true do
            task.wait(2)  -- Update every 2 seconds
            if ServerInfoOuter.Visible then
                pcall(updateServerInfo)
            end
        end
    end)
    
    -- Store references
    _G.ServerInfoOuter = ServerInfoOuter
    _G.ServerInfoVisible = false
    _G.UpdateServerInfo = updateServerInfo
    
    -- Add button to Actions section
    task.defer(function()
        while not _G.ActionsSectionBox do task.wait(0.1) end
        
        local serverInfoBtn = Instance.new("TextButton")
        serverInfoBtn.Name = "ServerInfoBtn"
        serverInfoBtn.Size = UDim2.new(1, -scaled(16), 0, scaled(28))
        serverInfoBtn.Position = UDim2.new(0, scaled(8), 0, scaled(132))
        serverInfoBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
        serverInfoBtn.BackgroundTransparency = 0.2
        serverInfoBtn.Text = "Server Information"
        serverInfoBtn.TextColor3 = Color3.fromRGB(220, 220, 225)
        serverInfoBtn.Font = Enum.Font.GothamMedium
        serverInfoBtn.TextSize = scaled(13)
        serverInfoBtn.ZIndex = 52
        serverInfoBtn.Parent = _G.ActionsSectionBox
        do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = serverInfoBtn end
        
        serverInfoBtn.MouseEnter:Connect(function()
            TweenService:Create(serverInfoBtn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(50, 55, 65)}):Play()
        end)
        serverInfoBtn.MouseLeave:Connect(function()
            TweenService:Create(serverInfoBtn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(35, 40, 50)}):Play()
        end)
        
        serverInfoBtn.MouseButton1Click:Connect(function()
            ServerInfoOuter.Visible = not ServerInfoOuter.Visible
            _G.ServerInfoVisible = ServerInfoOuter.Visible
            if ServerInfoOuter.Visible then
                pcall(updateServerInfo)
            end
            if _G.VanishHub_SaveConfig then _G.VanishHub_SaveConfig() end
        end)
        
        -- Expand Actions section to fit all buttons
        if _G.ActionsSectionBox then
            _G.ActionsSectionBox.Size = UDim2.new(1, -scaled(16), 0, scaled(168))
        end
    end)
end)

