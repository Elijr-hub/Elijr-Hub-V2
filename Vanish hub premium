-- Find plot model from any descendant
local function plotModelFrom(inst)
    local p = inst
    while p and p ~= workspace do
        if p.Parent and p.Parent.Name == "Plots" and p:IsA("Model") then 
            return p 
        end
        p = p.Parent
    end
end

-- Find the plot we're currently inside (larger search radius)
local function findCurrentPlot()
    if not hrp then return nil end
    
    local cf = hrp.CFrame
    local size = Vector3.new(100, 50, 100)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    
    local foundPlots = {}
    for _, part in ipairs(workspace:GetPartBoundsInBox(cf, size, params)) do
        local m = plotModelFrom(part)
        if m then
            foundPlots[m] = true
        end
    end
    
    local closest, closestDist = nil, math.huge
    for plot in pairs(foundPlots) do
        local pivot = plot:GetPivot().Position
        local dist = (pivot - hrp.Position).Magnitude
        if dist < closestDist then
            closest, closestDist = plot, dist
        end
    end
    
    return closest
end

-- Infer floor number from prompt text or attributes
local function inferFloor(pp, unlockRoot)
    local t = ((pp.ActionText or "").." "..(pp.ObjectText or "")):lower()
    if t:match("first") or t:match("1st") then return 1 end
    if t:match("second") or t:match("2nd") then return 2 end
    if t:match("third") or t:match("3rd") then return 3 end
    local cur = pp
    while cur and cur ~= unlockRoot do
        local f = cur:GetAttribute("Floor")
        if f ~= nil then return tonumber(f) end
        cur = cur.Parent
    end
end

-- Collect all unlock prompts from a plot
local function collectUnlockPrompts(plot)
    local unlockRoot = plot and plot:FindFirstChild("Unlock", true)
    if not unlockRoot then return {} end
    
    local found = {}
    for _, pp in ipairs(unlockRoot:GetDescendants()) do
        if pp:IsA("ProximityPrompt") then
            local at = (pp.ActionText or ""):lower()
            local ot = (pp.ObjectText or ""):lower()
            if at:match("unlock") or ot:match("unlock") then
                local n = inferFloor(pp, unlockRoot)
                if n and n >= 1 and n <= 3 then
                    found[n] = pp
                end
            end
        end
    end
    return found
end

-- Fire proximity prompt from anywhere
local function firePrompt(prompt)
    if not prompt or not prompt.Parent then
        return false
    end
    
    -- Method 1: fireproximityprompt (most common exploit function)
    if fireproximityprompt then
        fireproximityprompt(prompt)
        return true
    end
    
    -- Method 2: Try different variations
    local fire = getfenv().fireproximityprompt or getgenv and getgenv().fireproximityprompt
    if fire then
        fire(prompt)
        return true
    end
    
    -- Method 3: Direct manipulation
    local oldDist = prompt.MaxActivationDistance
    local oldLOS = prompt.RequiresLineOfSight
    local oldHold = prompt.HoldDuration
    
    pcall(function()
        prompt.MaxActivationDistance = 9999
        prompt.RequiresLineOfSight = false
        prompt.HoldDuration = 0
        prompt.Enabled = true
    end)
    
    local success = pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end)
    
    task.delay(0.1, function()
        pcall(function()
            prompt.MaxActivationDistance = oldDist
            prompt.RequiresLineOfSight = oldLOS
            prompt.HoldDuration = oldHold
        end)
    end)
    
    return success
end

-- State tracking for base unlock
local unlockState = { plot = nil, prompts = {}, lastUpdate = 0 }

-- Update state periodically
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if now - unlockState.lastUpdate > 0.5 then
        local p = findCurrentPlot()
        if p ~= unlockState.plot then
            unlockState.plot = p
            unlockState.prompts = {}
        end
        if unlockState.plot then
            unlockState.prompts = collectUnlockPrompts(unlockState.plot)
        end
        unlockState.lastUpdate = now
    end
end)

-- Main unlock function
local function unlockFloor(floorNum)
    if unlockState.plot then
        unlockState.prompts = collectUnlockPrompts(unlockState.plot)
    else
        unlockState.plot = findCurrentPlot()
        if unlockState.plot then
            unlockState.prompts = collectUnlockPrompts(unlockState.plot)
        end
    end
    
    local prompt = unlockState.prompts[floorNum]
    if not prompt then
        warn(string.format("[Vanish Hub] Floor %d prompt not found - make sure you're inside a base!", floorNum))
        return false
    end
    
    local success = firePrompt(prompt)
    return success
end

