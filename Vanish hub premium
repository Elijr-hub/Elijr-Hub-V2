local xrayPlotConnections = {}
local xrayOriginalTransparencies = {}
local plots = workspace:FindFirstChild('Plots')

local function setXRayTransparency(obj)
    if not xrayBases then return end
    if obj:IsA('BasePart') then
        if not xrayOriginalTransparencies[obj] then
            xrayOriginalTransparencies[obj] = obj.Transparency
        end
        if obj.Name == 'Hitbox' then
            obj.Transparency = 1
        elseif obj.Color == Color3.fromRGB(0, 162, 255) or obj.Color == Color3.fromRGB(0, 170, 255) or obj.BrickColor == BrickColor.new("Bright blue") then
            obj.Transparency = 1
        elseif obj.Size.X < 1 and obj.Size.Y < 1 and obj.Size.Z < 1 then
            obj.Transparency = 1
        else
            obj.Transparency = 0.8
        end
    end
end

local function restoreXRayTransparency(obj)
    if xrayOriginalTransparencies[obj] then
        obj.Transparency = xrayOriginalTransparencies[obj]
        xrayOriginalTransparencies[obj] = nil
    end
end

local function processXRayPlot(plot)
    if not xrayBases then return end
    task.wait(0.1)
    
    local decorations = plot:FindFirstChild('Decorations')
    local animals = plot:FindFirstChild('AnimalPodiums')

    if decorations then
        for _, obj in ipairs(decorations:GetDescendants()) do
            setXRayTransparency(obj)
        end
        table.insert(xrayPlotConnections, decorations.DescendantAdded:Connect(function(newObj)
            task.wait(0.05)
            setXRayTransparency(newObj)
        end))
        table.insert(xrayPlotConnections, decorations.DescendantRemoving:Connect(function(removedObj)
            if xrayOriginalTransparencies[removedObj] then
                xrayOriginalTransparencies[removedObj] = nil
            end
        end))
    end

    if animals then
        for _, obj in ipairs(animals:GetDescendants()) do
            setXRayTransparency(obj)
        end
        table.insert(xrayPlotConnections, animals.DescendantAdded:Connect(function(newObj)
            task.wait(0.05)
            setXRayTransparency(newObj)
        end))
        table.insert(xrayPlotConnections, animals.DescendantRemoving:Connect(function(removedObj)
            if xrayOriginalTransparencies[removedObj] then
                xrayOriginalTransparencies[removedObj] = nil
            end
        end))
    end
end

local function refreshXRayPlots()
    if not xrayBases or not plots then return end
    
    for _, connection in ipairs(xrayPlotConnections) do
        if connection then connection:Disconnect() end
    end
    xrayPlotConnections = {}
    
    for _, plot in ipairs(plots:GetChildren()) do
        if plot and plot:IsA("Model") then
            processXRayPlot(plot)
        end
    end
    
    if plots then
        table.insert(xrayPlotConnections, plots.ChildAdded:Connect(function(newPlot)
            if newPlot and newPlot:IsA("Model") then
                task.spawn(function()
                    task.wait(1)
                    if xrayBases then
                        processXRayPlot(newPlot)
                    end
                end)
            end
        end))
        
        table.insert(xrayPlotConnections, plots.ChildRemoved:Connect(function(removedPlot)
            if removedPlot then
                local decorations = removedPlot:FindFirstChild('Decorations')
