_G.AntiTrap_Enabled = false

local function toggleAntiTrap(enabled)
    local AT = getgenv().AntiTrap or {}
    getgenv().AntiTrap = AT
    if AT.conn then
        pcall(function() AT.conn:Disconnect() end)
        AT.conn = nil
    end
    AT.enabled = enabled and true or false

    AT.cleanup = AT.cleanup or function()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA('BasePart') and obj.Name == 'TrapBlockCover' then
                pcall(function() obj:Destroy() end)
            end
        end
    end

    if not AT.enabled then
        AT.cleanup()
        return
    end

    AT.trapName = AT.trapName or 'Trap'
    AT.blockHeight = AT.blockHeight or 1.5
    AT.scanInterval = AT.scanInterval or 0.5
    AT.lastScanTime = AT.lastScanTime or 0

    AT.createBlock = AT.createBlock or function(trapModel)
        if not trapModel or not trapModel:IsA('Model') then return end
        local primary = trapModel.PrimaryPart or trapModel:FindFirstChildWhichIsA('BasePart')
        if not primary or not primary:IsDescendantOf(workspace) then return end
        if trapModel:FindFirstChild('TrapBlockCover') then return end

        local block = Instance.new('Part')
        block.Name = 'TrapBlockCover'
        block.Anchored = true
        block.Transparency = 1
        block.CastShadow = false
        block.CanCollide = true
        block.Size = Vector3.new(
            primary.Size.X + 2,
            AT.blockHeight,
            primary.Size.Z + 2
        )

        local yPos = primary.Position.Y + (primary.Size.Y / 2) + (AT.blockHeight / 2)
        block.CFrame = CFrame.new(primary.Position.X, yPos, primary.Position.Z)
        block.Parent = trapModel
    end

    AT.conn = RunService.Heartbeat:Connect(function()
        local currentTime = tick()
        if currentTime - (AT.lastScanTime or 0) >= (AT.scanInterval or 0.5) then
            AT.lastScanTime = currentTime
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA('Model') and obj.Name == (AT.trapName or 'Trap') then
                    local existing = obj:FindFirstChild('TrapBlockCover')
                    if not existing then
                        AT.createBlock(obj)
                    end
                end
            end
        end
    end)
end

