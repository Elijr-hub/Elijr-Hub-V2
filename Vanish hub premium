            workspace.Terrain.WaterTransparency = 1
            workspace.Terrain.Decoration = false
        end)
        
        -- Nuke all visual effects
        addOptimizerThread(function()
            task.wait(1)
            nukeVisualEffects()
        end)
        
        -- Monitor for new visual effects and destroy them
        addOptimizerConnection(workspace.DescendantAdded:Connect(function(obj)
            if not _G.OptimizePerf_Enabled then return end
            pcall(function()
                -- Skip VanishHub beams (Beam to Base, Beam to Brainrot)
                if obj.Name and string.find(obj.Name, "VanishHub_") then return end
                
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or
                   obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or
                   obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
                    obj:Destroy()
                elseif obj:IsA("BasePart") then
                    obj.CastShadow = false
                    obj.Material = Enum.Material.Plastic
                end
            end)
        end))
        
        -- Optimize all player characters
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                optimizeCharacter(plr.Character)
            end
            addOptimizerConnection(plr.CharacterAdded:Connect(function(char)
                if _G.OptimizePerf_Enabled then
                    optimizeCharacter(char)
                end
            end))
        end
        
        addOptimizerConnection(Players.PlayerAdded:Connect(function(plr)
            addOptimizerConnection(plr.CharacterAdded:Connect(function(char)
                if _G.OptimizePerf_Enabled then
                    optimizeCharacter(char)
                end
            end))
        end))
        
        -- Memory cleanup every 15 seconds
        addOptimizerThread(function()
            while _G.OptimizePerf_Enabled do
                task.wait(15)
                pcall(function()
                    collectgarbage("collect")
                end)
            end
        end)
        
        -- FPS Uncap
        pcall(function() setfpscap(999) end)
        
        -- Camera optimization - lower render distance
        pcall(function()
            local camera = workspace.CurrentCamera
            if camera then
                -- Store original for restoration
                originalSettings.cameraFarPlane = camera.CameraSubject and 10000 or nil
                -- Set closer clip plane (objects beyond won't render)
                camera.FieldOfView = 70
            end
        end)
        
        -- Distant player management loop
        addOptimizerThread(function()
            while _G.OptimizePerf_Enabled do
                task.wait(0.5)  -- Check every 0.5 seconds
                
                pcall(function()
                    local localPlayer = Players.LocalPlayer
                    if not localPlayer or not localPlayer.Character then return end
                    local localRoot = localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not localRoot then return end
                    local localPos = localRoot.Position
                    
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= localPlayer and plr.Character then
                            local char = plr.Character
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if root then
                                local distance = (root.Position - localPos).Magnitude
                                local humanoid = char:FindFirstChildOfClass("Humanoid")
                                
                                -- Hide very distant players
                                if distance > HIDE_DISTANCE then
                                    if not hiddenPlayers[plr] then
                                        hiddenPlayers[plr] = {}
                                        for _, part in ipairs(char:GetDescendants()) do
                                            if part:IsA("BasePart") then
                                                hiddenPlayers[plr][part] = part.Transparency
                                                part.Transparency = 1
                                            end
                                        end
                                    end
                                else
                                    -- Restore if they come back in range
                                    if hiddenPlayers[plr] then
                                        for part, originalTransparency in pairs(hiddenPlayers[plr]) do
                                            if part and part.Parent then
                                                part.Transparency = originalTransparency
                                            end
                                        end
                                        hiddenPlayers[plr] = nil
                                    end
                                end
                                
                                -- Stop animations for medium-distant players
                                if distance > ANIM_STOP_DISTANCE and humanoid then
                                    stopCharacterAnimations(char)
                                end
                                
                                -- Optimize humanoid states for all other players
                                if humanoid then
                                    optimizeHumanoid(humanoid)
                                end
                            end
                        end
                    end
                end)
            end
            
            -- Cleanup: restore all hidden players when optimizer disabled
            for plr, parts in pairs(hiddenPlayers) do
                for part, originalTransparency in pairs(parts) do
                    if part and part.Parent then
                        pcall(function() part.Transparency = originalTransparency end)
                    end
                end
            end
            hiddenPlayers = {}
        end)
        
        -- Disable terrain grass rendering
        pcall(function()
            workspace.Terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(76, 76, 76))
            workspace.Terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(76, 76, 76))
        end)
        
    end
    
    local function disableOptimize()
        _G.OptimizePerf_Enabled = false
        optBtn.Text = "Optimize Performance: OFF"
        optBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        -- Restore all hidden players first
        for plr, parts in pairs(hiddenPlayers) do
            for part, originalTransparency in pairs(parts) do
                if part and part.Parent then
                    pcall(function() part.Transparency = originalTransparency end)
                end
            end
        end
        hiddenPlayers = {}
        
        -- Re-enable animations on all players
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                pcall(function()
                    local animate = plr.Character:FindFirstChild("Animate")
                    if animate then
                        animate.Disabled = false
                    end
                end)
            end
        end
        
        -- Cancel all threads
        for _, thread in ipairs(optimizerThreads) do
            pcall(function() task.cancel(thread) end)
        end
        optimizerThreads = {}
        
        -- Disconnect all connections
        for _, conn in ipairs(optimizerConnections) do
            pcall(function() conn:Disconnect() end)
        end
        optimizerConnections = {}
        
        -- Restore original settings
        pcall(function()
            workspace.StreamingEnabled = originalSettings.streamingEnabled or true
            workspace.StreamingMinRadius = originalSettings.streamingMinRadius or 64
            workspace.StreamingTargetRadius = originalSettings.streamingTargetRadius or 1024
            
            settings().Rendering.QualityLevel = originalSettings.qualityLevel or Enum.QualityLevel.Automatic
            settings().Rendering.MeshPartDetailLevel = originalSettings.meshPartDetailLevel or Enum.MeshPartDetailLevel.DistanceBased
            
            local Lighting = game:GetService("Lighting")
            Lighting.GlobalShadows = originalSettings.globalShadows ~= false
            Lighting.Brightness = originalSettings.brightness or 1
            Lighting.FogEnd = originalSettings.fogEnd or 100000
            Lighting.Technology = originalSettings.technology or Enum.Technology.ShadowMap
            Lighting.EnvironmentDiffuseScale = originalSettings.environmentDiffuseScale or 1
            Lighting.EnvironmentSpecularScale = originalSettings.environmentSpecularScale or 1
            
            workspace.Terrain.WaterWaveSize = originalSettings.waterWaveSize or 0.15
            workspace.Terrain.WaterWaveSpeed = originalSettings.waterWaveSpeed or 10
            workspace.Terrain.WaterReflectance = originalSettings.waterReflectance or 1
            workspace.Terrain.WaterTransparency = originalSettings.waterTransparency or 0.3
            workspace.Terrain.Decoration = originalSettings.decoration ~= false
        end)
        
    end
    
    _G.EnableOptimizePerf = enableOptimize
    _G.DisableOptimizePerf = disableOptimize
    
    -- Check saved config for optimize
    pcall(function()
        local HttpService = game:GetService("HttpService")
        if isfile and isfile("VanishHubConfig.json") then
            local data = readfile("VanishHubConfig.json")
            local config = HttpService:JSONDecode(data)
            if config.optimizePerf then
                task.wait(0.5)
                enableOptimize()
            end
        end
    end)
    
    optBtn.MouseButton1Click:Connect(function()
        if not _G.OptimizePerf_Enabled then
            enableOptimize()
        else
            disableOptimize()
        end
    end)
end)

-- Anti Bee System with Control Protection
task.defer(function()
    local antiBeeControlsProtected = false
    local antiBeeOriginalMoveFunction = nil
    local antiBeeProtectedMoveFunction = nil
    local antiBeeControlCheckConn = nil
    local antiBeeControls = nil
    
    local BAD_LIGHTING_NAMES = {
        Blue = true,
        DiscoEffect = true,
        BeeBlur = true,
        ColorCorrection = true,
    }
    
    local function antiBeeNukeEffect(obj)
        if not obj or not obj.Parent then return end
        if BAD_LIGHTING_NAMES[obj.Name] or obj:IsA("BlurEffect") or obj:IsA("ColorCorrectionEffect") then
            pcall(function() obj:Destroy() end)
        end
    end
    
    local function antiBeeProtectControls()
        if antiBeeControlsProtected then return end
        
        local success = pcall(function()
            local PlayerScripts = player:FindFirstChild("PlayerScripts")
            if not PlayerScripts then return end
            
            local PlayerModule = PlayerScripts:FindFirstChild("PlayerModule")
            if not PlayerModule then return end
            
            local requiredModule = require(PlayerModule)
            if not requiredModule then return end
            
            antiBeeControls = requiredModule:GetControls()
            if not antiBeeControls then return end
            
            -- Store original move function
            if not antiBeeOriginalMoveFunction and antiBeeControls.moveFunction then
                antiBeeOriginalMoveFunction = antiBeeControls.moveFunction
            end
            
            if not antiBeeOriginalMoveFunction then return end
            
            -- Create protected wrapper that prevents control inversion
            antiBeeProtectedMoveFunction = function(self, moveVector, relativeToCamera)
                if antiBeeOriginalMoveFunction then
                    antiBeeOriginalMoveFunction(self, moveVector, relativeToCamera)
                end
            end
            
            -- Set protected function
            antiBeeControls.moveFunction = antiBeeProtectedMoveFunction
            antiBeeControlsProtected = true
            
            -- Monitor for control hijacking
            if antiBeeControlCheckConn then
                antiBeeControlCheckConn:Disconnect()
            end
            antiBeeControlCheckConn = RunService.Heartbeat:Connect(function()
                if not _G.AntiBee_Enabled then return end
                if not antiBeeControls then return end
                
                -- Restore controls if they've been modified
                if antiBeeControls.moveFunction ~= antiBeeProtectedMoveFunction then
                    antiBeeControls.moveFunction = antiBeeProtectedMoveFunction
                end
            end)
        end)
    end
    
    local function antiBeeRestoreControls()
        if not antiBeeControlsProtected then return end
        
        pcall(function()
            if antiBeeControls and antiBeeOriginalMoveFunction then
                antiBeeControls.moveFunction = antiBeeOriginalMoveFunction
            end
            antiBeeControlsProtected = false
        end)
        
        if antiBeeControlCheckConn then
            antiBeeControlCheckConn:Disconnect()
            antiBeeControlCheckConn = nil
        end
    end
    
    local function antiBeeBlockBuzzing()
        pcall(function()
            local PlayerScripts = player:FindFirstChild("PlayerScripts")
            if not PlayerScripts then return end
            
            local beeScript = PlayerScripts:FindFirstChild("Bee", true)
            if beeScript then
                local buzzing = beeScript:FindFirstChild("Buzzing")
                if buzzing and buzzing:IsA("Sound") then
                    buzzing:Stop()
                    buzzing.Volume = 0
                end
            end
        end)
    end
    
    -- Anti Bee Effects Loop
task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AntiBee_Enabled then
            pcall(function()
                    -- Remove bad lighting effects
                local Lighting = game:GetService("Lighting")
                    for _, v in pairs(Lighting:GetDescendants()) do
                        antiBeeNukeEffect(v)
                    end
                    
                    -- Block buzzing sound
                    antiBeeBlockBuzzing()
                
                    -- Stop jumpscare sounds
                if player.Character then
                    for _, s in pairs(player.Character:GetDescendants()) do
                        if s:IsA("Sound") and s.Playing and s.Volume > 0.8 then
                            s:Stop()
                        end
                    end
                    end
                end)
            end
        end
    end)
    
    -- Anti Bee FOV Lock
    task.spawn(function()
        while true do
            task.wait(0.05)
            if _G.AntiBee_Enabled then
                pcall(function()
                    local cam = workspace.CurrentCamera
                    if cam and cam.FieldOfView ~= 70 then
                        cam.FieldOfView = 70
                    end
            end)
        end
    end
    end)
    
    -- Monitor Anti Bee state for control protection
    task.spawn(function()
        local wasEnabled = false
        while true do
            task.wait(0.2)
            if _G.AntiBee_Enabled and not wasEnabled then
                antiBeeProtectControls()
                wasEnabled = true
            elseif not _G.AntiBee_Enabled and wasEnabled then
                antiBeeRestoreControls()
                wasEnabled = false
            end
        end
    end)
    
    -- Watch for new lighting effects
    game:GetService("Lighting").DescendantAdded:Connect(function(obj)
        if _G.AntiBee_Enabled then
            task.wait()
            antiBeeNukeEffect(obj)
        end
    end)
end)

