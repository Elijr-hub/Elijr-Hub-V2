-- Smooth scrolling for Tab2, Tab3 and Tab4 (override default harsh scrolling)
task.defer(function()
    local SCROLL_AMOUNT = 15 -- Very small scroll per tick
    
    -- Mobile has no mouse wheel; keep Roblox's native touch scrolling.
    if IS_MOBILE then
        Tab1Content.ScrollingEnabled = true
        Tab2Content.ScrollingEnabled = true
        Tab3Content.ScrollingEnabled = true
        Tab4Content.ScrollingEnabled = true
        Tab1Content.Active = true
        Tab2Content.Active = true
        Tab3Content.Active = true
        Tab4Content.Active = true
        return
    end
    
    -- Disable default scrolling by setting ScrollingEnabled to false and handling manually
    Tab2Content.ScrollingEnabled = false
    Tab3Content.ScrollingEnabled = false
    Tab4Content.ScrollingEnabled = false
    
    local function setupSmoothScroll(scrollFrame)
        pcall(function()
            scrollFrame.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseWheel then
                    local currentPos = scrollFrame.CanvasPosition.Y
                    local maxScroll = math.max(0, scrollFrame.AbsoluteCanvasSize.Y - scrollFrame.AbsoluteSize.Y)
                    local newPos = currentPos - (input.Position.Z * SCROLL_AMOUNT)
                    newPos = math.clamp(newPos, 0, maxScroll)
                    scrollFrame.CanvasPosition = Vector2.new(0, newPos)
                end
            end)
        end)
    end
    
    setupSmoothScroll(Tab2Content)
    setupSmoothScroll(Tab3Content)
    setupSmoothScroll(Tab4Content)
end)

