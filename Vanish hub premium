    -- Mobile: smaller panel, centered on screen
    -- PC: larger panel, bottom-right position
    local panelWidth = IS_MOBILE and scaled(280) or scaled(340)
    local panelHeight = IS_MOBILE and scaled(320) or scaled(400)
    
