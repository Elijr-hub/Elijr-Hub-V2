        isInRange = false,
        targetName = nil
    }
    
    -- Update loop for the progress bar
    local pickupBarConn = nil
    
    pickupBarConn = RunService.Heartbeat:Connect(function()
        local isActive = _G.InstantPickupRarestEnabled or _G.InstantPickupNearestEnabled
        local barData = _G.InstantPickupBar
        
        -- Show/hide bar based on mode AND steal bar toggle
        local shouldShow = isActive and (_G.StealBarEnabled ~= false)
        if shouldShow and not pickupBarOuter.Visible then
            pickupBarOuter.Visible = true
        elseif not shouldShow and pickupBarOuter.Visible then
            pickupBarOuter.Visible = false
            progressFill.Size = UDim2.new(0, 0, 1, 0)
            progressText.Text = "0%"
            barData.stealStartTime = nil
            barData.isInRange = false
            return
        end
        
        if not isActive then return end
        
        -- Get current target and calculate progress
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            progressFill.Size = UDim2.new(0, 0, 1, 0)
            progressText.Text = "Scanning..."
            barData.stealStartTime = nil
            barData.isInRange = false
            return
        end
        
        -- Helper function to get animal position from plot/slot
        local function getAnimalPos(animalData)
            if not animalData then return nil end
            local plots = workspace:FindFirstChild("Plots")
            if not plots then return nil end
            local plot = plots:FindFirstChild(animalData.plot)
            if not plot then return nil end
            local podiums = plot:FindFirstChild("AnimalPodiums")
            if not podiums then return nil end
            local podium = podiums:FindFirstChild(animalData.slot)
            if not podium then return nil end
            return podium:GetPivot().Position
        end
        
        -- Get my plot name (robust detection)
        local myPlotName = nil
        pcall(function()
            -- Try attribute first
            myPlotName = player:GetAttribute("Plot")
        end)
        
        -- Helper to check if a plot is mine
        local function isMyPlot(plotName)
            if myPlotName and plotName == myPlotName then return true end
            
            -- Also check PlotSign for YourBase
            local plots = workspace:FindFirstChild("Plots")
            if plots then
                local plot = plots:FindFirstChild(plotName)
                if plot then
                    local sign = plot:FindFirstChild("PlotSign")
                    if sign then
                        local yourBase = sign:FindFirstChild("YourBase")
                        if yourBase and yourBase.Enabled == true then
                            return true
                        end
                    end
                end
            end
            return false
        end
        
        -- Find target animal from cache
        local targetAnimal = nil
        local targetPos = nil
        local allAnimals = _G.allAnimalsCache or {}
        
        if _G.InstantPickupRarestEnabled then
            -- Get rarest (highest value) that isn't mine
            local highest = nil
            for _, data in pairs(allAnimals) do
                if isMyPlot(data.plot) then continue end
                if not highest or data.genValue > highest.genValue then
                    highest = data
                end
            end
            targetAnimal = highest
        else
            -- Get nearest that isn't mine
            local nearest = nil
            local nearestDist = math.huge
            for _, data in pairs(allAnimals) do
                if isMyPlot(data.plot) then continue end
                local pos = getAnimalPos(data)
                if pos then
                    local dist = (hrp.Position - pos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = data
                    end
                end
            end
            targetAnimal = nearest
        end
        
        -- Get target position
        if targetAnimal then
            targetPos = getAnimalPos(targetAnimal)
        end
        
        if not targetAnimal or not targetPos then
            progressFill.Size = UDim2.new(0, 0, 1, 0)
            progressText.Text = "No Target"
            progressFill.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            modeLabel.Text = "INSTANT PICKUP"
            barData.stealStartTime = nil
            barData.isInRange = false
            return
        end
        
        -- Update target name in label
        local targetName = targetAnimal.name or "Unknown"
        if _G.InstantPickupRarestEnabled then
            modeLabel.Text = "RAREST: " .. targetName
        else
            modeLabel.Text = "NEAREST: " .. targetName
        end
        
        -- Calculate distance
        local distance = (hrp.Position - targetPos).Magnitude
        local stealRange = _G.PreFireDistance or 20 -- User configurable pre-fire distance
        
        -- Check if in steal range
        local inRange = distance <= stealRange
        
        -- Smooth color lerp function
        local function lerpColor(c1, c2, t)
            return Color3.new(
                c1.R + (c2.R - c1.R) * t,
                c1.G + (c2.G - c1.G) * t,
                c1.B + (c2.B - c1.B) * t
            )
        end
        
        if inRange then
            -- We're in range - start or continue the steal timer
            if not barData.isInRange then
                barData.stealStartTime = tick()
                barData.isInRange = true
            end
            
            -- Calculate progress based on time elapsed (looping every 1.3 seconds)
            local elapsed = tick() - barData.stealStartTime
            local cycleTime = elapsed % barData.stealDuration
            local progress = (cycleTime / barData.stealDuration) * 100
            
            -- Smooth bar animation
            local targetSize = progress / 100
            local currentSize = progressFill.Size.X.Scale
            local smoothSize = currentSize + (targetSize - currentSize) * 0.25
            progressFill.Size = UDim2.new(smoothSize, 0, 1, 0)
            progressText.Text = math.floor(progress) .. "%"
            
            -- Smooth color transitions based on progress (vibrant colors)
            local targetColor
            if progress >= 90 then
                -- Pulse between bright green and cyan at the end
                local pulse = (math.sin(tick() * 12) + 1) / 2
                targetColor = lerpColor(
                    Color3.fromRGB(0, 255, 130),
                    Color3.fromRGB(80, 255, 200),
                    pulse
                )
            elseif progress >= 70 then
                -- Transition to vibrant yellow-green
                local t = (progress - 70) / 20
                targetColor = lerpColor(
                    Color3.fromRGB(255, 220, 0),
                    Color3.fromRGB(50, 255, 100),
                    t
                )
            elseif progress >= 40 then
                -- Transition to vibrant orange/yellow
                local t = (progress - 40) / 30
                targetColor = lerpColor(
                    Color3.fromRGB(0, 200, 255),
                    Color3.fromRGB(255, 220, 0),
                    t
                )
            else
                -- Vibrant cyan blue
                targetColor = Color3.fromRGB(0, 200, 255)
            end
            
            -- Smooth color transition
            currentFillColor = lerpColor(currentFillColor, targetColor, 0.15)
            progressFill.BackgroundColor3 = currentFillColor
            
            -- Update label color to match (subtle)
            modeLabel.TextColor3 = lerpColor(COLOR_TEXT_DIM, currentFillColor, 0.3)
        else
            -- Not in range - reset with smooth fade
            barData.stealStartTime = nil
            barData.isInRange = false
            
            local currentSize = progressFill.Size.X.Scale
            local smoothSize = currentSize * 0.85
            if smoothSize < 0.01 then smoothSize = 0 end
            progressFill.Size = UDim2.new(smoothSize, 0, 1, 0)
            
            progressText.Text = math.floor(distance) .. " studs"
            
            -- Fade to gray
            local grayColor = Color3.fromRGB(70, 75, 85)
            currentFillColor = lerpColor(currentFillColor, grayColor, 0.1)
            progressFill.BackgroundColor3 = currentFillColor
            modeLabel.TextColor3 = COLOR_TEXT_DIM
        end
    end)
end)

