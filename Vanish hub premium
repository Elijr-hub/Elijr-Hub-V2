-- ESP loop using ORIGINAL detection method
_G.startBrainrotESPLoop = function()
    if _G.BrainrotESPLoopRunning then return end
    _G.BrainrotESPLoopRunning = true
    
    task.spawn(function()
        local Plots = workspace:FindFirstChild("Plots") or workspace:WaitForChild("Plots", 1)
        if not Plots then return end
        local CoreGui = game:GetService("CoreGui")
        
        -- Clear any stale cache
        _G._lastESPDebug = nil
        
        -- Function to find my plot (same method as Beam to Brainrot)
        local function findMyPlot()
            local lp = game:GetService("Players").LocalPlayer
            local foundPlot = nil
            
            -- Try Synchronizer API first
            for _, plot in pairs(Plots:GetChildren()) do
                if foundPlot then break end
                pcall(function()
                    if ESP_Sync then
                        local channel = ESP_Sync:Get(plot.Name)
                        if channel then
                            local owner = channel:Get("Owner")
                            if owner then
                                if typeof(owner) == "Instance" and owner:IsA("Player") then
                                    if owner.UserId == lp.UserId then
                                        foundPlot = plot.Name
                                    end
                                elseif typeof(owner) == "table" and owner.UserId then
                                    if owner.UserId == lp.UserId then
                                        foundPlot = plot.Name
                                    end
                                end
                            end
                        end
                    end
                end)
            end
            if foundPlot then return foundPlot end
            
            -- Fallback: check plot sign
            for _, plot in pairs(Plots:GetChildren()) do
                local sign = plot:FindFirstChild("PlotSign")
                if sign then
                    local gui = sign:FindFirstChild("SurfaceGui")
                    if gui then
                        local frame = gui:FindFirstChild("Frame")
                        if frame then
                            local lbl = frame:FindFirstChild("TextLabel")
                            if lbl then
                                local txt = lbl.Text or ""
                                if txt:find(lp.Name, 1, true) or txt:find(lp.DisplayName, 1, true) then
                                    return plot.Name
                                end
                            end
                        end
                    end
                end
            end
            
            -- Fallback: attribute
            if lp:GetAttribute("Plot") then
                return lp:GetAttribute("Plot")
            end
            
            return nil
        end
        
        local myPlotName = findMyPlot()
        print("[ESP] Starting ESP loop, found", #Plots:GetChildren(), "plots | My plot:", myPlotName or "unknown")
        
        local loopCount = 0
        while _G.brainrotESP do
            loopCount = loopCount + 1
            -- Force refresh every 20 loops (~10 seconds) to catch late-loading data
            if loopCount % 20 == 0 then
                _G._lastESPDebug = nil
                -- Refresh own plot name in case it changed
                myPlotName = findMyPlot()
            end
            
            -- Debug on first loop
            local firstLoop = loopCount == 1
            
            pcall(function()
                local best, max = nil, 0
                local allAnimals = {}
                local plotCount = 0
                
                -- Original detection: iterate all plots (skip own plot)
                for _, p in Plots:GetChildren() do
                    -- Skip our own plot
                    if p.Name == myPlotName then continue end
                    
                    if p:GetAttribute("Tier") then
                        plotCount = plotCount + 1
                        local list = ESP_Sync:Wait(p.Name):Get("AnimalList")
                        if firstLoop then
                            print("[ESP] Plot:", p.Name, "| AnimalList:", type(list) == "table" and #list or "nil/empty")
                        end
                        if type(list) == "table" then
                            for i, e in list do
                                if e ~= "Empty" and type(e) == "table" and e.Index then
                                    local g = ESP_Anims:GetGeneration(e.Index, e.Mutation, e.Traits)
                                    if g > 0 then
                                        -- Find model in Animals folder by slot index
                                        local m = nil
                                        local animalsFolder = p:FindFirstChild("Animals")
                                        if animalsFolder then
                                            m = animalsFolder:FindFirstChild(tostring(i))
                                        end
                                        if not m then
                                            m = p:FindFirstChild(e.Index)
                                        end
                                        
                                        if m then
                                            local displayName = (ESP_Data[e.Index] and ESP_Data[e.Index].DisplayName) or e.Index
                                            
                                            -- Track best (store slot to ensure correct model)
                                            if g > max then
                                                max = g
                                                best = {model = m, name = displayName, genValue = g, slot = i, plot = p}
                                            end
                                            
                                            -- Collect ALL brainrots for minimum mode (include slot+plot for unique ID)
                                            table.insert(allAnimals, {model = m, name = displayName, genValue = g, slot = i, plot = p})
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                
                if firstLoop then
                    print("[ESP] First loop done: plotCount:", plotCount, "| allAnimals:", #allAnimals)
                end
                
                -- Handle display based on mode
                if _G.BrainrotESPMode == "minimum" then
                    cleanupESP()
                    local minMS = _G.BrainrotESPMinMS or 1000000
                    
                    -- Debug: only print once when animals change (include genValue sum for better change detection)
                    local genSum = 0
                    for _, a in ipairs(allAnimals) do genSum = genSum + a.genValue end
                    local debugKey = tostring(#allAnimals) .. "_" .. (best and best.name or "nil") .. "_" .. tostring(best and best.genValue or 0) .. "_" .. tostring(genSum)
                    local shouldDebug = _G._lastESPDebug ~= debugKey
                    if shouldDebug then
                        _G._lastESPDebug = debugKey
                        print("[ESP] Mode: minimum | Best:", best and best.name or "nil", best and best.genValue or 0, "| Total found:", #allAnimals, "| MinMS:", minMS)
                        for i, a in ipairs(allAnimals) do
                            print("[ESP]  -", i, a.name, "=", a.genValue, "slot:", a.slot)
                        end
                    end
                    
                    -- Highlight ONLY the highest brainrot (always, regardless of minimum threshold)
                    if best then
                        -- Find the correct model using podium (fixes duplicate brainrot issue)
                        local bestModel = best.model
                        local bestPart = nil
                        local podiums = best.plot and best.plot:FindFirstChild("AnimalPodiums")
                        if podiums then
                            local pod = podiums:FindFirstChild(tostring(best.slot))
                            if pod then
                                -- Find the animal model inside the podium
                                for _, child in pairs(pod:GetDescendants()) do
                                    if child:IsA("Model") and child:FindFirstChildWhichIsA("BasePart") then
                                        bestModel = child
                                        break
                                    end
                                end
                                bestPart = pod:FindFirstChildWhichIsA("BasePart", true) or bestModel:FindFirstChildWhichIsA("BasePart")
                            end
                        end
                        -- Fallback
                        if not bestPart then
                            bestPart = best.model.PrimaryPart or best.model:FindFirstChildWhichIsA("BasePart")
                        end
                        
                        if bestPart then
                            local h = Instance.new("Highlight", bestModel)
                            h.FillColor = Color3.fromRGB(255, 200, 0)
                            h.OutlineColor = Color3.fromRGB(255, 215, 0)
                            h.FillTransparency = 0.5
                            
                            local b = Instance.new("BillboardGui")
                            b.Name = "BrainrotESP"
                            b.Parent = CoreGui
                            b.Adornee = bestPart
                            b.Size = UDim2.new(0, 200, 0, 50)
                            b.AlwaysOnTop = true
                            b.StudsOffset = Vector3.new(0, 3, 0)
                            
                            local n = Instance.new("TextLabel", b)
                            n.Size = UDim2.new(1, 0, 0.5, 0)
                            n.BackgroundTransparency = 1
                            n.TextColor3 = Color3.fromRGB(255, 255, 0)
                            n.TextStrokeTransparency = 0
                            n.Font = Enum.Font.GothamBold
                            n.TextSize = 18
                            n.Text = best.name
                            
                            local m = Instance.new("TextLabel", b)
                            m.Size = UDim2.new(1, 0, 0.5, 0)
                            m.Position = UDim2.new(0, 0, 0.5, 0)
                            m.BackgroundTransparency = 1
                            m.TextColor3 = Color3.fromRGB(0, 255, 0)
                            m.TextStrokeTransparency = 0
                            m.Font = Enum.Font.GothamBold
                            m.TextSize = 18
                            m.Text = "$" .. ESP_Num:ToString(best.genValue) .. "/s"
                            
                            table.insert(_G.BrainrotMultiHL, {hl = h, bb = b})
                        end
                    end
                    
                    -- Billboard text ONLY (no highlight) for other brainrots >= minimum
                    local billboardCount = 0
                    for _, animal in ipairs(allAnimals) do
                        -- Skip the highest one (compare by slot+plot, not model - fixes duplicate name issue)
                        local isBest = best and animal.slot == best.slot and animal.plot == best.plot
                        local belowMin = animal.genValue < minMS
                        
                        if shouldDebug then
                            print("[ESP] Check:", animal.name, animal.genValue, "slot:", animal.slot, "| isBest:", isBest, "| belowMin:", belowMin)
                        end
                        
                        if isBest then continue end
                        if belowMin then continue end
                        
                        billboardCount = billboardCount + 1
                        
                        -- Find the correct part using podium (in case model lookup got wrong one for duplicates)
                        local part = nil
                        local podiums = animal.plot and animal.plot:FindFirstChild("AnimalPodiums")
                        if podiums then
                            local pod = podiums:FindFirstChild(tostring(animal.slot))
                            if pod then
                                part = pod:FindFirstChildWhichIsA("BasePart", true) or pod
                            end
                        end
                        -- Fallback to model if podium not found
                        if not part then
                            part = animal.model.PrimaryPart or animal.model:FindFirstChildWhichIsA("BasePart")
                        end
                        
                        if shouldDebug then
                            print("[ESP] Billboard for:", animal.name, "slot:", animal.slot, "| Part:", part and "YES" or "NO")
                        end
                        if part then
                            local b = Instance.new("BillboardGui")
                            b.Name = "BrainrotESP"
                            b.Parent = CoreGui
                            b.Adornee = part
                            b.Size = UDim2.new(0, 200, 0, 50)
                            b.AlwaysOnTop = true
                            b.StudsOffset = Vector3.new(0, 3, 0)
                            
                            local n = Instance.new("TextLabel", b)
                            n.Size = UDim2.new(1, 0, 0.5, 0)
                            n.BackgroundTransparency = 1
                            n.TextColor3 = Color3.fromRGB(255, 255, 0)
                            n.TextStrokeTransparency = 0
                            n.Font = Enum.Font.GothamBold
                            n.TextSize = 18
                            n.Text = animal.name
                            
                            local m = Instance.new("TextLabel", b)
                            m.Size = UDim2.new(1, 0, 0.5, 0)
                            m.Position = UDim2.new(0, 0, 0.5, 0)
                            m.BackgroundTransparency = 1
                            m.TextColor3 = Color3.fromRGB(0, 255, 0)
                            m.TextStrokeTransparency = 0
                            m.Font = Enum.Font.GothamBold
                            m.TextSize = 18
                            m.Text = "$" .. ESP_Num:ToString(animal.genValue) .. "/s"
                            
                            table.insert(_G.BrainrotMultiHL, {hl = nil, bb = b})
                        end
                    end
                else
                    -- Highest mode
                    if best then
                        -- Update if: no current, different podium, different slot, different plot, or different value
                        local needsUpdate = not _G.BrainrotESPCurrent 
                            or _G.BrainrotESPCurrent.M ~= best.model
                            or _G.BrainrotESPCurrent.slot ~= best.slot
                            or _G.BrainrotESPCurrent.plot ~= best.plot
                            or _G.BrainrotESPCurrent.genValue ~= best.genValue
                        
                        if needsUpdate then
                            cleanupESP()
                            local part = best.model.PrimaryPart or best.model:FindFirstChildWhichIsA("BasePart")
                            if part then
                                local h = Instance.new("Highlight", best.model)
                                h.FillColor = Color3.fromRGB(255, 200, 0)
                                h.OutlineColor = Color3.fromRGB(255, 215, 0)
                                h.FillTransparency = 0.5
                                
                                local b = Instance.new("BillboardGui")
                                b.Name = "BrainrotESP"
                                b.Parent = CoreGui
                                b.Adornee = part
                                b.Size = UDim2.new(0, 200, 0, 50)
                                b.AlwaysOnTop = true
                                b.StudsOffset = Vector3.new(0, 3, 0)
                                
                                local n = Instance.new("TextLabel", b)
                                n.Size = UDim2.new(1, 0, 0.5, 0)
                                n.BackgroundTransparency = 1
                                n.TextColor3 = Color3.fromRGB(255, 255, 0)
                                n.TextStrokeTransparency = 0
                                n.Font = Enum.Font.GothamBold
                                n.TextSize = 18
                                n.Text = best.name
                                
                                local msLbl = Instance.new("TextLabel", b)
                                msLbl.Size = UDim2.new(1, 0, 0.5, 0)
                                msLbl.Position = UDim2.new(0, 0, 0.5, 0)
                                msLbl.BackgroundTransparency = 1
                                msLbl.TextColor3 = Color3.fromRGB(0, 255, 0)
                                msLbl.TextStrokeTransparency = 0
                                msLbl.Font = Enum.Font.GothamBold
                                msLbl.TextSize = 18
                                
                                _G.BrainrotESPCurrent = {M = best.model, H = h, B = b, L = msLbl, slot = best.slot, plot = best.plot, genValue = best.genValue}
                            end
                        end
                        -- Update $/s text
                        if _G.BrainrotESPCurrent and _G.BrainrotESPCurrent.L then
                            _G.BrainrotESPCurrent.L.Text = "$" .. ESP_Num:ToString(max) .. "/s"
                        end
                    else
                        cleanupESP()
                    end
                end
            end)
            task.wait(0.5)
        end
        
        _G.BrainrotESPLoopRunning = false
    end)
