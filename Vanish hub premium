    local isFocused = false
    local cursorVisible = true
    local cursorTask = nil
    
    -- When clicking the visible button, focus the hidden PlayerGui TextBox
    MinInput.MouseButton1Click:Connect(function()
        -- Get current value (strip placeholder if showing)
        local currentText = MinInput.Text
        if currentText == "e.g. 100M, 1B" then
            currentText = ""
        end
        hiddenInput.Text = currentText
        hiddenInput:CaptureFocus()
    end)
    
    -- Show typing cursor when focused
    hiddenInput.Focused:Connect(function()
        isFocused = true
        MinInput.TextColor3 = Color3.fromRGB(255, 255, 255)
        -- Start blinking cursor
        cursorTask = task.spawn(function()
            while isFocused do
                cursorVisible = not cursorVisible
                local displayText = hiddenInput.Text
                if cursorVisible then
                    MinInput.Text = displayText .. "|"
                else
                    MinInput.Text = displayText
                end
                task.wait(0.5)
            end
        end)
    end)
    
    -- Mirror text changes from hidden input to visible display (with cursor)
    hiddenInput:GetPropertyChangedSignal("Text"):Connect(function()
        if isFocused then
            MinInput.Text = hiddenInput.Text .. "|"
            cursorVisible = true
        else
            MinInput.Text = hiddenInput.Text
        end
    end)
    
    -- Parse input when focus is lost
    hiddenInput.FocusLost:Connect(function()
        isFocused = false
        if cursorTask then
            task.cancel(cursorTask)
            cursorTask = nil
        end
        local txt = hiddenInput.Text:upper():gsub("%s", "")
        local num = 0
        if txt:match("(%d+%.?%d*)T") then
            num = tonumber(txt:match("(%d+%.?%d*)")) * 1e12
        elseif txt:match("(%d+%.?%d*)B") then
            num = tonumber(txt:match("(%d+%.?%d*)")) * 1e9
        elseif txt:match("(%d+%.?%d*)M") then
            num = tonumber(txt:match("(%d+%.?%d*)")) * 1e6
        elseif txt:match("(%d+%.?%d*)K") then
            num = tonumber(txt:match("(%d+%.?%d*)")) * 1e3
        else
            num = tonumber(txt) or 0
        end
        if num > 0 then
            _G.BrainrotESPMinMS = num
            MinInput.TextColor3 = Color3.fromRGB(255, 255, 255)
            -- Format display
            if num >= 1e12 then
                MinInput.Text = string.format("%.1f", num/1e12):gsub("%.0$","").."T"
            elseif num >= 1e9 then
                MinInput.Text = string.format("%.1f", num/1e9):gsub("%.0$","").."B"
            elseif num >= 1e6 then
                MinInput.Text = string.format("%.1f", num/1e6):gsub("%.0$","").."M"
            elseif num >= 1e3 then
                MinInput.Text = string.format("%.1f", num/1e3):gsub("%.0$","").."K"
            else
                MinInput.Text = tostring(num)
            end
            hiddenInput.Text = MinInput.Text
        else
            -- Show placeholder if empty or invalid
            MinInput.Text = "e.g. 100M, 1B"
            MinInput.TextColor3 = Color3.fromRGB(150, 150, 150)
            hiddenInput.Text = ""
        end
    end)
    
    -- Hover effect
    MinInput.MouseEnter:Connect(function() tweenColor(MinInput, lighten(Color3.fromRGB(40,40,40), HOVER_LIGHTEN)) end)
    MinInput.MouseLeave:Connect(function() tweenColor(MinInput, Color3.fromRGB(40,40,40)) end)
end)
