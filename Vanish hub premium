    local function playerHasLaserCape()
        local hasCape = false
        pcall(function()
            if player.Backpack:FindFirstChild("Laser Cape") or 
               (player.Character and player.Character:FindFirstChild("Laser Cape")) then
                hasCape = true
            end
        end)
        return hasCape
    end
    
    local function findClosestPlayers(maxDistance)
        local rootParts = {}
        if not player.Character then return rootParts end
        
        local playerRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not playerRoot then return rootParts end
        
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= player and otherPlayer.Character then
                local humanoidRootPart = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
                if humanoidRootPart then
                    local distance = (playerRoot.Position - humanoidRootPart.Position).Magnitude
                    if distance <= maxDistance then
                        table.insert(rootParts, {
                            part = humanoidRootPart,
                            distance = distance,
                            player = otherPlayer
                        })
                    end
                end
            end
        end
        
        table.sort(rootParts, function(a, b)
            return a.distance < b.distance
        end)
        
        return rootParts
    end
    
    local function useLaserCapeOnTarget(targetRootPart)
        if not player.Character then return false end
        if not playerHasLaserCape() then return false end
        
        local humanoid = player.Character:FindFirstChild("Humanoid")
        local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not humanoidRootPart then return false end
        
        local laserCape = player.Backpack:FindFirstChild("Laser Cape") or player.Character:FindFirstChild("Laser Cape")
        if not laserCape then return false end
        
        -- Equip the laser cape if not already equipped
        if laserCape.Parent ~= player.Character then
            humanoid:EquipTool(laserCape)
            task.wait(0.1)
        end
        
        -- Fire the laser cape at the target
        if _G.LaserCapeData.useItemEvent then
            local success = pcall(function()
                _G.LaserCapeData.useItemEvent:FireServer(targetRootPart.Position, targetRootPart)
            end)
            return success
        end
        return false
    end
    
    local function fireOnClosestPlayer()
        if not playerHasLaserCape() then return end
        
        local maxDistance = 50
        local closestPlayers = findClosestPlayers(maxDistance)
        
        if #closestPlayers == 0 then return end
        
        local closestTarget = closestPlayers[1]
        useLaserCapeOnTarget(closestTarget.part)
    end
    
    local function enableLaserCape()
        if _G.LaserCapeEnabled then return end
        
        if not playerHasLaserCape() then
            warn("[Vanish Hub] Cannot enable Lazer Cape Spammer - you don't own it")
            return false
        end
        
        _G.LaserCapeEnabled = true
        
        if not _G.LaserCapeData.thread then
            _G.LaserCapeData.thread = task.spawn(function()
                while _G.LaserCapeEnabled do
                    if player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                        if playerHasLaserCape() then
                            fireOnClosestPlayer()
                        else
                            _G.LaserCapeEnabled = false
                            break
                        end
                    else
                        _G.LaserCapeEnabled = false
                        break
                    end
                    task.wait(0.5)
                end
                _G.LaserCapeData.thread = nil
            end)
        end
        
        -- Periodic check for laser cape ownership
        if not _G.LaserCapeData.checkConnection then
            _G.LaserCapeData.checkConnection = RunService.Heartbeat:Connect(function()
                if _G.LaserCapeEnabled and not playerHasLaserCape() then
                    _G.LaserCapeEnabled = false
                    if _G.LaserCapeData.checkConnection then
                        _G.LaserCapeData.checkConnection:Disconnect()
                        _G.LaserCapeData.checkConnection = nil
                    end
                end
            end)
        end
        
        return true
    end
    
    local function disableLaserCape()
        if not _G.LaserCapeEnabled then return end
        _G.LaserCapeEnabled = false
        
        if _G.LaserCapeData.thread then
            pcall(function() task.cancel(_G.LaserCapeData.thread) end)
            _G.LaserCapeData.thread = nil
        end
        
        if _G.LaserCapeData.checkConnection then
            _G.LaserCapeData.checkConnection:Disconnect()
            _G.LaserCapeData.checkConnection = nil
        end
    end
    
