-- Promote mini box to ScreenGui coords (no visual jump)
local function promoteMiniBoxToScreenGui(box)
    if box.Parent == ScreenGui then return end
    
    -- Make box invisible temporarily to prevent visual jump during promotion
    local wasVisible = box.Visible
    box.Visible = false
    
    -- Capture absolute position and size BEFORE any changes
    local absPos  = box.AbsolutePosition
    local absSize = box.AbsoluteSize
    
    -- Change parent to ScreenGui
    box.Parent = ScreenGui
    -- Set anchor point (0,0) for consistent positioning
    box.AnchorPoint = Vector2.new(0, 0)
    -- Set size
    box.Size = UDim2.fromOffset(absSize.X, absSize.Y)
    -- Set position to maintain exact same absolute position
    box.Position = UDim2.fromOffset(absPos.X, absPos.Y)
    -- Set other properties
    box.ZIndex = 35
    
    -- Use RenderStepped to restore visibility after position is set
    local conn
    conn = RunService.RenderStepped:Connect(function()
        box.Visible = wasVisible
        conn:Disconnect()
    end)
end

-- Generic draggable with slop (all boxes work the same way)
-- targetFrame is optional - if provided, that frame moves instead of the clicked frame
local function makeDraggable(frame, targetFrame)
    local moveFrame = targetFrame or frame
    
    -- Ensure Frames receive touch/mouse input (Frame/InputBegan can fail on mobile if Active=false)
    pcall(function() frame.Active = true end)
    pcall(function() moveFrame.Active = true end)

    local dragging = false
    local armed = false
    local dragStart, startPos

    local began = frame.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end

        armed = true; dragging = false
        dragStart = input.Position
        startPos = moveFrame.Position

        local endConn
        endConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                armed = false; dragging = false
                if endConn then endConn:Disconnect() end
            end
        end)
    end)

    local moved = UserInputService.InputChanged:Connect(function(input)
        if not armed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta = input.Position - dragStart

        if not dragging then
            if math.abs(delta.X) < DRAG_SLOP and math.abs(delta.Y) < DRAG_SLOP then return end
            dragging = true
            startPos = moveFrame.Position -- ensure we have current position
        end

        moveFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)

    table.insert(dragConns, began)
    table.insert(dragConns, moved)
end

