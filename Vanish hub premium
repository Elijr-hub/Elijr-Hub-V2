UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    -- Check if any textbox is focused (more reliable than our flag)
    local focusedTextBox = UserInputService:GetFocusedTextBox()
    if focusedTextBox then return end
    if _G.VanishHub_IsTyping then return end  -- Don't process keybinds while typing
    
    -- Handle keybind reassignment
    if waitingForKeybind then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            if waitingForKeybind == "boxToggle" then
                keybindBoxToggle = input.KeyCode
            elseif waitingForKeybind == "rainbow" then
                keybindRainbow = input.KeyCode
            elseif waitingForKeybind == "rejoin" then
                _G.keybindRejoin = input.KeyCode
            elseif waitingForKeybind == "teleport" then
                _G.keybindTeleport = input.KeyCode
            elseif waitingForKeybind == "speedsteal" then
                _G.keybindSpeedSteal = input.KeyCode
            elseif waitingForKeybind == "lazercape" then
                _G.keybindLazerCape = input.KeyCode
            elseif waitingForKeybind == "grapplefly" then
                _G.keybindGrappleFly = input.KeyCode
            elseif waitingForKeybind == "antiturret" then
                _G.keybindAntiTurret = input.KeyCode
            elseif waitingForKeybind == "instantcloner" then
                _G.keybindInstantCloner = input.KeyCode
            elseif waitingForKeybind == "settings" then
                _G.keybindSettings = input.KeyCode
            elseif waitingForKeybind == "speedtp" then
                _G.keybindSpeedTP = input.KeyCode
            elseif waitingForKeybind == "blockall" then
                _G.keybindBlockAll = input.KeyCode
            elseif waitingForKeybind == "pickupmode" then
                _G.keybindPickupMode = input.KeyCode
            elseif waitingForKeybind == "fpsdevour" then
                _G.keybindFPSDevour = input.KeyCode
            elseif waitingForKeybind == "friendsaccess" then
                _G.keybindFriendsAccess = input.KeyCode
            end
            waitingForKeybind = nil
            updateKeybindDisplay()
            -- Save keybinds to config
            if _G.VanishHub_SaveConfig then
                _G.VanishHub_SaveConfig()
            end
        end
        return
    end
    
    -- Handle keybind actions
    if input.KeyCode == keybindBoxToggle then
        isHorizontal = not isHorizontal
        if isHorizontal then
            arrangeBoxesHorizontal()
            placeBoxesUnderBanner()
        else
            arrangeBoxesVerticalRight()
            placeBoxesRightSide()
        end
    elseif input.KeyCode == keybindRainbow then
        if rainbowOn then disableRainbow() else enableRainbow() end
    elseif input.KeyCode == _G.keybindRejoin then
        -- Rejoin keybind
        rejoinBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 180)
        game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId)
    elseif input.KeyCode == _G.keybindTeleport then
        -- Teleport keybind - only works if Keybind Teleport is enabled
        if _G.KeybindTeleportEnabled then
            _G.doTeleportToBestBrainrot()
        end
    elseif input.KeyCode == _G.keybindSpeedSteal then
        -- Speed Steal keybind - toggle on/off
        _G.SpeedStealEnabled = not _G.SpeedStealEnabled
        
        -- Sync mini button
        if _G.SpeedStealMiniBtn then
            if _G.SpeedStealEnabled then
                _G.SpeedStealMiniBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 150)
                _G.SpeedStealMiniBtn.BackgroundTransparency = 0.3
            else
                _G.SpeedStealMiniBtn.BackgroundColor3 = BANNER_COLOR
                _G.SpeedStealMiniBtn.BackgroundTransparency = BANNER_ALPHA
                    end
                end
        
        -- Sync Tab5 toggle
        if _G.setTab5ToggleState and _G.Tab5_ToggleSpeedSteal then
            _G.setTab5ToggleState(_G.Tab5_ToggleSpeedSteal, _G.Tab5_KnobSpeedSteal, _G.SpeedStealEnabled)
        end
        
        -- Don't disconnect - just toggle flag so it works mid-steal
        if _G.SpeedStealEnabled then
        else
        end
    elseif _G.keybindLazerCape and input.KeyCode == _G.keybindLazerCape then
        -- Lazer Cape Spammer keybind - toggle on/off
        if _G.LaserCapeEnabled then
            if _G.disableLaserCape then _G.disableLaserCape() end
            _G.LaserCapeEnabled = false
            -- Sync Tab5 toggle
            if _G.setTab5ToggleState and _G.Tab5_ToggleLaserCape then
                _G.setTab5ToggleState(_G.Tab5_ToggleLaserCape, _G.Tab5_KnobLaserCape, false)
            end
        else
            if _G.enableLaserCape and _G.enableLaserCape() then
                -- Sync Tab5 toggle
                if _G.setTab5ToggleState and _G.Tab5_ToggleLaserCape then
                    _G.setTab5ToggleState(_G.Tab5_ToggleLaserCape, _G.Tab5_KnobLaserCape, true)
                end
            end
        end
    elseif _G.keybindGrappleFly and input.KeyCode == _G.keybindGrappleFly then
        -- Grapple Speed keybind - toggle on/off
        if _G.GrappleFlyEnabled then
            if _G.stopGrappleFly then _G.stopGrappleFly() end
        else
            if _G.startGrappleFly then _G.startGrappleFly() end
        end
    elseif _G.keybindAntiTurret and input.KeyCode == _G.keybindAntiTurret then
        -- Anti Turret keybind - toggle on/off
        if _G.AntiTurretEnabled then
            if _G.disableAntiTurret then _G.disableAntiTurret() end
            if _G.setAntiTurretToggleState then _G.setAntiTurretToggleState(false) end
        else
            if _G.enableAntiTurret and _G.enableAntiTurret() then
                if _G.setAntiTurretToggleState then _G.setAntiTurretToggleState(true) end
            end
        end
    elseif _G.keybindSettings and input.KeyCode == _G.keybindSettings then
        -- Settings keybind toggles settings menu
        if settingsMode then
            exitSettingsMode()
        else
            enterSettingsMode()
        end
    elseif _G.keybindInstantCloner and input.KeyCode == _G.keybindInstantCloner then
        -- Instant Cloner keybind - only works if toggle is enabled
        if not _G.InstantClonerEnabled then
            return
        end
        
        local char = player.Character
        if not char then return end
        
        -- Find Quantum Cloner
        local tool = player.Backpack:FindFirstChild("Quantum Cloner") or char:FindFirstChild("Quantum Cloner")
        if not tool then
            return
        end
        
        -- Equip if not already equipped
        if tool.Parent == player.Backpack then
            tool.Parent = char
        end
        
        -- Fire the clone swap remotes
        pcall(function()
            local Packages = game:GetService("ReplicatedStorage"):WaitForChild("Packages", 5)
            if Packages then
                local Net = Packages:WaitForChild("Net", 5)
                if Net then
                    local useItem = Net:FindFirstChild("RE/UseItem")
                    local onTeleport = Net:FindFirstChild("RE/QuantumCloner/OnTeleport")
                    if useItem then useItem:FireServer(player) end
                    if onTeleport then onTeleport:FireServer() end
                end
            end
        end)
    elseif _G.keybindSpeedTP and input.KeyCode == _G.keybindSpeedTP then
        -- Speed TP keybind
        if _G.SpeedTPFunction then
            _G.SpeedTPFunction()
        end
    elseif _G.keybindBlockAll and input.KeyCode == _G.keybindBlockAll then
        -- Block All Players keybind
        if _G.BlockAllPlayers then
            _G.BlockAllPlayers()
        end
    elseif _G.keybindFPSDevour and input.KeyCode == _G.keybindFPSDevour then
        -- FPS Devour toggle
        if _G.FPSDevourSpamming then
            if _G.StopFPSDevour then _G.StopFPSDevour() end
        else
            if _G.ExecuteFPSDevour then _G.ExecuteFPSDevour() end
        end
    elseif _G.keybindFriendsAccess and input.KeyCode == _G.keybindFriendsAccess then
        -- Friends Access toggle
        if _G.ToggleFriendsAccessFunc then
            _G.ToggleFriendsAccessFunc()
        end
    elseif _G.keybindPickupMode and input.KeyCode == _G.keybindPickupMode then
        -- Toggle between Instant Pickup Rarest and Nearest
        if _G.InstantPickupRarestEnabled then
            -- Currently Rarest, switch to Nearest
            _G.InstantPickupRarestEnabled = false
            _G.InstantPickupNearestEnabled = true
            -- Update UI toggles
            if _G.Tab5_TogglePickupRarest and _G.Tab5_KnobPickupRarest then
                TweenService:Create(_G.Tab5_TogglePickupRarest, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(40,40,40)}):Play()
                TweenService:Create(_G.Tab5_KnobPickupRarest, TweenInfo.new(0.12), {Position = UDim2.new(0, 1, 0, 1)}):Play()
            end
            if _G.Tab5_TogglePickupNearest and _G.Tab5_KnobPickupNearest then
                TweenService:Create(_G.Tab5_TogglePickupNearest, TweenInfo.new(0.12), {BackgroundColor3 = ACCENT_BLUE}):Play()
                TweenService:Create(_G.Tab5_KnobPickupNearest, TweenInfo.new(0.12), {Position = UDim2.new(1, -21, 0, 1)}):Play()
            end
        elseif _G.InstantPickupNearestEnabled then
            -- Currently Nearest, switch to Rarest
            _G.InstantPickupNearestEnabled = false
            _G.InstantPickupRarestEnabled = true
            -- Update UI toggles
            if _G.Tab5_TogglePickupNearest and _G.Tab5_KnobPickupNearest then
                TweenService:Create(_G.Tab5_TogglePickupNearest, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(40,40,40)}):Play()
                TweenService:Create(_G.Tab5_KnobPickupNearest, TweenInfo.new(0.12), {Position = UDim2.new(0, 1, 0, 1)}):Play()
            end
            if _G.Tab5_TogglePickupRarest and _G.Tab5_KnobPickupRarest then
                TweenService:Create(_G.Tab5_TogglePickupRarest, TweenInfo.new(0.12), {BackgroundColor3 = ACCENT_BLUE}):Play()
                TweenService:Create(_G.Tab5_KnobPickupRarest, TweenInfo.new(0.12), {Position = UDim2.new(1, -21, 0, 1)}):Play()
            end
        else
            -- Neither enabled, enable Rarest
            _G.InstantPickupRarestEnabled = true
            if _G.Tab5_TogglePickupRarest and _G.Tab5_KnobPickupRarest then
                TweenService:Create(_G.Tab5_TogglePickupRarest, TweenInfo.new(0.12), {BackgroundColor3 = ACCENT_BLUE}):Play()
                TweenService:Create(_G.Tab5_KnobPickupRarest, TweenInfo.new(0.12), {Position = UDim2.new(1, -21, 0, 1)}):Play()
            end
        end
        -- Save config after mode change
        if _G.VanishHub_SaveConfig then
            _G.VanishHub_SaveConfig()
        end
    end
end)

