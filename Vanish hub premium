    -- Player detection loop (slower - every 0.3s for performance)
    task.spawn(function()
        while true do
            task.wait(0.3)
            
            if AutoAdminEnabled then
                local char = player.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        -- Check for players in range
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr ~= player and plr.Character then
                                local plrRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                                if plrRoot then
                                    local distance = (root.Position - plrRoot.Position).Magnitude
                                    if distance <= AutoAdminRange then
                                        -- Player in range - hit them if not already hit recently
                                        if not HitPlayers[plr.UserId] then
                                            HitPlayers[plr.UserId] = tick()
                                            -- Execute all admin commands
                                            for _, cmd in ipairs(AdminCommands) do
                                                pcall(function()
                                                    local ReplicatedStorage = game:GetService('ReplicatedStorage')
                                                    local Net = require(ReplicatedStorage.Packages.Net)
                                                    local ExecuteCommand = Net:RemoteEvent('AdminPanelService/ExecuteCommand')
                                                    ExecuteCommand:FireServer(plr, cmd)
                                                end)
                                            end
                                        end
                                    else
                                        -- Player left range - reset their hit status after 5 seconds
                                        if HitPlayers[plr.UserId] and tick() - HitPlayers[plr.UserId] > 5 then
                                            HitPlayers[plr.UserId] = nil
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    
