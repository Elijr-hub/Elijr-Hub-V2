                allTools[#allTools + 1] = tool
                tool.Parent = char
            end
        end
        
        -- Activate Quantum Cloner
        if quantumCloner then
            pcall(function() quantumCloner:Activate() end)
        end
        
        -- Return tools after short delay
        task.delay(0.3, function()
            for i = 1, #allTools do
                local tool = allTools[i]
                if tool and tool.Parent == char then
                    tool.Parent = backpack
                end
            end
        end)
        
        -- Start slap spam
