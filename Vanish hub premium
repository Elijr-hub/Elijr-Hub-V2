        Panel.AnchorPoint = Vector2.new(0.5, 0.5)
        Panel.Position = UDim2.new(0.5, 0, 0.5, 0)
        Panel.Size = UDim2.new(0, panelWidth, 0, 0)
    else
        Panel.AnchorPoint = Vector2.new(0, 1)
        Panel.Position = UDim2.new(1, scaled(-360), 1, scaled(-480))
        Panel.Size = UDim2.new(0, panelWidth, 0, 0)
    end
    Panel.Visible = true
    
