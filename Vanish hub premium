    if st.shakePresets then return end
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local candidates = {"Shared", "Modules", "Client", "SharedModules"}
    for _, name in ipairs(candidates) do
        local folder = ReplicatedStorage:FindFirstChild(name)
        if folder and folder:FindFirstChild("ShakePresets") then
            st.shakePresets = _G.AntiDisco_SafeRequire(folder.ShakePresets)
            if st.shakePresets then return end
        end
