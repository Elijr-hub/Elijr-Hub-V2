    _G.ExecuteFPSDevour = function()
        if _G.FPSDevourSpamming then return end
        
        local status = _G.FPSStatus
        if status then status.Text = "" end
        
        local char = player.Character
        if not char then
            if status then status.Text = "No char"; status.TextColor3 = Color3.fromRGB(255, 100, 100) end
            return
        end
        
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            if status then status.Text = "No char"; status.TextColor3 = Color3.fromRGB(255, 100, 100) end
            return
        end
        
        local backpack = player.Backpack
        
        -- Find Quantum Cloner
        local quantumCloner = backpack:FindFirstChild("Quantum Cloner") or char:FindFirstChild("Quantum Cloner")
        if quantumCloner then
            humanoid:EquipTool(quantumCloner)
