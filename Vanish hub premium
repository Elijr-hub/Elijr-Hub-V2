_G.AntiDisco_PatchShake = _G.AntiDisco_PatchShake or function()
    local st = _G.AntiDisco_State
    _G.AntiDisco_FindShakeModule()
    _G.AntiDisco_FindShakePresets()

    local shakeModule = st.shakeModule
    local shakePresets = st.shakePresets

    if shakeModule and type(shakeModule) == "table" then
        if not st.origShakeNew and shakeModule.new then
            st.origShakeNew = shakeModule.new
            shakeModule.new = function(...)
                local t = st.origShakeNew(...)
                if type(t) == "table" then
                    t.Amplitude = 0
                    t.Frequency = 0
                    t.FadeInTime = 0
                    t.FadeOutTime = 0
                    t.SustainTime = 0
                end
                return t
            end
        end
        if not st.origShakeNextRenderName and shakeModule.nextRenderName then
            st.origShakeNextRenderName = shakeModule.nextRenderName
            shakeModule.nextRenderName = function() return "NOOP" end
        end
    end

    if shakePresets and type(shakePresets) == "table" then
        if not st.origBindShakeToCamera and shakePresets.BindShakeToCamera then
            st.origBindShakeToCamera = shakePresets.BindShakeToCamera
            shakePresets.BindShakeToCamera = function() return function() end end
        end
    end
end

_G.AntiDisco_RestoreShake = _G.AntiDisco_RestoreShake or function()
    local st = _G.AntiDisco_State
    if st.shakeModule and st.origShakeNew then
        st.shakeModule.new = st.origShakeNew
        st.origShakeNew = nil
    end
    if st.shakeModule and st.origShakeNextRenderName then
        st.shakeModule.nextRenderName = st.origShakeNextRenderName
        st.origShakeNextRenderName = nil
    end
    if st.shakePresets and st.origBindShakeToCamera then
        st.shakePresets.BindShakeToCamera = st.origBindShakeToCamera
