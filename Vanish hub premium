local beamToBaseConnection = nil
local beamToBaseStartAttach = nil
local beamToBaseEndAttach = nil

local function cleanupBeamToBase()
    if beamToBaseBeam then beamToBaseBeam:Destroy(); beamToBaseBeam = nil end
    if beamToBaseStartAttach then beamToBaseStartAttach:Destroy(); beamToBaseStartAttach = nil end
    if beamToBaseEndAttach then beamToBaseEndAttach:Destroy(); beamToBaseEndAttach = nil end
    if beamToBaseConnection then beamToBaseConnection:Disconnect(); beamToBaseConnection = nil end
end

local function setupBeamToBase()
    if not beamToBase then return end
    
    cleanupBeamToBase()
    
    local char = player.Character
    if not char then return end
    local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return end

    local targetPlot = nil
    
    -- Search by player name
    for _, potentialPlot in ipairs(plotsFolder:GetChildren()) do
        if potentialPlot and (potentialPlot:IsA("Model") or potentialPlot:IsA("Folder")) then
            local plotSign = potentialPlot:FindFirstChild("PlotSign")
            if plotSign then
                local surfaceGui = plotSign:FindFirstChild("SurfaceGui")
                if surfaceGui then
                    local frame = surfaceGui:FindFirstChild("Frame")
                    if frame then
                        local textLabel = frame:FindFirstChild("TextLabel")
                        if textLabel then
                            local ownerText = textLabel.Text
                            if ownerText:find(player.Name) and ownerText:find("Base") then
                                targetPlot = potentialPlot
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    -- Search by display name if not found
    if not targetPlot then
        local playerDisplayName = player.DisplayName
        for _, potentialPlot in ipairs(plotsFolder:GetChildren()) do
            if potentialPlot and (potentialPlot:IsA("Model") or potentialPlot:IsA("Folder")) then
                local plotSign = potentialPlot:FindFirstChild("PlotSign")
                if plotSign then
                    local surfaceGui = plotSign:FindFirstChild("SurfaceGui")
                    if surfaceGui then
                        local frame = surfaceGui:FindFirstChild("Frame")
                        if frame then
                            local textLabel = frame:FindFirstChild("TextLabel")
                            if textLabel and textLabel.Text:find(playerDisplayName) and textLabel.Text:find("Base") then
                                targetPlot = potentialPlot
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    if not targetPlot then 
        return 
    end

    local targetAnimalTarget = targetPlot:FindFirstChild("AnimalTarget")
    if not targetAnimalTarget then 
        return 
    end

    beamToBaseStartAttach = Instance.new("Attachment")
    beamToBaseStartAttach.Parent = humanoidRootPart
    beamToBaseStartAttach.Name = "BeamToBaseStart"

    beamToBaseEndAttach = Instance.new("Attachment")
    beamToBaseEndAttach.Parent = targetAnimalTarget
    beamToBaseEndAttach.Name = "BeamToBaseEnd"

    beamToBaseBeam = Instance.new("Beam")
    beamToBaseBeam.Name = "VanishHub_BeamToBase"
    beamToBaseBeam.Parent = workspace.Terrain
    beamToBaseBeam.Attachment0 = beamToBaseStartAttach
    beamToBaseBeam.Attachment1 = beamToBaseEndAttach
    beamToBaseBeam.Color = ColorSequence.new(Color3.fromRGB(0, 200, 255))
    beamToBaseBeam.Transparency = NumberSequence.new(0.1)
    beamToBaseBeam.Width0 = 0.3
    beamToBaseBeam.Width1 = 0.3
    beamToBaseBeam.FaceCamera = true
    beamToBaseBeam.LightEmission = 1
    beamToBaseBeam.LightInfluence = 0
    beamToBaseBeam.Brightness = 3

    beamToBaseConnection = player.CharacterAdded:Connect(function(newCharacter)
        if _G.BeamToBaseFromConfig then return end
        cleanupBeamToBase()
        task.wait(1)
        if beamToBase then
            setupBeamToBase()
        end
    end)
    
end

local function enableBeamToBase()
    if beamToBase then return end
    beamToBase = true
    setupBeamToBase()
end

local function disableBeamToBase()
    if not beamToBase then return end
    beamToBase = false
    cleanupBeamToBase()
end

