task.defer(function()
    -- Block on Steal implementation (UI toggle is created in PVP section)
    local StarterGui = game:GetService('StarterGui')
    local VirtualInputManager = game:GetService('VirtualInputManager')
    local lp = Players.LocalPlayer

    local function getRoot()
        local char = lp.Character or lp.CharacterAdded:Wait()
        return char:WaitForChild('HumanoidRootPart')
    end

    local function isInsideHitbox(rootPos, part)
        local size = part.Size * 0.5
        local pos = part.Position
        return math.abs(rootPos.X - pos.X) <= size.X
            and math.abs(rootPos.Y - pos.Y) <= size.Y + 3
            and math.abs(rootPos.Z - pos.Z) <= size.Z
    end
    
    -- Declare plotCache early so findNearestPlotOwner can use it
    local plotCache = {}
    local blockedPlayers = {}
    local activeSpam = {}
    
    -- More reliable: find nearest plot owner by distance
    local function findNearestPlotOwner(rootPos)
        local nearestOwner = nil
        local nearestDist = math.huge
        
        for plot, owner in pairs(plotCache) do
            if owner and owner ~= lp then
                -- Find the center of the plot
                local plotCenter = nil
                local plotPart = plot:FindFirstChild("Base") or plot:FindFirstChildWhichIsA("BasePart")
                if plotPart then
                    plotCenter = plotPart.Position
                else
                    -- Fallback: find any basepart in plot
                    for _, desc in ipairs(plot:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            plotCenter = desc.Position
                            break
                        end
                    end
                end
                
                if plotCenter then
                    local dist = (Vector3.new(rootPos.X, 0, rootPos.Z) - Vector3.new(plotCenter.X, 0, plotCenter.Z)).Magnitude
                    -- Only consider plots within reasonable stealing distance (150 studs)
                    if dist < nearestDist and dist < 150 then
                        nearestDist = dist
                        nearestOwner = owner
                    end
                end
            end
        end
        
        return nearestOwner, nearestDist
    end

    local function findPromptOverlay()
        for _, gui in ipairs(game:GetService('CoreGui'):GetChildren()) do
            local overlay = gui:FindFirstChild('promptOverlay', true)
            if overlay then
                return overlay
            end
        end
        return nil
    end

    local function getPlayerFromPlot(plot)
        local attempts = 0
        local playerName
        repeat
            for _, desc in ipairs(plot:GetDescendants()) do
                if desc:IsA('SurfaceGui') then
                    for _, guiObj in ipairs(desc:GetDescendants()) do
                        if (guiObj:IsA('TextLabel') or guiObj:IsA('TextButton')) and guiObj.Text then
                            local text = guiObj.Text
                            if text:match(".+'s Base") then
                                playerName = text:gsub("'s Base", ''):gsub('%s+$', '')
                                break
                            end
                        end
                    end
                end
                if playerName then break end
            end
            if not playerName then
                task.wait(0.05)
                attempts = attempts + 1
            end
        until playerName or attempts >= 40
        if playerName then
            local foundPlayer = Players:FindFirstChild(playerName)
            if not foundPlayer then
                -- Try case-insensitive search by Name AND DisplayName
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Name:lower() == playerName:lower() or p.DisplayName:lower() == playerName:lower() then
                        foundPlayer = p
                        break
                    end
                end
            end
            return foundPlayer
        end
        return nil
    end

    local SPAM_DURATION = 0.25
    local SPAM_INTERVAL = 0.02
    local OVERLAY_TIMEOUT = 0.4
    local DETECT_INTERVAL = 0.01

    local function spamPrompt(target)
        if not target then return end
        local uid = target.UserId
        if activeSpam[uid] then return end  -- Only skip if actively spamming, allow re-blocking
        if blockedPlayers[uid] then return end  -- Already blocked this player
        activeSpam[uid] = true

        -- Try to open block prompt
        local success = pcall(function()
            StarterGui:SetCore('PromptBlockPlayer', target)
        end)
        
        if not success then
            activeSpam[uid] = nil
            return
        end

        local overlay
        local expireAt = tick() + OVERLAY_TIMEOUT
        repeat
            overlay = findPromptOverlay()
            if overlay then break end
            task.wait()
        until tick() > expireAt

        if not overlay then
            activeSpam[uid] = nil
            return
        end

        -- Try to find and click the block button directly
        task.spawn(function()
            task.wait(0.1)
            
            -- Look for block button in the overlay
            local function findBlockButton(parent)
                for _, child in ipairs(parent:GetDescendants()) do
                    if child:IsA("TextButton") or child:IsA("ImageButton") then
                        local text = child:FindFirstChildOfClass("TextLabel")
                        if text and text.Text:lower():find("block") then
                            return child
                        end
                        if child:IsA("TextButton") and child.Text:lower():find("block") then
                            return child
                        end
                    end
                end
                return nil
            end
            
            local blockBtn = findBlockButton(overlay)
            if blockBtn then
                -- Try clicking the button directly
                pcall(function()
                    if typeof(firesignal) == "function" then
                        firesignal(blockBtn.Activated)
                    elseif typeof(fireclick) == "function" then
                        fireclick(blockBtn)
                    end
                end)
            end
        end)

        local startTime = tick()
        local blockConfirmed = false
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not _G.AutoStealBlock_Enabled then
                conn:Disconnect()
                activeSpam[uid] = nil
                return
            end
            if not target or not target.Parent then
                conn:Disconnect()
                activeSpam[uid] = nil
                return
            end
            if tick() - startTime >= SPAM_DURATION then
                conn:Disconnect()
                activeSpam[uid] = nil
                -- Only mark as blocked if we got confirmation (overlay closed during spam)
                if blockConfirmed then
                    blockedPlayers[uid] = true
                end
                pcall(function()
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Up, false, game)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                end)
                return
            end
            local curOverlay = findPromptOverlay()
            if not curOverlay or not curOverlay.Parent then
                -- Overlay closed = block likely succeeded
                conn:Disconnect()
                activeSpam[uid] = nil
                blockedPlayers[uid] = true
                blockConfirmed = true
                pcall(function()
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Up, false, game)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                end)
                return
            end
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Up, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Up, false, game)
            end)
            task.wait()
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
            end)
            task.wait()
        end)
    end

    -- Plot cache population (ALWAYS runs to keep track of plot owners)
    spawn(function()
        while true do
            local Plots = workspace:FindFirstChild("Plots")
            if Plots then
                for _, plot in ipairs(Plots:GetChildren()) do
                    if not plotCache[plot] or not plotCache[plot].Parent then
                        local p = getPlayerFromPlot(plot)
                        plotCache[plot] = p
                    end
                end
            end
            task.wait(0.5)
        end
    end)

    -- Function to find whose steal zone we're currently in
    local function findPlotOwnerAtPosition()
        local char = lp.Character
        if not char then return nil end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        
        local Plots = workspace:FindFirstChild("Plots")
        if not Plots then return nil end
        
        for _, plot in ipairs(Plots:GetChildren()) do
            local owner = plotCache[plot]
            if owner and owner ~= lp then
                for _, part in ipairs(plot:GetDescendants()) do
                    if part:IsA('BasePart') and part.Name:lower():find('steal') then
                        if isInsideHitbox(root.Position, part) then
                            return owner
                        end
                    end
                end
            end
        end
        return nil
    end
    
    -- Only look for ProximityPrompts inside player Plots (for manual E press)
    spawn(function()
        while true do
            if _G.AutoStealBlock_Enabled then
                local Plots = workspace:FindFirstChild("Plots")
                if Plots then
                    for _, plot in ipairs(Plots:GetChildren()) do
                        -- Only check plots that belong to other players
                        local plotOwner = plotCache[plot]
                        if plotOwner and plotOwner ~= lp then
                            -- Find ProximityPrompts on this plot
                            for _, obj in ipairs(plot:GetDescendants()) do
                                if obj:IsA('ProximityPrompt') and not obj:GetAttribute('PlotStealHook2') then
                                    obj:SetAttribute('PlotStealHook2', true)
                                    
                                    -- Hook this prompt
                                    obj.Triggered:Connect(function(playerWhoTriggered)
                                        if not _G.AutoStealBlock_Enabled then return end
                                        if playerWhoTriggered ~= lp then return end
                                        
                                        spamPrompt(plotOwner)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)

    -- Expose function to reset tracking when enabled
    _G.BlockOnSteal_Reset = function()
        blockedPlayers = {}
        activeSpam = {}
    end
    
    -- Check if should enable from config
    task.spawn(function()
        task.wait(1.5)
        if _G.BlockOnStealFromConfig then
            _G.AutoStealBlock_Enabled = true
            if _G.setBlockOnStealState then
                _G.setBlockOnStealState(true)
            end
            blockedPlayers = {}
            activeSpam = {}
            _G.BlockOnStealFromConfig = false
        end
    end)
    
    -- Expose functions for Instant Pickup integration
    _G.BlockOnSteal_BlockPlayer = function(targetPlayer)
        if not targetPlayer or targetPlayer == lp then return end
        spamPrompt(targetPlayer)
    end
    
    _G.BlockOnSteal_GetPlotOwner = function(plotName)
        local Plots = workspace:FindFirstChild("Plots")
        if not Plots then return nil end
        local plot = Plots:FindFirstChild(plotName)
        if not plot then return nil end
        local owner = plotCache[plot]
        if owner and owner ~= lp then
            return owner
        end
        return nil
    end
    
    -- Helper to check if we're inside our own plot
    local function isInOwnPlot(rootPos)
        local Plots = workspace:FindFirstChild("Plots")
        if not Plots then return false end
        
        for _, plot in ipairs(Plots:GetChildren()) do
            local owner = plotCache[plot]
            if owner == lp then
                -- Check if we're inside our own plot's boundaries
                for _, part in ipairs(plot:GetDescendants()) do
                    if part:IsA('BasePart') then
                        -- Check plot base or any reasonably sized part
                        if part.Size.X > 10 and part.Size.Z > 10 then
                            local size = part.Size * 0.5
                            local pos = part.Position
                            if math.abs(rootPos.X - pos.X) <= size.X + 10
                                and math.abs(rootPos.Z - pos.Z) <= size.Z + 10 then
                                return true
                            end
                        end
                    end
                end
            end
        end
        return false
    end
    
    -- Block on Steal: Monitor StealingIndex attribute
    -- When player picks up a brainrot, StealingIndex = brainrot name
    -- We need to find whose plot we're standing on
    lp.AttributeChanged:Connect(function(attr)
        if attr == "StealingIndex" and _G.AutoStealBlock_Enabled then
            local brainrotName = lp:GetAttribute("StealingIndex")
            if brainrotName and brainrotName ~= "" then
                -- Find whose steal zone we're currently in
                local char = lp.Character
                if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                
                -- IMPORTANT: Don't block if we're in our own plot
                if isInOwnPlot(root.Position) then
                    return
                end
                
                local targetPlayer = nil
                
                -- Only use hitbox detection (must be in their steal zone)
                for plot, owner in pairs(plotCache) do
                    if owner and owner ~= lp then
                        for _, part in ipairs(plot:GetDescendants()) do
                            if part:IsA('BasePart') and part.Name:lower():find('steal') then
                                if isInsideHitbox(root.Position, part) then
                                    targetPlayer = owner
                                    break
                                end
                            end
                        end
                        if targetPlayer then break end
                    end
                end
                
                -- Block only if we're definitely in someone else's steal zone
                if targetPlayer then
                    spamPrompt(targetPlayer)
                end
            end
        end
    end)
end)

