        lockStatusLabel.Parent = lockStatusBillboard
        
        -- Update function
        local function updateLockStatus()
            if not lockStatusLabel or not lockStatusLabel.Parent then return end
            
            -- Try to get lock status from Synchronizer
            local isUnlocked = false
            pcall(function()
                local RS = game:GetService("ReplicatedStorage")
                local Sync = require(RS.Packages.Synchronizer)
                local channel = Sync:Get(myPlot.Name)
                if channel then
                    -- Try various possible property names
                    local friendsAllowed = channel:Get("FriendsAllowed")
                    if friendsAllowed == nil then
                        friendsAllowed = channel:Get("AllowFriends")
                    end
                    if friendsAllowed == nil then
                        friendsAllowed = channel:Get("FriendsEnabled")
                    end
                    if friendsAllowed == true then
                        isUnlocked = true
                    end
                end
            end)
            
            -- Fallback to our local state if Synchronizer didn't work
            if not isUnlocked then
                isUnlocked = _G.FriendsAccessEnabled or false
            end
            
            if isUnlocked then
                lockStatusLabel.Text = "UNLOCKED"
                lockStatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                lockStatusLabel.Text = "LOCKED"
                lockStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
        end
        
        -- Update immediately and connect to loop (throttled)
        updateLockStatus()
        
        if lockStatusConnection then
            lockStatusConnection:Disconnect()
        end
        
