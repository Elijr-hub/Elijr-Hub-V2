            quantumCloneIndicator = createQuantumCloneIndicator()
        end
        
        quantumTrackerConnection = RunService.RenderStepped:Connect(function()
                    local char = player.Character
            if not char then
                quantumCloneIndicator.Adornee = nil
                return
            end
            
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then
                quantumCloneIndicator.Adornee = nil
                return
            end
            
            if quantumCloneIndicator.Adornee ~= root then
                quantumCloneIndicator.Adornee = root
            end
            
            pcall(function()
                if quantumCloneIndicator.Parent ~= game:GetService("CoreGui") then
                    quantumCloneIndicator.Parent = game:GetService("CoreGui")
                end
            end)
        end)
    end
    
    local function stopQuantumTracking()
        if quantumTrackerConnection then
            quantumTrackerConnection:Disconnect()
            quantumTrackerConnection = nil
        end
        if quantumCloneIndicator then
            quantumCloneIndicator.Adornee = nil
            quantumCloneIndicator.Parent = nil
        end
    end
    
    local function performQuantumSwap()
        local char = player.Character
        if not char then return false end
        
        -- Put all tools in backpack
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                tool.Parent = player.Backpack
                    end
                end
        
        startQuantumTracking()
        
        -- Equip Quantum Cloner
        local tool = player.Backpack:FindFirstChild("Quantum Cloner")
        if not tool then
            return false
        end
        
        tool.Parent = char
        
        -- Fire remotes
        pcall(function()
            local Packages = game:GetService("ReplicatedStorage"):WaitForChild("Packages", 5)
            if Packages then
                local Net = Packages:WaitForChild("Net", 5)
                if Net then
                    local useItem = Net:FindFirstChild("RE/UseItem")
                    local onTeleport = Net:FindFirstChild("RE/QuantumCloner/OnTeleport")
                    if useItem then useItem:FireServer(player) end
                    if onTeleport then onTeleport:FireServer() end
                end
            end
        end)
        
        QuantumDesyncV3()
        return true
    end
    
    local function enableQuantumDesync()
        if _G.QuantumDesyncEnabled then return end
        _G.QuantumDesyncEnabled = true
        
        if not performQuantumSwap() then
            _G.QuantumDesyncEnabled = false
            return false
        end
        
        -- Listen for steal prompts to re-apply desync
        local ProximityPromptService = game:GetService("ProximityPromptService")
        quantumProximityConnection = ProximityPromptService.PromptTriggered:Connect(function(prompt, plr)
            if plr == player and prompt.ActionText == "Steal" then
                QuantumDesyncV3()
        end
        end)
        
        return true
    end
    
    local function disableQuantumDesync()
        if not _G.QuantumDesyncEnabled then return end
        _G.QuantumDesyncEnabled = false
        
        if quantumProximityConnection then
            quantumProximityConnection:Disconnect()
            quantumProximityConnection = nil
        end
        
