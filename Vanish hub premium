    _G.createLockStatusESP = function()
        -- Find my plot
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return end
        
        local myPlot = nil
        for _, plot in pairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            if sign then
                local gui = sign:FindFirstChild("SurfaceGui")
                if gui then
                    local frame = gui:FindFirstChild("Frame")
                    if frame then
                        local lbl = frame:FindFirstChild("TextLabel")
                        if lbl and lbl.Text then
                            if lbl.Text:find(player.Name, 1, true) or lbl.Text:find(player.DisplayName, 1, true) then
                                myPlot = plot
                                break
                            end
                        end
                    end
                end
            end
        end
        
        if not myPlot then return end
        
        -- Find the friends toggle pole/button in the plot
        local friendsPole = nil
        
        -- Search for the friends toggle part (could be named various things)
        local searchNames = {"FriendsButton", "FriendsPole", "FriendsToggle", "LockButton", "LockPole", "AllowFriends", "Friends"}
        for _, name in pairs(searchNames) do
            friendsPole = myPlot:FindFirstChild(name, true)
            if friendsPole then break end
        end
        
        -- If not found by name, look for parts with "friend" in the name
        if not friendsPole then
            for _, desc in pairs(myPlot:GetDescendants()) do
                if desc:IsA("BasePart") and desc.Name:lower():find("friend") then
                    friendsPole = desc
                    break
                end
            end
        end
        
        -- If still not found, look for a ProximityPrompt related to friends
        if not friendsPole then
            for _, desc in pairs(myPlot:GetDescendants()) do
                if desc:IsA("ProximityPrompt") and (desc.ActionText:lower():find("friend") or desc.ObjectText:lower():find("friend")) then
                    friendsPole = desc.Parent
                    break
                end
            end
        end
        
        -- Fallback to DeliveryHitbox if we can't find the pole
        if not friendsPole then
            friendsPole = myPlot:FindFirstChild("DeliveryHitbox")
        end
        
        if not friendsPole then return end
        
        -- Create billboard
        if lockStatusBillboard then
            lockStatusBillboard:Destroy()
        end
        
        lockStatusBillboard = Instance.new("BillboardGui")
        lockStatusBillboard.Name = "VanishHub_LockStatusESP"
        lockStatusBillboard.Size = UDim2.new(0, 200, 0, 50)
