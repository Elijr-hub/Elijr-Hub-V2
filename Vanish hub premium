    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = "Speed TP"
    label.TextSize = IS_MOBILE and scaled(12) or 14
    label.TextColor3 = Color3.fromRGB(0, 170, 255)
    label.ZIndex = 31
    label.Parent = speedTPBtn
    
    -- Make draggable on mobile
    pcall(function() makeDraggable(speedTPBtn) end)

    -- Global Speed TP function (can be called from button or keybind)
    _G.SpeedTPFunction = function()
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return end
        
        -- Find my plot
        local myPlotName = nil
        pcall(function()
            for _, plot in pairs(plots:GetChildren()) do
                local sign = plot:FindFirstChild("PlotSign")
                if sign then
                    local gui = sign:FindFirstChild("SurfaceGui")
                    if gui then
                        local frame = gui:FindFirstChild("Frame")
                        if frame then
                            local lbl = frame:FindFirstChild("TextLabel")
                            if lbl and lbl.Text then
                                if lbl.Text:find(player.Name, 1, true) or lbl.Text:find(player.DisplayName, 1, true) then
                                    myPlotName = plot.Name
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end)
        
        -- Find nearest plot that isn't mine AND has brainrots
        local nearestPlot = nil
        local nearestDist = math.huge
        local highestSlot = nil
        
        for _, plot in pairs(plots:GetChildren()) do
            if plot.Name ~= myPlotName then
                -- Find the best brainrot in this plot by parsing M/S values from TextLabels
                local bestSlot = nil
                local bestValue = 0
                
                local podiums = plot:FindFirstChild("AnimalPodiums")
                if podiums then
                    for _, pod in pairs(podiums:GetChildren()) do
                        -- Check if in fuse machine (skip)
                        local inFuse = false
                        for _, child in pairs(pod:GetDescendants()) do
                            if child:IsA("TextLabel") or child:IsA("TextButton") then
                                local textUpper = (child.Text or ""):upper()
                                if textUpper:find("FUSE") or textUpper:find("FUSING") or textUpper:find("MACHINE") then
                                    inFuse = true
                                    break
                                end
                            end
                        end
                        
                        if not inFuse then
                            -- Parse M/S value from TextLabels
                            for _, d in pairs(pod:GetDescendants()) do
                                if d:IsA("TextLabel") then
                                    local txt = d.Text or ""
                                    if txt:find("/") then
                                        local t = txt:gsub(",",""):gsub("%s",""):gsub("%$","")
                                        local n, s = t:match("([%d%.]+)([kKmMbBtT]?)%/s")
                                        if n then
                                            local v = tonumber(n) or 0
                                            s = (s or ""):lower()
                                            if s == "k" then v = v * 1e3
                                            elseif s == "m" then v = v * 1e6
                                            elseif s == "b" then v = v * 1e9
                                            elseif s == "t" then v = v * 1e12 end
                                            
                                            if v > bestValue then
                                                bestValue = v
                                                bestSlot = pod.Name
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                
                -- Consider plots with brainrots
                if bestSlot and bestValue > 0 then
                    local delivery = plot:FindFirstChild("DeliveryHitbox")
                    if delivery then
                        local dist = (delivery.Position - hrp.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestPlot = plot
                            highestSlot = bestSlot
                        end
                    end
                end
            end
        end
        
        -- Teleport if close enough (150 studs)
        if nearestPlot and nearestDist < 150 then
            if speedTPBtn then
                speedTPBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            end
            
            -- Find target position (delivery hitbox area, offset towards player/their plot)
            local delivery = nearestPlot:FindFirstChild("DeliveryHitbox")
            if delivery then
                -- Offset towards player's position (closer to their plot)
                local dirToPlayer = (hrp.Position - delivery.Position).Unit
                -- Use delivery hitbox Y position directly (it's at ground level)
                local targetPos = delivery.Position + Vector3.new(dirToPlayer.X * 12, 0, dirToPlayer.Z * 12)
                
                -- Find carpet for safe teleport
                local carpet = player.Backpack:FindFirstChild("Flying Carpet") or char:FindFirstChild("Flying Carpet")
                
                -- Equip carpet first if available
                if carpet then 
                    hum:EquipTool(carpet) 
                end
                
                -- Anti-rubber band teleport function
                local function safeTP(root, targetCF)
                    -- Zero all velocities
                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.Velocity = Vector3.zero
                    end)
                    
                    -- Apply teleport
                    root.CFrame = targetCF
                    
                    -- Zero velocities again immediately
                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.Velocity = Vector3.zero
                    end)
                end
                
                -- Disable physics states
                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end)
                
                -- FIRST TELEPORT: To plot area (apply multiple times to prevent rubber band)
                local targetCF = CFrame.new(targetPos)
                for i = 1, 5 do
                    safeTP(hrp, targetCF)
                    if i < 5 then task.wait() end
                end
                
                -- SECOND TELEPORT: To the best brainrot slot (after brief delay)
                task.delay(0.1, function()
                    local char2 = player.Character
                    local hrp2 = char2 and char2:FindFirstChild("HumanoidRootPart")
                    local hum2 = char2 and char2:FindFirstChildOfClass("Humanoid")
                    if not hrp2 or not hum2 then return end
                    
                    local podiums = nearestPlot:FindFirstChild("AnimalPodiums")
                    if not podiums then return end
                    
                    local targetPos2 = nil
                    
                    -- Find the specific podium with the best brainrot
                    local targetPod = podiums:FindFirstChild(tostring(highestSlot))
                    if targetPod then
                        -- Find the brainrot model position in this podium
                        for _, child in pairs(targetPod:GetDescendants()) do
                            if child:IsA("Model") then
                                local part = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                                if part then
                                    targetPos2 = part.Position
                                    break
                                end
                            end
                        end
                    end
                    
                    if targetPos2 then
                        local targetCF2 = CFrame.new(targetPos2 + Vector3.new(0, 3, 0))
                        -- Apply multiple times
                        for i = 1, 5 do
                            safeTP(hrp2, targetCF2)
                            if i < 5 then task.wait() end
                        end
                    end
                end)
                
                -- Re-enable states after teleport is complete
                task.delay(0.6, function()
                    pcall(function()
                        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
                        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
                    end)
                end)
            end
            
            if speedTPBtn then
                task.delay(0.2, function()
                    speedTPBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                end)
            end
        else
            if speedTPBtn then
                speedTPBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                task.delay(0.3, function()
                    speedTPBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                end)
            end
        end
    end
    
    speedTPBtn.MouseButton1Click:Connect(function()
        _G.SpeedTPFunction()
    end)
    speedTPBtn.Activated:Connect(function()
        _G.SpeedTPFunction()
    end)
end)

