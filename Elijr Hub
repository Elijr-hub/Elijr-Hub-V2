local Tabs = {}
local function NewTab(name)
    local f = Instance.new("ScrollingFrame", Content)
    f.Size, f.BackgroundTransparency, f.Visible, f.ScrollBarThickness = UDim2.new(1,0,1,0), 1, false, 0
    Tabs[name] = f
    return f
end

local MTab, VTab, MiTab = NewTab("Move"), NewTab("View"), NewTab("Misc")
local function Show(name) for n, t in pairs(Tabs) do t.Visible = (n == name) end end

local function Nav(name, y)
    local b = Instance.new("TextButton", LeftNav)
    b.Size, b.Position = UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, y)
    b.Text, b.Font, b.BackgroundColor3, b.TextColor3 = name:upper(), Enum.Font.FredokaOne, Color3.fromRGB(30,30,30), Color3.new(1,1,0)
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(function() Show(name) end)
end

