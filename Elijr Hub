-- [FUNCTIONS]
local function ApplyXray(state)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
            if state then
                if not obj:FindFirstChild("OriginalTrans") then
                    local v = Instance.new("NumberValue", obj)
                    v.Name = "OriginalTrans"
                    v.Value = obj.Transparency
                    obj.Transparency = 0.6
                end
            else
                local v = obj:FindFirstChild("OriginalTrans")
                if v then obj.Transparency = v.Value v:Destroy() end
            end
        end
    end
end

-- [LOOP SYSTEM]
RunService.RenderStepped:Connect(function()
    local Char = LocalPlayer.Character
    local HRP = Char and Char:FindFirstChild("HumanoidRootPart")
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    
    if HRP and Hum then
        -- MOBILE DIRECTION FIX: Translates joystick to Camera view
        if Enabled and not FlyEnabled and Hum.MoveDirection.Magnitude > 0 then
            -- Bypass barriers
            for _, part in pairs(Char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end

            -- CALCULATE CAMERA RELATIVE DIRECTION
            local cameraCFrame = Camera.CFrame
            local moveDirection = Hum.MoveDirection
            
            -- This aligns the movement exactly with where your camera is pointing
            local lookVector = Vector3.new(cameraCFrame.LookVector.X, 0, cameraCFrame.LookVector.Z).Unit
            local rightVector = Vector3.new(cameraCFrame.RightVector.X, 0, cameraCFrame.RightVector.Z).Unit
            
            -- Map joystick X/Z to Camera Vectors
            -- This prevents the "sideways when going forward" issue
            local targetVelocity = (lookVector * (moveDirection.Z / math.abs(moveDirection.Z or 1)) * -1) + (rightVector * (moveDirection.X / math.abs(moveDirection.X or 1)))
            
            -- Apply Velocity
            HRP.Velocity = Vector3.new(Hum.MoveDirection.X * Speed, HRP.Velocity.Y, Hum.MoveDirection.Z * Speed)
            
            -- Force character to face movement
            HRP.CFrame = CFrame.new(HRP.Position, HRP.Position + Hum.MoveDirection)
        end

        if AntiKB and Hum.MoveDirection.Magnitude <= 0 then
            HRP.Velocity = Vector3.new(0, HRP.Velocity.Y, 0)
        end

        if AntiRagdoll and (Hum:GetState() == Enum.HumanoidStateType.Ragdoll or Hum:GetState() == Enum.HumanoidStateType.FallingDown) then
            Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        
        Hum.JumpPower = JumpPower
    end

    if HRP and AutoSteal then
        CirclePart.CFrame = CFrame.new(HRP.Position)
        Selection.Adornee = CirclePart
        CirclePart.Size = Vector3.new(StealDist * 2, StealDist * 2, StealDist * 2)
        Selection.Transparency = 0.6
    else
        Selection.Transparency = 1
    end
    Camera.FieldOfView = FOVValue
end)

-- Auto Steal (2 Seconds)
task.spawn(function()
    while task.wait(0.1) do
        local HRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if HRP and AutoSteal and not ProgressBack.Visible then
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("TouchTransmitter") and v.Parent and (HRP.Position - v.Parent.Position).Magnitude <= StealDist then
                    ProgressBack.Visible = true
                    ProgressFill.Size = UDim2.new(0,0,1,0)
                    ProgressFill:TweenSize(UDim2.new(1,0,1,0), "Out", "Linear", 2)
                    task.wait(2)
                    if AutoSteal and v.Parent then 
                        firetouchinterest(HRP, v.Parent, 0) 
                        firetouchinterest(HRP, v.Parent, 1) 
                    end
                    ProgressBack.Visible = false
                    break
                end
            end
        end
    end
end)

