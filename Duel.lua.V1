-- Auto Duel & Base System - 3 Separate Toggles
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- System States (Separate Controls)
local CombatActive = false
local EnemyBaseActive = false
local AutoBaseActive = false
local DEFAULT_WALK_SPEED = 16
local ENEMY_BASE_SPEED = 50
local AUTO_BASE_SPEED = 30 -- Built-in 30 speed boost

-- Settings
local PLOT_PREFIX = "Plot_"
local TARGET_PLOTS = {1, 10}
local BRAINROT_NAME = "Brainrot"
local WEAPON_NAME = "Bat"
local ENEMY_OFFSET = 1.5 -- Close behind enemies
local COLLECTION_ZONE_NAME = "CollectionZone" -- Adjust if game uses different name

-- Remotes
local REMOTE_EQUIP = ReplicatedStorage:WaitForChild("EquipTool", 10)
local REMOTE_ACTION = ReplicatedStorage:WaitForChild("StealBrainrot", 10)

-- UI Container
local ScreenGui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
ScreenGui.Name = "AutoDuelSystem"

-- BUTTON 1: Active (Bat Combat + Behind-Enemy Flight)
local CombatToggle = Instance.new("TextButton", ScreenGui)
CombatToggle.Size = UDim2.new(0, 200, 0, 50)
CombatToggle.Position = UDim2.new(0.5, -100, 0.3, 0)
CombatToggle.Text = "<b>ACTIVE: OFF</b>"
CombatToggle.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
CombatToggle.TextColor3 = Color3.new(1,1,1)
CombatToggle.Font = Enum.Font.FredokaOne
CombatToggle.RichText = true
CombatToggle.TextScaled = true
Instance.new("UICorner", CombatToggle).CornerRadius = UDim.new(0, 15)

-- BUTTON 2: Enemy Base (Plot Hunt + 50 Speed Boost)
local EnemyBaseToggle = Instance.new("TextButton", ScreenGui)
EnemyBaseToggle.Size = UDim2.new(0, 200, 0, 50)
EnemyBaseToggle.Position = UDim2.new(0.5, -100, 0.45, 0)
EnemyBaseToggle.Text = "<b>ENEMY BASE: OFF</b>"
EnemyBaseToggle.BackgroundColor3 = Color3.fromRGB(0, 0, 200)
EnemyBaseToggle.TextColor3 = Color3.new(1,1,1)
EnemyBaseToggle.Font = Enum.Font.FredokaOne
EnemyBaseToggle.RichText = true
EnemyBaseToggle.TextScaled = true
Instance.new("UICorner", EnemyBaseToggle).CornerRadius = UDim.new(0, 15)

-- BUTTON 3: Auto Base (Collection Zone + 30 Speed Boost)
local AutoBaseToggle = Instance.new("TextButton", ScreenGui)
AutoBaseToggle.Size = UDim2.new(0, 200, 0, 50)
AutoBaseToggle.Position = UDim2.new(0.5, -100, 0.6, 0)
AutoBaseToggle.Text = "<b>AUTO BASE: OFF</b>"
AutoBaseToggle.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
AutoBaseToggle.TextColor3 = Color3.new(1,1,1)
AutoBaseToggle.Font = Enum.Font.FredokaOne
AutoBaseToggle.RichText = true
AutoBaseToggle.TextScaled = true
Instance.new("UICorner", AutoBaseToggle).CornerRadius = UDim.new(0, 15)

-- Find Closest Enemy Player (for Combat)
local function findClosestEnemy()
    local closest, closestDist = nil, math.huge
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character and Player.Character.Humanoid.Health > 0 then
            local enemyHRP = Player.Character:FindFirstChild("HumanoidRootPart")
            if enemyHRP then
                local dist = (HRP.Position - enemyHRP.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = enemyHRP
                end
            end
        end
    end
    return closest
end

-- Find Brainrot in Plots (for Enemy Base)
local function findBrainrot()
    for _, plotNum in pairs(TARGET_PLOTS) do
        local plot = Workspace:FindFirstChild(PLOT_PREFIX .. plotNum)
        if plot then
            local brainrot = plot:FindFirstChild(BRAINROT_NAME) or plot:FindFirstChildWhichIsA("Model"):FindFirstChild(BRAINROT_NAME)
            if brainrot then
                return brainrot.Position
            end
        end
    end
    return nil
end

-- Find Collection Zone (for Auto Base)
local function findCollectionZone()
    -- Checks Workspace for collection zone - adjust path if needed
    local collectionZone = Workspace:FindFirstChild(COLLECTION_ZONE_NAME) or Workspace:FindFirstChildWhichIsA("Part", true)
    if collectionZone and collectionZone.Name == COLLECTION_ZONE_NAME then
        return collectionZone.Position
    end
    -- Fallback to known plot positions if zone not found
    return Vector3.new(0, 5, 0) -- Replace with actual zone coords if known
end

-- Combat Logic (Active Button)
local function runCombat()
    local weapon = LocalPlayer.Backpack:FindFirstChild(WEAPON_NAME) or Character:FindFirstChild(WEAPON_NAME)
    if weapon then REMOTE_EQUIP:FireServer(weapon) end

    while CombatActive do
        local closestEnemy = findClosestEnemy()
        if closestEnemy then
            local behindPos = closestEnemy.Position - (closestEnemy.CFrame.LookVector * ENEMY_OFFSET)
            HRP.Velocity = (behindPos - HRP.Position).Unit * 30
            HRP.CFrame = CFrame.new(HRP.Position, closestEnemy.Position)
            REMOTE_ACTION:FireServer()
            wait(0.15)
        else
            HRP.Velocity = Vector3.new(0, 0, 0)
        end
        RunService.Heartbeat:Wait()
    end
end

-- Enemy Base Logic (Enemy Base Button)
local function runEnemyBaseHunt()
    Humanoid.WalkSpeed = ENEMY_BASE_SPEED

    while EnemyBaseActive do
        local brainrotPos = findBrainrot()
        if brainrotPos then
            HRP.CFrame = CFrame.new(HRP.Position, brainrotPos)
            HRP.Velocity = (brainrotPos - HRP.Position).Unit * 60
            if (HRP.Position - brainrotPos).Magnitude < 5 then
                REMOTE_ACTION:FireServer()
                wait(1)
            end
        else
            HRP.Velocity = Vector3.new(0, 0, 0)
        end
        RunService.Heartbeat:Wait()
    end
    Humanoid.WalkSpeed = DEFAULT_WALK_SPEED
end

-- Auto Base Logic (Auto Base Button - Straight to Collection Zone)
local function runAutoBase()
    Humanoid.WalkSpeed = AUTO_BASE_SPEED

    while AutoBaseActive do
        local zonePos = findCollectionZone()
        if zonePos then
            -- Go STRAIGHT to the collection zone
            HRP.Velocity = (zonePos - HRP.Position).Unit * AUTO_BASE_SPEED
            HRP.CFrame = CFrame.new(HRP.Position, zonePos)
            
            -- Steal/Collect when in zone
            if (HRP.Position - zonePos).Magnitude < 5 then
                REMOTE_ACTION:FireServer()
                wait(0.5)
            end
        else
            HRP.Velocity = Vector3.new(0, 0, 0)
        end
        RunService.Heartbeat:Wait()
    end
    Humanoid.WalkSpeed = DEFAULT_WALK_SPEED
end

-- Combat Toggle Handler
CombatToggle.MouseButton1Click:Connect(function()
    CombatActive = not CombatActive
    if CombatActive then
        CombatToggle.Text = "<b>ACTIVE: ON</b>"
        CombatToggle.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        spawn(runCombat)
    else
        CombatToggle.Text = "<b>ACTIVE: OFF</b>"
        CombatToggle.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        if not EnemyBaseActive and not AutoBaseActive then HRP.Velocity = Vector3.new(0, 0, 0) end
    end
end)

-- Enemy Base Toggle Handler
EnemyBaseToggle.MouseButton1Click:Connect(function()
    EnemyBaseActive = not EnemyBaseActive
    if EnemyBaseActive then
        EnemyBaseToggle.Text = "<b>ENEMY BASE: ON</b>"
        EnemyBaseToggle.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        spawn(runEnemyBaseHunt)
    else
        EnemyBaseToggle.Text = "<b>ENEMY BASE: OFF</b>"
        EnemyBaseToggle.BackgroundColor3 = Color3.fromRGB(0, 0, 200)
        Humanoid.WalkSpeed = DEFAULT_WALK_SPEED
        if not CombatActive and not AutoBaseActive then HRP.Velocity = Vector3.new(0, 0, 0) end
    end
end)

-- Auto Base Toggle Handler
AutoBaseToggle.MouseButton1Click:Connect(function()
    AutoBaseActive = not AutoBaseActive
    if AutoBaseActive then
        AutoBaseToggle.Text = "<b>AUTO BASE: ON</b>"
        AutoBaseToggle.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        spawn(runAutoBase)
    else
        AutoBaseToggle.Text = "<b>AUTO BASE: OFF</b>"
        AutoBaseToggle.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
        Humanoid.WalkSpeed = DEFAULT_WALK_SPEED
        if not CombatActive and not EnemyBaseActive then HRP.Velocity = Vector3.new(0, 0, 0) end
    end
end)

-- Respawn Handling
LocalPlayer.CharacterAdded:Connect(function(NewChar)
    Character = NewChar
    HRP = Character:WaitForChild("HumanoidRootPart")
    Humanoid = Character:WaitForChild("Humanoid")
    
    if CombatActive then spawn(runCombat) end
    if EnemyBaseActive then
        Humanoid.WalkSpeed = ENEMY_BASE_SPEED
        spawn(runEnemyBaseHunt)
    end
    if AutoBaseActive then
        Humanoid.WalkSpeed = AUTO_BASE_SPEED
        spawn(runAutoBase)
    end
end)

print("System Ready - Toggle Buttons To Use Features!")
