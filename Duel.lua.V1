-- Full Fixed Version - Auto System for Steal a Brainrot
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- Core Settings
local SystemActive = false
local AutoWalkEnabled = false
local WalkSpeed = 53
local BRAINROT_NAME = "Brainrot"
local PLOT_PREFIX = "Plot_"
local TargetPlots = {1, 10}

-- Fix Variables
local REMOTE_STEAL = ReplicatedStorage:FindFirstChild("StealBrainrot") or ReplicatedStorage:WaitForChild("StealBrainrot", 10)
local REMOTE_EQUIP = ReplicatedStorage:FindFirstChild("EquipTool") or ReplicatedStorage:WaitForChild("EquipTool", 10)
local BAT_NAME = "Bat"

-- Fix 1: Check Plot for Brainrot
local function PlotHasBrainrot(PlotNumber)
    local Plot = Workspace:FindFirstChild(PLOT_PREFIX .. PlotNumber)
    if not Plot then return false, nil end
    local Brainrot = Plot:FindFirstChild(BRAINROT_NAME) or Plot:FindFirstChildWhichIsA("Model"):FindFirstChild(BRAINROT_NAME)
    if Brainrot then return true, Brainrot.Position end
    return false, nil
end

-- Fix 2: Find Valid Target Plot
local function FindTargetPlot()
    for _, PlotNum in pairs(TargetPlots) do
        local HasBrainrot, Pos = PlotHasBrainrot(PlotNum)
        if HasBrainrot then return PlotNum, Pos end
    end
    return nil, nil
end

-- Fix 3: Auto Walk Function
local function AutoWalk()
    while SystemActive and AutoWalkEnabled do
        local TargetPlot, TargetPos = FindTargetPlot()
        if TargetPos then
            Humanoid.WalkSpeed = WalkSpeed
            Humanoid:MoveTo(TargetPos)
            Humanoid.MoveToFinished:Wait()
            local HasBrainrot = PlotHasBrainrot(TargetPlot)
            if HasBrainrot and REMOTE_STEAL then
                REMOTE_STEAL:FireServer()
                wait(1)
            end
        end
        wait(0.5)
    end
end

-- Fix 4: Active Combat System
local function ActiveSystem()
    local Bat = LocalPlayer.Backpack:FindFirstChild(BAT_NAME) or Character:FindFirstChild(BAT_NAME)
    if Bat and REMOTE_EQUIP then REMOTE_EQUIP:FireServer(Bat) end
    
    while SystemActive do
        for _, Player in pairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer and Player.Character and Player.Character.Humanoid.Health > 0 then
                local EnemyHRP = Player.Character:FindFirstChild("HumanoidRootPart")
                if EnemyHRP then
                    HRP.CFrame = HRP.CFrame:Lerp(CFrame.new(HRP.Position, EnemyHRP.Position), 0.2)
                    if (HRP.Position - EnemyHRP.Position).Magnitude < 8 and REMOTE_STEAL then
                        REMOTE_STEAL:FireServer()
                    end
                end
            end
        end
        wait(0.1)
    end
end

-- Fix 5: UI Controls
local ScreenGui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
ScreenGui.Name = "FixedAutoSystem"

local ActiveToggle = Instance.new("TextButton", ScreenGui)
ActiveToggle.Size = UDim2.new(0, 150, 0, 40)
ActiveToggle.Position = UDim2.new(0.5, -75, 0.1, 20)
ActiveToggle.Text = "<b>ACTIVE</b>"
ActiveToggle.BackgroundColor3 = Color3.fromRGB(147,112,219)
ActiveToggle.TextColor3 = Color3.new(1,1,1)
ActiveToggle.Font = Enum.Font.FredokaOne
ActiveToggle.RichText = true
Instance.new("UICorner", ActiveToggle).CornerRadius = UDim.new(0,8)

local AutoWalkToggle = Instance.new("TextButton", ScreenGui)
AutoWalkToggle.Size = UDim2.new(0, 150, 0, 40)
AutoWalkToggle.Position = UDim2.new(0.5, -75, 0.1, 70)
AutoWalkToggle.Text = "<b>AUTO WALK: OFF</b>"
AutoWalkToggle.BackgroundColor3 = Color3.fromRGB(20,20,20)
AutoWalkToggle.TextColor3 = Color3.fromRGB(173,216,230)
AutoWalkToggle.Font = Enum.Font.FredokaOne
AutoWalkToggle.RichText = true
Instance.new("UICorner", AutoWalkToggle).CornerRadius = UDim.new(0,8)

-- Toggle Logic
ActiveToggle.MouseButton1Click:Connect(function()
    SystemActive = not SystemActive
    ActiveToggle.Text = SystemActive and "<b>ACTIVE</b>" or "<b>DISABLED</b>"
    ActiveToggle.BackgroundColor3 = SystemActive and Color3.fromRGB(147,112,219) or Color3.fromRGB(20,20,20)
    if SystemActive then
        ActiveSystem()
        if AutoWalkEnabled then AutoWalk() end
    end
end)

AutoWalkToggle.MouseButton1Click:Connect(function()
    AutoWalkEnabled = not AutoWalkEnabled
    AutoWalkToggle.Text = "<b>AUTO WALK: " .. (AutoWalkEnabled and "ON" or "OFF") .. "</b>"
    AutoWalkToggle.BackgroundColor3 = AutoWalkEnabled and Color3.fromRGB(147,112,219) or Color3.fromRGB(20,20,20)
    AutoWalkToggle.TextColor3 = AutoWalkEnabled and Color3.new(1,1,1) or Color3.fromRGB(173,216,230)
    if AutoWalkEnabled and SystemActive then AutoWalk() end
end)

-- Character Respawn Fix
LocalPlayer.CharacterAdded:Connect(function(NewChar)
    Character = NewChar
    HRP = Character:WaitForChild("HumanoidRootPart")
    Humanoid = Character:WaitForChild("Humanoid")
    if SystemActive then
        Humanoid.WalkSpeed = WalkSpeed
        ActiveSystem()
    end
end)

print("Fixed System Loaded - All Functions Working!")
