-- Unified Auto System for Steal a Brainrot (Active Combat + Auto Walk + Return to Base)
-- Toggles: ACTIVE (Bat/aimbot) | AUTO WALK (Plot Raid 53) | RETURN TO BASE (Speed 30)
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HRP = Character:WaitForChild("HumanoidRootPart")
local Humanoid = Character:WaitForChild("Humanoid")

-- Core Settings
local SystemToggles = {
    Active = false,
    AutoWalk = false,
    ReturnToBase = false
}
local Speeds = {
    Combat = 53,
    AutoWalk = 53,
    Return = 30
}
local TargetPlots = {1, 10}
local BRAINROT_NAME = "Brainrot"
local PLOT_PREFIX = "Plot_"
local REMOTE_STEAL = ReplicatedStorage:FindFirstChild("StealBrainrot") or ReplicatedStorage:WaitForChild("StealBrainrot", 5)
local REMOTE_ATTACK = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:WaitForChild("Attack", 5)
local REMOTE_EQUIP = ReplicatedStorage:FindFirstChild("EquipTool") or ReplicatedStorage:WaitForChild("EquipTool", 5)

-- ────────────────────────────────────────────────────────────────
--                         CORE LOGIC
-- ────────────────────────────────────────────────────────────────

-- Check for brainrot in plot
local function PlotHasBrainrot(PlotNum)
    local Plot = Workspace:FindFirstChild(PLOT_PREFIX..PlotNum)
    if not Plot then return false, nil end
    local Brainrot = Plot:FindFirstChild(BRAINROT_NAME) or Plot:FindFirstChildWhichIsA("Model"):FindFirstChild(BRAINROT_NAME)
    return Brainrot and Brainrot:FindFirstChild("TouchInterest") ~= nil, Brainrot and Brainrot.Position or nil
end

-- Find target plot with brainrot
local function FindTargetPlot()
    for _, PlotNum in pairs(TargetPlots) do
        local HasBrainrot, Pos = PlotHasBrainrot(PlotNum)
        if HasBrainrot then return PlotNum, Pos end
    end
    return nil, nil
end

-- Combat System (Built-in Bat/Aimbot)
local function CombatLoop()
    while SystemToggles.Active do
        for _, Player in pairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer and Player.Character and Player.Character.Humanoid.Health > 0 then
                local EnemyHRP = Player.Character:FindFirstChild("HumanoidRootPart")
                if EnemyHRP then
                    HRP.CFrame = HRP.CFrame:Lerp(CFrame.new(HRP.Position, EnemyHRP.Position), 0.2)
                    REMOTE_ATTACK:FireServer()
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end

-- Auto Walk to Brainrot
local function AutoWalkLoop()
    while SystemToggles.AutoWalk do
        local PlotNum, Pos = FindTargetPlot()
        if Pos then
            Humanoid.WalkSpeed = Speeds.AutoWalk
            Humanoid:MoveTo(Pos)
            Humanoid.MoveToFinished:Wait()
            if PlotHasBrainrot(PlotNum) then REMOTE_STEAL:FireServer(PlotNum) end
        end
        RunService.Heartbeat:Wait()
    end
    Humanoid.WalkSpeed = 16
end

-- Return to Steal Zone at Speed 30
local function ReturnToBaseLoop()
    local StealZone = Workspace:FindFirstChild("StealZone") or Workspace:WaitForChild("StealZone", 5)
    if not StealZone then print("Steal Zone not found!") return end
    
    while SystemToggles.ReturnToBase do
        Humanoid.WalkSpeed = Speeds.Return
        Humanoid:MoveTo(StealZone.Position)
        RunService.Heartbeat:Wait()
    end
    Humanoid.WalkSpeed = 16
end

-- ────────────────────────────────────────────────────────────────
--                         UI CONTROLS
-- ────────────────────────────────────────────────────────────────
local ScreenGui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
ScreenGui.Name = "AutoSystem"

-- Draggable Toggle Buttons (3 Total)
local function CreateToggle(LabelText, PosY)
    local Btn = Instance.new("TextButton", ScreenGui)
    Btn.Size = UDim2.new(0, 120, 0, 40)
    Btn.Position = UDim2.new(0, 20, 0, PosY)
    Btn.BackgroundColor3 = Color3.new(0.1,0.1,0.1)
    Btn.Text = "<b>"..LabelText..": OFF</b>"
    Btn.TextColor3 = Color3.fromRGB(173,216,230)
    Btn.Font = Enum.Font.FredokaOne
    Btn.RichText = true
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0,8)
    
    Btn.MouseButton1Click:Connect(function()
        local ToggleName = LabelText:upper()
        SystemToggles[ToggleName] = not SystemToggles[ToggleName]
        Btn.Text = "<b>"..LabelText..": "..(SystemToggles[ToggleName] and "ON" or "OFF").."</b>"
        Btn.BackgroundColor3 = SystemToggles[ToggleName] and Color3.fromRGB(147,112,219) or Color3.new(0.1,0.1,0.1)
        
        if ToggleName == "ACTIVE" then
            if SystemToggles.ACTIVE then CombatLoop() end
        elseif ToggleName == "AUTO WALK" then
            if SystemToggles.AUTO_WALK then AutoWalkLoop() end
        elseif ToggleName == "RETURN TO BASE" then
            SystemToggles.ReturnToBase = SystemToggles.AUTO_WALK_RETURN
            if SystemToggles.ReturnToBase then ReturnToBaseLoop() end
        end
    end)
    return Btn
end

-- Create 3 Toggles Only
CreateToggle("ACTIVE", 40)
CreateToggle("AUTO WALK", 90)
CreateToggle("RETURN TO BASE", 140)

-- Respawn Handler
LocalPlayer.CharacterAdded:Connect(function(NewChar)
    Character = NewChar
    Humanoid = Character:WaitForChild("Humanoid")
    HRP = Character:WaitForChild("HumanoidRootPart")
    if SystemToggles.Active then CombatLoop() end
    if SystemToggles.AutoWalk then AutoWalkLoop() end
end)

print("Auto System Loaded - 3 Toggles Only!")
